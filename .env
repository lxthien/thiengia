# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ChangeMe!
APP_TIMEZONE=Asia/Ho_Chi_Minh
###< symfony/framework-bundle ###

LOG_URL="%kernel.logs_dir%/%kernel.environment%.log"
SYMFONY_SECRET="ChangeMeSecret"

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/db_name?serverVersion=mariadb-10.4.11&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/db_name?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> excelwebzone/recaptcha-bundle ###
EWZ_RECAPTCHA_SITE_KEY=
EWZ_RECAPTCHA_SECRET=
###< excelwebzone/recaptcha-bundle ###

###> symfony/mailer ###
# For a generic SMTP server, use: "smtp://user:pass@smtp.example.com:port"
# Delivery is disabled by default via "null://null"
# Gmail: tao "App password" (can bat xac minh 2 buoc) roi dat trong .env.local:
#   MAILER_DSN=smtp://TEN%40gmail.com:MATKHAUUNGDUNG@smtp.gmail.com:587
# (@ trong ten dang nhap viet la %40; mat khau ung dung 16 ky tu, bo khoang trang)
MAILER_DSN=null://null
###< symfony/mailer ###

# HTTP Cache Invalidation Version
CACHE_VERSION=v2


###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> google search console (app:gsc:sync) ###
# Property trong Search Console: "sc-domain:example.com" hoac "https://www.example.com/".
# De trong = tat dong bo. File khoa Service Account khong duoc commit.
GSC_SITE_URL=
GSC_CREDENTIALS_PATH=%kernel.project_dir%/config/secrets/gsc-service-account.json
###< google search console ###

###> ckfinder ###
# Dien gia tri that trong .env.local, khong ghi vao file nay.
CKFINDER_LICENSE_NAME=
CKFINDER_LICENSE_KEY=
###< ckfinder ###

###> indexnow ###
# Khoa IndexNow (8-128 ky tu a-f, 0-9). De trong = tat. Tao khoa:
#   php -r "echo bin2hex(random_bytes(16));"
# Dat gia tri that trong .env.local cua production.
INDEXNOW_KEY=
###< indexnow ###

###> router default uri ###
# Ten mien dung khi tao URL ngoai request web (lenh console, cron).
# Production: dat DEFAULT_URI=https://xaydungthiengia.com trong .env.local.
DEFAULT_URI=http://localhost
###< router default uri ###
