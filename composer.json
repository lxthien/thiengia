{
    "name": "symfony/symfony-demo",
    "license": "MIT",
    "type": "project",
    "description": "Symfony Demo Application",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" },
        "files": [ "vendor/symfony/symfony/src/Symfony/Component/VarDumper/Resources/functions/dump.php" ]
    },
    "require": {
        "php": "^8.1",
        "ext-pdo_sqlite": "*",
        "babdev/pagerfanta-bundle": "^4.6",
        "blackknight467/star-rating-bundle": "^2.0",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-fixtures-bundle": "^3.7",
        "doctrine/annotations": "^2.0",
        "doctrine/orm": "^2.20",
        "erusev/parsedown": "^1.5",
        "excelwebzone/recaptcha-bundle": "^1.5",
        "ezyang/htmlpurifier": "^4.7",
        "knplabs/knp-menu-bundle": "^3.6",
        "knplabs/knp-paginator-bundle": "^5.9",
        "liip/imagine-bundle": "^2.16",
        "mhujer/breadcrumbs-bundle": "^1.5",
        "monolog/monolog": "^2.0",
        "stof/doctrine-extensions-bundle": "^1.13",
        "symfony/dotenv": "5.4.*",
        "symfony/flex": "^1.0",
        "symfony/mailer": "5.4.*",
        "symfony/monolog-bundle": "^3.1",
        "symfony/polyfill-apcu": "^1.0",
        "symfony/symfony": "5.4.*",
        "twig/twig": "^3.0",
        "vich/uploader-bundle": "^1.23"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "5.4.*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "config": {
        "platform": {
            "php": "8.1.25"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "5.4.*"
        }
    }
}
