{
    "name": "symfony/symfony-demo",
    "license": "MIT",
    "type": "project",
    "description": "Symfony Demo Application",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" },
        "files": [ "vendor/symfony/var-dumper/Resources/functions/dump.php" ]
    },
    "require": {
        "php": "^8.1",
        "ext-pdo_sqlite": "*",
        "babdev/pagerfanta-bundle": "^4.6",
        "blackknight467/star-rating-bundle": "^2.0",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-fixtures-bundle": "^3.7",
        "doctrine/annotations": "^2.0",
        "doctrine/orm": "^2.20",
        "erusev/parsedown": "^1.5",
        "excelwebzone/recaptcha-bundle": "^1.5",
        "ezyang/htmlpurifier": "^4.7",
        "knplabs/knp-menu-bundle": "^3.7",
        "knplabs/knp-paginator-bundle": "^6.8",
        "liip/imagine-bundle": "^2.16",
        "mhujer/breadcrumbs-bundle": "^1.5",
        "stof/doctrine-extensions-bundle": "^1.14",
        "symfony/asset": "6.4.*",
        "symfony/console": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/error-handler": "6.4.*",
        "symfony/event-dispatcher": "6.4.*",
        "symfony/flex": "^2.4",
        "symfony/form": "6.4.*",
        "symfony/framework-bundle": "6.4.*",
        "symfony/intl": "6.4.*",
        "symfony/mailer": "6.4.*",
        "symfony/mime": "6.4.*",
        "symfony/monolog-bundle": "^3.1",
        "symfony/password-hasher": "6.4.*",
        "symfony/polyfill-apcu": "^1.0",
        "symfony/property-access": "6.4.*",
        "symfony/routing": "6.4.*",
        "symfony/security-bundle": "6.4.*",
        "symfony/stopwatch": "6.4.*",
        "symfony/translation": "6.4.*",
        "symfony/twig-bundle": "6.4.*",
        "symfony/validator": "6.4.*",
        "symfony/yaml": "6.4.*",
        "twig/twig": "^3.0",
        "vich/uploader-bundle": "^1.23"
    },
    "require-dev": {
        "symfony/debug-bundle": "6.4.*",
        "symfony/phpunit-bridge": "6.4.*",
        "symfony/var-dumper": "6.4.*",
        "symfony/web-profiler-bundle": "6.4.*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "config": {
        "platform": {
            "php": "8.1.25"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "6.4.*",
            "docker": false
        }
    }
}
