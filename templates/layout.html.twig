{#
    Layout front — theme v3 (Thiện Gia).
    Asset nạp qua asset('build/...') vì dự án dùng framework.assets.json_manifest_path
    (không cài WebpackEncoreBundle nên không có hàm encore_entry_*).
#}
<!DOCTYPE html>
<html lang="vi-VN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}{{ get_setting('pageTitle') ?: v3.company.shortName ~ ' — ' ~ v3.company.slogan }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ get_setting('pageDescription') ?: v3.company.description }}{% endblock %}">
    <meta name="keywords" content="{% block keyword %}{{ get_setting('pageKeyword') }}{% endblock %}">

    {% block robots %}<meta name="robots" content="index, follow">{% endblock %}
    <meta name="theme-color" content="{{ v3.colors.primary }}">
    <meta http-equiv="content-language" content="vi">

    {% block canonical %}
        {% if app.request.attributes.get('_route') is not null %}
            <link rel="canonical" href="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}">
        {% endif %}
    {% endblock %}

    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap" rel="stylesheet">

    {# Open Graph #}
    <meta property="og:locale" content="vi_VN">
    <meta property="og:site_name" content="{{ v3.company.shortName }}">
    {% block structuredOpenGraph %}
        <meta property="og:type" content="website">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('description') }}">
    {% endblock %}
    {% if app.request.attributes.get('_route') is not null %}
        <meta property="og:url" content="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}">
    {% endif %}

    {% block blogPosting %}{% endblock %}
    {% block localBusiness %}{% endblock %}
    {% block structuredReview %}{% endblock %}

    {# CSS chung của theme v3 #}
    <link rel="stylesheet" href="{{ asset('build/css/v3-app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>

<body class="v3 {% block bodyClass %}{% endblock %}">
    <a class="skip-link" href="#noi-dung">Bỏ qua đến nội dung chính</a>

    {{ include('v3/layout/_topbar.html.twig') }}
    {{ include('v3/layout/_header.html.twig') }}
    {{ include('v3/layout/_mobile_menu.html.twig') }}

    <main id="noi-dung">
        {% block body %}{% endblock %}
    </main>

    {{ include('v3/layout/_footer.html.twig') }}
    {{ include('v3/layout/_float_contact.html.twig') }}

    <script src="{{ asset('build/js/v3.js') }}"></script>
    {% block javascripts %}{% endblock %}

    {{ get_setting('facebookMessenger')|raw }}
</body>
</html>
