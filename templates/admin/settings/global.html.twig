{% extends 'admin/layout.html.twig' %}
{% block title %}Cài đặt chung{% endblock %}
{% block body_id 'admin_settings_global' %}
{% block flash_messages %}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/settings-global.css') }}">{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('build/js/settings-global.js') }}" defer></script>{% endblock %}
{% block main %}
{% set groups = {
'general':{title:'Thông tin website', description:'Tên website và thông tin liên hệ hiển thị chung.', fields:['siteName','emailContact','hotLine1','hotLine2','displayNameCommentAs']},
'homepage':{title:'Trang chủ & hiển thị', description:'Giữ nguyên định dạng dữ liệu đang sử dụng khi chỉnh danh mục và bảng giá.', fields:['listPrices','listCategoryOnHomepage','numberRecordOnPage','marqueeHomepage']},
'seo':{title:'SEO', description:'Thông tin tiêu đề, mô tả và từ khóa mặc định.', fields:['pageTitle','pageDescription','pageKeyword','topKeyword']},
'tracking':{title:'Analytics & tích hợp', description:'Chỉ sử dụng mã từ nguồn tin cậy. Tránh cấu hình trùng một dịch vụ ở nhiều trường.', fields:['GTM','ga4MeasurementID','googleAnalytic','fbApp','facebookMessenger']},
'variables':{title:'Biến nội dung', description:'Các giá trị thay thế cho placeholder trong nội dung. Đây là cấu hình riêng với thông tin liên hệ phía trên.', fields:['contens_ten_cong_ty','contens_ten_day_du','contens_dia_chi','contens_hotline_1','contens_hotline_2','contens_hotline_3','contens_email','contens_mst']},
'social':{title:'Mạng xã hội', description:'Đường dẫn đến các kênh của doanh nghiệp. Các trường cũ được giữ để không mất dữ liệu.', fields:['linkToFacebook','linkToGooglePlus','linkToTwitter','linkToYoutube','linkToLinkedin','linkToInstagram']},
'schema':{title:'Dữ liệu có cấu trúc', description:'Cấu hình JSON-LD dùng chung. Dán nguyên thẻ script type="application/ld+json" theo định dạng hiện tại.', fields:['schemaOrganization','schemaLocalBusiness']}
} %}
<section class="banner-manager settings-manager">
<header class="banner-manager__header"><div><h1>Cài đặt chung</h1><p>Quản lý cấu hình website tại một nơi. Thay đổi chỉ được áp dụng sau khi lưu.</p></div></header>
{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type in ['success','warning','danger','info'] ? type : 'info' }}" role="alert">{{ message|trans }}</div>{% endfor %}{% endfor %}
{{ form_start(form, {attr:{id:'global-settings-form'}}) }}
{% if not form.vars.valid %}<div class="alert alert-danger" role="alert" tabindex="-1" id="settings-errors">Chưa lưu được cấu hình. Vui lòng kiểm tra các trường báo lỗi bên dưới.</div>{% endif %}
{{ form_errors(form) }}
<div class="settings-layout">
<nav class="settings-nav banner-panel" aria-label="Nhóm cài đặt">{% for id,group in groups %}<a href="#settings-{{ id }}">{{ group.title }}</a>{% endfor %}</nav>
<div class="settings-sections">
{% for id,group in groups %}
<section class="banner-panel settings-section" id="settings-{{ id }}" aria-labelledby="settings-title-{{ id }}">
<header><h2 id="settings-title-{{ id }}">{{ group.title }}</h2><p>{{ group.description }}</p></header>
<div class="settings-fields">
{% for name in group.fields %}
{% set field = attribute(form,name) %}
{% set codeField = name in ['googleAnalytic','facebookMessenger','schemaOrganization','schemaLocalBusiness'] %}
<div class="settings-field {{ 'textarea' in field.vars.block_prefixes ? 'settings-field--wide' : '' }}">
{{ form_row(field, {attr:field.vars.attr|merge(codeField ? {class:'form-control settings-code',spellcheck:'false'} : {class:'form-control'})}) }}
{% if name starts with 'contens_' %}<p class="settings-hint">Dùng trong nội dung: <code>[{{ name|slice(8) }}]</code></p>{% endif %}
{% if name == 'GTM' %}<p class="settings-hint">Nhập ID dạng GTM-…, không phải toàn bộ đoạn script.</p>{% endif %}
{% if name == 'ga4MeasurementID' %}<p class="settings-hint">Nhập Measurement ID dạng G-….</p>{% endif %}
</div>
{% endfor %}
</div>
</section>
{% endfor %}
{{ form_rest(form) }}
</div>
</div>
<footer class="settings-save banner-panel"><span id="settings-save-status" role="status" aria-live="polite">Chưa có thay đổi mới.</span><button type="submit" class="banner-button banner-button--primary">Lưu cấu hình</button></footer>
{{ form_end(form, {render_rest:false}) }}
</section>
{% endblock %}
