{% extends 'admin/layout.html.twig' %}
{% block title %}Sửa menu: {{ original_name }}{% endblock %}
{% block body_id 'admin_menu_edit' %}
{% block flash_messages %}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/page-editor.css') }}"><link rel="stylesheet" href="{{ asset('build/css/menu-manager.css') }}">{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {# menu-editor.js nạp nestable2 và lộ window.NestableJQuery — menu-manager.js dùng bản jQuery đó. #}
    <script src="{{ asset('build/js/menu-editor.js') }}"></script>
    <script src="{{ asset('build/js/menu-manager.js') }}" defer></script>
{% endblock %}

{% macro type_label(type) %}{{ {url: 'Liên kết', page: 'Trang', category: 'Danh mục', news: 'Bài viết'}[type]|default(type) }}{% endmacro %}

{% macro render_item(item, resolved_urls, level) %}
    {% set url = resolved_urls[item.id]|default(item.url) %}
    <li class="dd-item menu-row" data-id="{{ item.id }}"
        data-title="{{ item.title }}"
        data-url="{{ item.url|default('') }}"
        data-resolved-url="{{ url|default('') }}"
        data-type="{{ item.type }}"
        data-target="{{ item.targetAttr|default('_self') }}"
        data-css="{{ item.cssClass|default('') }}"
        data-titleattr="{{ item.titleAttr|default('') }}"
        data-enable="{{ item.enable ? '1' : '0' }}">
        <div class="menu-row__main">
            <div class="dd-handle menu-grip" title="Kéo để sắp xếp"><i class="fa fa-arrows" aria-hidden="true"></i><span class="sr-only">Kéo để sắp xếp</span></div>
            <div class="menu-row__body">
                <div class="menu-row__heading">
                    <span class="menu-row__title" data-menu-title>{{ item.title }}</span>
                    <span class="menu-type menu-type--{{ item.type }}">{{ _self.type_label(item.type) }}</span>
                    <span class="menu-flag menu-flag--off" data-menu-flag-off {{ item.enable ? 'hidden' }}>Đang tắt</span>
                    <span class="menu-flag" data-menu-flag-blank {{ item.targetAttr != '_blank' ? 'hidden' }}>Mở tab mới</span>
                </div>
                <span class="menu-row__url" data-menu-url>{{ url ?: '(chưa có URL)' }}</span>
            </div>
            <div class="menu-row__actions dd-nodrag">
                <button type="button" class="menu-icon-button" data-menu-move="up" aria-label="Chuyển “{{ item.title }}” lên trên"><i class="fa fa-angle-up" aria-hidden="true"></i></button>
                <button type="button" class="menu-icon-button" data-menu-move="down" aria-label="Chuyển “{{ item.title }}” xuống dưới"><i class="fa fa-angle-down" aria-hidden="true"></i></button>
                <button type="button" class="banner-button" data-menu-edit>Sửa</button>
                <form method="post" action="{{ path('admin_menu_item_delete', {id: item.id}) }}" data-menu-confirm data-menu-delete-item
                      data-confirm-title="Xoá mục menu?"
                      data-confirm-message="Xoá “{{ item.title }}”{{ item.children|length ? ' cùng ' ~ item.children|length ~ ' mục con' : '' }} khỏi menu. Nội dung bài viết / trang không bị ảnh hưởng."
                      data-confirm-button="Xoá mục">
                    <input type="hidden" name="token" value="{{ csrf_token('delete') }}">
                    <button type="submit" class="banner-button banner-button--delete">Xoá</button>
                </form>
            </div>
        </div>
        {% if item.children|length > 0 %}
            <ol class="dd-list">
                {% for child in item.children %}{{ _self.render_item(child, resolved_urls, level + 1) }}{% endfor %}
            </ol>
        {% endif %}
    </li>
{% endmacro %}

{% macro source_list(key, label, items, used_ids, type, title_field) %}
    <details class="menu-source" data-menu-source="{{ type }}">
        <summary>{{ label }} <span class="menu-source__count">{{ items|length }}</span></summary>
        {% if items is empty %}
            <p class="page-editor__hint">Chưa có {{ label|lower }} nào.</p>
        {% else %}
            <label class="sr-only" for="menu-search-{{ key }}">Tìm {{ label|lower }}</label>
            <input type="search" id="menu-search-{{ key }}" class="form-control menu-source__search" placeholder="Tìm {{ label|lower }}…" data-menu-filter autocomplete="off">
            <div class="menu-source__list" data-menu-list>
                {% for item in items %}
                    {% set added = item.id in used_ids %}
                    {% set title = attribute(item, title_field) %}
                    <label class="menu-source__item{{ added ? ' is-added' }}">
                        <input type="checkbox" value="{{ item.id }}" data-title="{{ title }}" {{ added ? 'disabled' }}>
                        <span>{{ title }}</span>
                        {% if added %}<small>Đã có trong menu</small>{% endif %}
                    </label>
                {% endfor %}
                <p class="menu-source__none" data-menu-none hidden>Không có kết quả phù hợp.</p>
            </div>
            <div class="menu-source__actions">
                <button type="button" class="banner-button" data-menu-select-all>Chọn tất cả</button>
                <button type="button" class="banner-button banner-button--primary" data-menu-add-checked disabled>Thêm vào menu</button>
            </div>
        {% endif %}
    </details>
{% endmacro %}

{% block main %}
{% set on_site = original_name in site_menu_names %}
{% set top_level = object.items|filter(i => not i.parent) %}
<section class="page-editor menu-editor">
    <header class="page-editor__header">
        <div>
            <a href="{{ path('admin_menu_index') }}">← Danh sách menu</a>
            <h1>Sửa menu: {{ original_name }}</h1>
            <p><span data-menu-count>{{ object.items|length }}</span> mục{% if on_site %} · đang hiển thị trên header và menu mobile của website{% endif %}{% if not object.enable %} · <strong>menu đang tắt</strong>{% endif %}</p>
        </div>
        <a class="btn btn-default" href="{{ path('homepage') }}" target="_blank" rel="noopener">Xem website <span class="sr-only">(mở tab mới)</span></a>
    </header>
    {{ include('admin/redirect/_messages.html.twig') }}
    <div class="menu-notice" data-menu-notice role="status" aria-live="polite" hidden></div>

    <div class="menu-workspace">
        <aside class="menu-workspace__side">
            <section class="page-editor__section" aria-labelledby="menu-add-heading">
                <h2 id="menu-add-heading">Thêm mục vào menu</h2>
                <p class="page-editor__hint">Mục mới được thêm vào cuối menu. Mục trỏ tới trang, danh mục hoặc bài viết tự cập nhật URL khi nội dung đổi đường dẫn.</p>

                <details class="menu-source" open>
                    <summary>Liên kết tùy chỉnh</summary>
                    <form class="menu-custom-link" data-menu-custom-link novalidate>
                        <div class="form-group">
                            <label for="menu-custom-url">URL</label>
                            <input type="text" id="menu-custom-url" name="url" class="form-control" placeholder="/cong-cu/ hoặc https://…" required autocomplete="off" aria-describedby="menu-custom-url-help">
                            <p class="help-block" id="menu-custom-url-help">Nhận https://…, mailto:, tel:, #điểm-neo hoặc đường dẫn bắt đầu bằng /. Dùng “#” cho mục cha chỉ để mở menu con.</p>
                        </div>
                        <div class="form-group">
                            <label for="menu-custom-title">Văn bản liên kết</label>
                            <input type="text" id="menu-custom-title" name="title" class="form-control" placeholder="Tên hiển thị trên menu" required maxlength="255" autocomplete="off">
                        </div>
                        <button type="submit" class="banner-button banner-button--primary">Thêm vào menu</button>
                    </form>
                </details>
                {{ _self.source_list('pages', 'Trang', available_pages, used_page_ids, 'page', 'title') }}
                {{ _self.source_list('categories', 'Danh mục', available_categories, used_category_ids, 'category', 'name') }}
                {{ _self.source_list('posts', 'Bài viết', available_posts, used_post_ids, 'news', 'title') }}
            </section>

            <section class="page-editor__section" aria-labelledby="menu-settings-heading">
                <h2 id="menu-settings-heading">Cài đặt menu</h2>
                {{ form_start(form, {attr: {id: 'menu-settings-form', novalidate: 'novalidate'}}) }}
                {% if not form.vars.valid %}<div class="page-editor__errors" role="alert"><strong>Chưa lưu được cài đặt.</strong>{{ form_errors(form) }}</div>{% endif %}
                {{ include('admin/menu/_settings_fields.html.twig', {form: form, site_menu_names: site_menu_names}, with_context = false) }}
                <button type="submit" class="banner-button banner-button--primary">Lưu cài đặt</button>
                {{ form_end(form) }}
                <div class="menu-danger">
                    <h3>Xoá menu</h3>
                    <p>Xoá menu cùng toàn bộ <span data-menu-count>{{ object.items|length }}</span> mục.{% if on_site %} Website đang dùng menu này.{% endif %}</p>
                    <form method="post" action="{{ path('admin_menu_delete', {id: object.id}) }}" data-menu-confirm data-menu-delete-menu
                          data-confirm-title="Xoá menu?"
                          data-confirm-template="Xoá menu “{{ original_name }}” cùng __COUNT__ mục bên trong. Thao tác không thể hoàn tác.{{ on_site ? ' Header và menu mobile của website sẽ trống.' : '' }}"
                          data-confirm-message="Xoá menu “{{ original_name }}” cùng {{ object.items|length }} mục bên trong. Thao tác không thể hoàn tác.{{ on_site ? ' Header và menu mobile của website sẽ trống.' : '' }}"
                          data-confirm-button="Xoá menu">
                        <input type="hidden" name="token" value="{{ csrf_token('delete') }}">
                        <button type="submit" class="banner-button banner-button--delete">Xoá menu</button>
                    </form>
                </div>
            </section>
        </aside>

        <section class="page-editor__section menu-structure" aria-labelledby="menu-structure-heading">
            <header class="menu-structure__header">
                <div>
                    <h2 id="menu-structure-heading">Cấu trúc menu</h2>
                    <p class="menu-status" data-menu-status role="status" aria-live="polite">Thứ tự tự lưu ngay sau khi kéo thả.</p>
                </div>
                <div class="menu-structure__tools">
                    <button type="button" class="banner-button" data-menu-expand>Mở rộng tất cả</button>
                    <button type="button" class="banner-button" data-menu-collapse>Thu gọn tất cả</button>
                </div>
            </header>
            <p class="page-editor__hint">Kéo biểu tượng <i class="fa fa-arrows" aria-hidden="true"></i> để sắp xếp; kéo lệch sang phải để biến thành mục con. Website hiển thị tối đa {{ max_depth }} cấp: mục gốc và một cấp mục con. Có thể dùng nút ▲ ▼ để đổi thứ tự bằng bàn phím.</p>

            <div class="dd menu-board" id="nestable" data-menu-config="{{ {
                reorderUrl: path('admin_menu_reorder', {id: object.id}),
                addItemUrl: path('admin_menu_add_content_item', {menuId: object.id}),
                updateUrlBase: path('admin_menu_item_update', {id: '__ID__'}),
                deleteUrlBase: path('admin_menu_item_delete', {id: '__ID__'}),
                deleteToken: csrf_token('delete'),
                csrfToken: csrf_token(csrf_id),
                maxDepth: max_depth
            }|json_encode }}">
                <ol class="dd-list" id="menu-items-root">
                    {% for item in top_level %}{{ _self.render_item(item, resolved_urls, 1) }}{% endfor %}
                </ol>
            </div>
            <div class="menu-empty" data-menu-empty {{ object.items|length ? 'hidden' }}>
                <h3>Menu chưa có mục nào</h3>
                <p>Thêm liên kết, trang, danh mục hoặc bài viết từ cột bên trái.</p>
            </div>
        </section>
    </div>

    <dialog id="menu-item-dialog" class="menu-dialog menu-dialog--form" aria-labelledby="menu-item-dialog-title">
        <form data-menu-item-form novalidate>
            <h2 id="menu-item-dialog-title">Sửa mục menu</h2>
            <p class="menu-dialog__source" data-menu-item-source></p>
            <div class="form-group">
                <label for="menu-item-title">Tiêu đề hiển thị <span aria-hidden="true">*</span></label>
                <input type="text" id="menu-item-title" name="title" class="form-control" required maxlength="255">
            </div>
            <div class="form-group" data-menu-item-url-group>
                <label for="menu-item-url">URL</label>
                <input type="text" id="menu-item-url" name="url" class="form-control" aria-describedby="menu-item-url-help">
                <p class="help-block" id="menu-item-url-help" data-menu-item-url-help></p>
            </div>
            <div class="menu-dialog__grid">
                <div class="form-group">
                    <label for="menu-item-target">Mở liên kết</label>
                    <select id="menu-item-target" name="targetAttr" class="form-control">
                        <option value="_self">Trong tab hiện tại</option>
                        <option value="_blank">Trong tab mới</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="menu-item-titleattr">Chú thích khi rê chuột (title)</label>
                    <input type="text" id="menu-item-titleattr" name="titleAttr" class="form-control" maxlength="255">
                </div>
            </div>
            <div class="form-group">
                <label for="menu-item-css">CSS class (tuỳ chọn)</label>
                <input type="text" id="menu-item-css" name="cssClass" class="form-control" placeholder="vd: is-highlight" autocomplete="off">
            </div>
            <label class="menu-editor__check-inline"><input type="checkbox" id="menu-item-enable" name="enable"> Hiển thị mục này trên website</label>
            <p class="menu-dialog__error" data-menu-item-error role="alert" hidden></p>
            <div class="menu-dialog__actions">
                <button type="button" class="banner-button banner-button--delete menu-dialog__start" data-menu-item-delete>Xoá mục</button>
                <button type="button" class="banner-button" data-menu-item-cancel>Hủy</button>
                <button type="submit" class="banner-button banner-button--primary">Lưu mục</button>
            </div>
        </form>
    </dialog>
    {{ include('admin/menu/_confirm_dialog.html.twig') }}
</section>
{% endblock %}
