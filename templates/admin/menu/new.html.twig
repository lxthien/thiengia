{% extends 'admin/layout.html.twig' %}

{% block title %}Create Menu{% endblock %}

{% block main %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1 class="h2 mb-4">Create New Menu</h1>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            <div class="card">
                <div class="card-body">
                    <div class="form-group">
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.name) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <div class="form-group">
                        <div class="custom-control custom-checkbox">
                            {{ form_widget(form.enable, {'attr': {'class': 'custom-control-input'}}) }}
                            {{ form_label(form.enable, 'Enable this menu', {'label_attr': {'class': 'custom-control-label'}}) }}
                        </div>
                        {{ form_errors(form.enable) }}
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save"></i> Create Menu
                </button>
                <a href="{{ path('admin_menu_index') }}" class="btn btn-secondary">
                    <i class="fa fa-times"></i> Cancel
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
