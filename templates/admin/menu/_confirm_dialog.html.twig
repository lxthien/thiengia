{# Hộp xác nhận dùng chung cho form có data-menu-confirm (xem public/assets/js/admin/menu-manager.js). #}
<dialog id="menu-confirm" class="menu-dialog" aria-labelledby="menu-confirm-title" aria-describedby="menu-confirm-message">
    <h2 id="menu-confirm-title">Xác nhận</h2>
    <p id="menu-confirm-message"></p>
    <div class="menu-dialog__actions">
        <button type="button" class="banner-button" id="menu-confirm-cancel" autofocus>Hủy</button>
        <button type="button" class="banner-button banner-button--danger" id="menu-confirm-ok">Xoá</button>
    </div>
</dialog>
