<form method="post" action="{{ path('admin_redirect_delete', {'id': object.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');" style="display:inline-block;">
    <input type="hidden" name="token" value="{{ csrf_token('delete') }}">
    <button type="submit" class="btn btn-sm text-danger" style="background: none; border: none; padding: 0;">
        <i class="fa fa-trash" aria-hidden="true"></i>
    </button>
</form>
