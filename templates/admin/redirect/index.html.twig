{% extends 'admin/layout.html.twig' %}
{% block title %}Quản lý chuyển hướng{% endblock %}
{% block body_id 'admin_redirect_index' %}
{% block flash_messages %}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/redirect-manager.css') }}">{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('build/js/redirect-manager.js') }}" defer></script>{% endblock %}
{% block main %}
<section class="banner-manager contact-manager redirect-manager">
<header class="banner-manager__header"><div><h1>Quản lý chuyển hướng</h1><p>Quản lý đường dẫn cũ và đích đến khi URL thay đổi.</p></div><a class="banner-button banner-button--primary" href="{{ path('admin_redirect_new') }}">Thêm chuyển hướng</a></header>
{{ include('admin/redirect/_messages.html.twig') }}
<div class="redirect-tools"><a class="banner-button" href="{{ path('admin_redirect_export_csv') }}">Xuất toàn bộ CSV</a><span>{{ total }} quy tắc trong hệ thống</span></div>
<details class="banner-panel redirect-import"><summary>Nhập chuyển hướng từ CSV</summary><p>Nhập sẽ thêm quy tắc mới, không cập nhật quy tắc hiện có. Kiểm tra dữ liệu trước khi nhập để tránh trùng lặp.</p><p>Thứ tự cột: Source URL, Destination URL, Match Type, Status Code, Active, Order, Note. Dòng đầu là tiêu đề. Có thể dùng file xuất CSV làm mẫu.</p>
<form method="post" action="{{ path('admin_redirect_import_csv') }}" enctype="multipart/form-data"><input type="hidden" name="token" value="{{ csrf_token('redirect_import') }}"><label for="redirect-csv">File CSV</label><input id="redirect-csv" type="file" name="csv_file" accept=".csv,.txt" required><button class="banner-button banner-button--primary" type="submit">Nhập CSV</button></form></details>
<form class="banner-panel contact-filters redirect-filters" method="get" action="{{ path('admin_redirect_index') }}">
<label>Tìm chuyển hướng<input type="search" name="search" value="{{ filters.search }}" placeholder="URL nguồn, URL đích hoặc ghi chú…"></label>
<label>Kiểu khớp<select name="type"><option value="">Tất cả</option>{% for value,label in {'exact':'Chính xác','wildcard':'Wildcard (*)','regex':'Biểu thức chính quy'} %}<option value="{{ value }}" {{ filters.type == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
<label>Trạng thái<select name="is_active"><option value="">Tất cả</option><option value="1" {{ filters.is_active == '1' ? 'selected' : '' }}>Đang bật</option><option value="0" {{ filters.is_active == '0' ? 'selected' : '' }}>Đã tắt</option></select></label>
<div class="redirect-filter-actions"><button type="submit" class="banner-button banner-button--primary">Tìm kiếm</button><a class="banner-button" href="{{ path('admin_redirect_index') }}">Xóa bộ lọc</a></div>
</form>
<section class="banner-panel" aria-labelledby="redirect-results"><header class="banner-panel__toolbar"><h2 id="redirect-results">Danh sách quy tắc</h2><span>{{ pagination.totalItemCount }} kết quả · Trang {{ pagination.currentPageNumber }}</span></header>
<p class="redirect-order">Ưu tiên số nhỏ trước; cùng mức ưu tiên, quy tắc mới hơn được xét trước.</p>
{% for row in pagination %}
<article class="contact-row redirect-row"><div class="redirect-urls"><dl><dt>URL nguồn</dt><dd>{{ row.sourceUrl }}</dd><dt>URL đích</dt><dd>{{ row.destinationUrl }}</dd></dl>{% if row.note %}<details><summary>Ghi chú</summary><p>{{ row.note }}</p></details>{% endif %}</div>
<div><p><span class="contact-status {{ row.isActive ? 'is-unread' : 'is-read' }}">{{ row.isActive ? 'Đang bật' : 'Đã tắt' }}</span> <strong>{{ row.statusCode }}</strong></p><p class="contact-muted">{{ {'exact':'Chính xác','wildcard':'Wildcard (*)','regex':'Biểu thức chính quy'}[row.matchType]|default(row.matchType) }} · Ưu tiên {{ row.orderNum }} · #{{ row.id }}</p>
<div class="contact-actions"><a class="banner-button" href="{{ path('admin_redirect_edit',{id:row.id}) }}">Sửa</a><form method="post" action="{{ path('admin_redirect_delete',filters|merge({id:row.id,page:pagination.currentPageNumber})) }}" data-redirect-delete data-source="{{ row.sourceUrl }}"><input type="hidden" name="token" value="{{ csrf_token('delete') }}"><button type="submit" class="banner-button banner-button--delete">Xóa</button></form></div></div></article>
{% else %}<div class="contact-empty"><h3>{{ filters.search or filters.type or filters.is_active != '' ? 'Không có chuyển hướng phù hợp' : 'Chưa có chuyển hướng' }}</h3><p>Thêm quy tắc mới hoặc điều chỉnh bộ lọc để xem kết quả.</p><a class="banner-button" href="{{ path('admin_redirect_new') }}">Thêm chuyển hướng</a></div>{% endfor %}
{% if pagination.pageCount > 1 %}<nav class="contact-pagination" aria-label="Phân trang chuyển hướng">{{ knp_pagination_render(pagination,'@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}</nav>{% endif %}
</section>
<dialog id="redirect-confirm" aria-labelledby="redirect-confirm-title"><h2 id="redirect-confirm-title">Xóa chuyển hướng?</h2><p id="redirect-confirm-message"></p><p>Quy tắc sẽ ngừng hoạt động và bị xóa khỏi hệ thống. Không thể hoàn tác.</p><div class="contact-actions"><button type="button" class="banner-button" id="redirect-cancel" autofocus>Hủy</button><button type="button" class="banner-button banner-button--danger" id="redirect-delete">Xóa chuyển hướng</button></div></dialog>
</section>
{% endblock %}
