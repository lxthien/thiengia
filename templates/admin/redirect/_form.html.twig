{{ form_start(form) }}
    <div class="row">
        <div class="col-md-6">
            {{ form_row(form.sourceUrl) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.destinationUrl) }}
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-4">
            {{ form_row(form.matchType) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.statusCode) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.orderNum) }}
        </div>
    </div>
    
    <div class="form-group">
        {{ form_row(form.note) }}
    </div>

    <div class="form-group">
        {{ form_row(form.isActive) }}
    </div>

    <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save</button>
    <a href="{{ path('admin_redirect_index') }}" class="btn btn-secondary">Cancel</a>
{{ form_end(form) }}
