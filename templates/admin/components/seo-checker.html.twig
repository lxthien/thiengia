{# SEO Score Checker Component #}
<div class="seo-checker-container" id="seoCheckerContainer">
    <style>
        .seo-checker-container {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 4px;
            padding: 20px;
            margin: 20px 0;
        }

        .seo-checker-container h4 {
            margin-top: 0;
            margin-bottom: 15px;
            color: #333;
            font-size: 16px;
            font-weight: 600;
        }

        .seo-score-bar {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }

        .seo-score-label {
            min-width: 100px;
            font-weight: 500;
            color: #555;
        }

        .seo-score-indicator {
            display: flex;
            align-items: center;
            gap: 10px;
            flex: 1;
        }

        .seo-score-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 14px;
            flex-shrink: 0;
        }

        .seo-score-circle.excellent {
            background-color: #27ae60;
        }

        .seo-score-circle.good {
            background-color: #3498db;
        }

        .seo-score-circle.moderate {
            background-color: #f39c12;
        }

        .seo-score-circle.poor {
            background-color: #e74c3c;
        }

        .seo-score-text {
            font-weight: 500;
        }

        .seo-checks {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 15px;
        }

        .seo-check-item {
            background: white;
            border: 1px solid #e9ecef;
            border-radius: 4px;
            padding: 12px;
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }

        .seo-check-icon {
            font-size: 20px;
            flex-shrink: 0;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .seo-check-icon.check {
            color: #27ae60;
        }

        .seo-check-icon.warning {
            color: #f39c12;
        }

        .seo-check-icon.error {
            color: #e74c3c;
        }

        .seo-check-content {
            flex: 1;
        }

        .seo-check-title {
            font-weight: 600;
            font-size: 13px;
            color: #333;
            margin: 0 0 4px 0;
        }

        .seo-check-desc {
            font-size: 12px;
            color: #666;
            margin: 0;
        }

        .seo-focus-keyword {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid #e9ecef;
        }

        .seo-focus-keyword label {
            display: block;
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 8px;
            color: #333;
        }

        .seo-focus-keyword input {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 13px;
        }

        .seo-keyword-density {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid #e9ecef;
        }

        .seo-keyword-density-title {
            font-weight: 600;
            font-size: 13px;
            color: #333;
            margin-bottom: 8px;
        }

        .seo-density-bar {
            display: flex;
            align-items: center;
            margin-bottom: 8px;
            gap: 10px;
        }

        .seo-density-label {
            min-width: 80px;
            font-size: 12px;
            color: #666;
        }

        .seo-density-progress {
            flex: 1;
            height: 20px;
            background: #e9ecef;
            border-radius: 3px;
            overflow: hidden;
            position: relative;
        }

        .seo-density-fill {
            height: 100%;
            background: #3498db;
            border-radius: 3px;
            transition: width 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 10px;
            font-weight: bold;
        }

        .seo-tips {
            margin-top: 15px;
            padding: 12px;
            background: #e7f3ff;
            border-left: 4px solid #3498db;
            border-radius: 4px;
            font-size: 12px;
            color: #333;
        }

        .seo-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .seo-toggle-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 18px;
            color: #555;
            padding: 4px 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s ease;
        }

        .seo-toggle-btn:hover {
            color: #333;
        }

        .seo-toggle-btn.collapsed {
            transform: rotate(-90deg);
        }

        .seo-content {
            max-height: 1000px;
            overflow: hidden;
            transition: max-height 0.3s ease, opacity 0.3s ease;
            opacity: 1;
        }

        .seo-content.collapsed {
            max-height: 0;
            opacity: 0;
            display: none;
        }
    </style>

    <div class="seo-header">
        <h4 style="margin: 0;">🔍 SEO Score Checker</h4>
        <button class="seo-toggle-btn collapsed" id="seoToggleBtn" title="Expand/Collapse">▼</button>
    </div>

    <!-- Content Section (Collapsed by default) -->
    <div class="seo-content collapsed" id="seoContent">
        <!-- Overall Score -->
    <div class="seo-score-bar">
        <div class="seo-score-label">SEO Score</div>
        <div class="seo-score-indicator">
            <div class="seo-score-circle" id="seoScoreCircle">0</div>
            <span class="seo-score-text" id="seoScoreText">No data</span>
        </div>
    </div>

    <!-- Focus Keyword Input -->
    <div class="seo-focus-keyword">
        <label for="seoFocusKeyword">Focus Keyword (choose main keyword for optimization)</label>
        <input type="text" id="seoFocusKeyword" placeholder="e.g., best coffee in Hanoi">
    </div>

    <!-- SEO Checks -->
    <div class="seo-checks" id="seoChecks" style="margin-top: 15px;">
        <!-- Items will be generated by JavaScript -->
    </div>

    <!-- Keyword Density -->
    <div class="seo-keyword-density" id="keywordDensitySection" style="display: none;">
        <div class="seo-keyword-density-title">Focus Keyword Density</div>
        <div class="seo-density-bar">
            <div class="seo-density-label">Density</div>
            <div class="seo-density-progress">
                <div class="seo-density-fill" id="keywordDensityFill" style="width: 0%">0%</div>
            </div>
        </div>
        <p class="seo-check-desc" id="keywordDensityText">0 occurrences (optimal: 1-2%)</p>
    </div>

        <!-- Tips Section -->
        <div class="seo-tips" id="seoTips"></div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // SEO Checker Configuration
    const seoConfig = {
        title: {
            selector: '#news_title, input[name*="title"]',
            min: 30,
            max: 60,
            ideal: [50, 60]
        },
        metaDescription: {
            selector: '#news_metaDescription, textarea[name*="metaDescription"]',
            min: 120,
            max: 160,
            ideal: [150, 160]
        },
        slug: {
            selector: '#news_url, input[name*="url"]',
            min: 3,
            max: 75
        },
        content: {
            selector: '.ck-editor__editable, textarea[name*="content"], [data-ckeditor]',
            minWords: 300
        }
    };

    const container = document.getElementById('seoCheckerContainer');
    if (!container) return;

    // Toggle SEO Checker visibility
    const toggleBtn = document.getElementById('seoToggleBtn');
    const seoContent = document.getElementById('seoContent');
    
    toggleBtn.addEventListener('click', function() {
        seoContent.classList.toggle('collapsed');
        toggleBtn.classList.toggle('collapsed');
    });

    const focusKeywordInput = document.getElementById('seoFocusKeyword');
    const seoScoreCircle = document.getElementById('seoScoreCircle');
    const seoScoreText = document.getElementById('seoScoreText');
    const seoChecks = document.getElementById('seoChecks');
    const keywordDensitySection = document.getElementById('keywordDensitySection');
    const keywordDensityFill = document.getElementById('keywordDensityFill');
    const keywordDensityText = document.getElementById('keywordDensityText');
    const seoTips = document.getElementById('seoTips');

    // Get form fields
    function getFormValues() {
        // Title: prioritize pageTitle, fallback to title
        let titleField = document.querySelector('#news_pageTitle');
        let titleValue = titleField && titleField.value ? titleField.value : '';
        if (!titleValue) {
            titleField = document.querySelector('#news_title');
            titleValue = titleField ? titleField.value : '';
        }

        // Description: prioritize pageDescription, fallback to description
        let descField = document.querySelector('#news_pageDescription');
        let descValue = descField && descField.value ? descField.value : '';
        if (!descValue) {
            descField = document.querySelector('#news_description');
            descValue = descField ? descField.value : '';
        }

        // Slug
        const slugField = document.querySelector(seoConfig.slug.selector);
        const slugValue = slugField ? slugField.value : '';

        // Content
        const contentField = document.querySelector(seoConfig.content.selector);
        const contentValue = contentField ? getContentText(contentField) : '';

        return {
            title: titleValue,
            description: descValue,
            slug: slugValue,
            content: contentValue
        };
    }

    // Get content text from CKEditor or textarea
    function getContentText(field) {
        // If it's a CKEditor instance
        if (window.CKEDITOR && CKEDITOR.instances && CKEDITOR.instances.news_contents) {
            return CKEDITOR.instances.news_contents.getData();
        }
        
        // CKEditor 5
        if (field.classList && field.classList.contains('ck-editor__editable')) {
            return field.textContent || '';
        }
        
        // Regular textarea
        if (field.tagName === 'TEXTAREA') {
            return field.value || '';
        }
        
        // Fallback
        return field.value || field.textContent || '';
    }

    // Calculate SEO Score
    function calculateSeoScore() {
        const values = getFormValues();
        const focusKeyword = focusKeywordInput.value.trim().toLowerCase();
        let score = 0;
        const checks = [];

        // 1. Title Check (20 points)
        if (values.title.length >= seoConfig.title.min && values.title.length <= seoConfig.title.max) {
            score += 20;
            checks.push({
                status: 'check',
                title: 'Title Length',
                desc: `Perfect! ${values.title.length} characters (${seoConfig.title.min}-${seoConfig.title.max})`
            });
        } else if (values.title.length === 0) {
            checks.push({
                status: 'error',
                title: 'Title Length',
                desc: 'Add a title to optimize for search engines'
            });
        } else if (values.title.length < seoConfig.title.min) {
            score += 10;
            checks.push({
                status: 'warning',
                title: 'Title Length',
                desc: `Too short! ${values.title.length} characters (need ${seoConfig.title.min}-${seoConfig.title.max})`
            });
        } else {
            score += 10;
            checks.push({
                status: 'warning',
                title: 'Title Length',
                desc: `Too long! ${values.title.length} characters (need ${seoConfig.title.min}-${seoConfig.title.max})`
            });
        }

        // 2. Meta Description Check (20 points)
        if (values.description.length >= seoConfig.metaDescription.min && values.description.length <= seoConfig.metaDescription.max) {
            score += 20;
            checks.push({
                status: 'check',
                title: 'Meta Description',
                desc: `Perfect! ${values.description.length} characters (${seoConfig.metaDescription.min}-${seoConfig.metaDescription.max})`
            });
        } else if (values.description.length === 0) {
            checks.push({
                status: 'error',
                title: 'Meta Description',
                desc: 'Add a meta description for better search visibility'
            });
        } else if (values.description.length < seoConfig.metaDescription.min) {
            score += 10;
            checks.push({
                status: 'warning',
                title: 'Meta Description',
                desc: `Too short! ${values.description.length} characters (need ${seoConfig.metaDescription.min}-${seoConfig.metaDescription.max})`
            });
        } else {
            score += 10;
            checks.push({
                status: 'warning',
                title: 'Meta Description',
                desc: `Too long! ${values.description.length} characters (need ${seoConfig.metaDescription.min}-${seoConfig.metaDescription.max})`
            });
        }

        // 3. Slug Check (15 points)
        if (values.slug.length > 0) {
            if (/^[a-z0-9-]+$/.test(values.slug)) {
                score += 15;
                checks.push({
                    status: 'check',
                    title: 'URL Slug',
                    desc: `Optimized slug: ${values.slug}`
                });
            } else {
                score += 7;
                checks.push({
                    status: 'warning',
                    title: 'URL Slug',
                    desc: 'Use only lowercase letters, numbers, and hyphens'
                });
            }
        } else {
            checks.push({
                status: 'warning',
                title: 'URL Slug',
                desc: 'Create a URL slug for this page'
            });
        }

        // 4. Content Length Check (15 points)
        const wordCount = values.content.trim().split(/\s+/).length;
        if (wordCount >= seoConfig.content.minWords) {
            score += 15;
            checks.push({
                status: 'check',
                title: 'Content Length',
                desc: `Great! ${wordCount} words (minimum ${seoConfig.content.minWords})`
            });
        } else if (wordCount === 0) {
            checks.push({
                status: 'error',
                title: 'Content Length',
                desc: `Add content (need at least ${seoConfig.content.minWords} words)`
            });
        } else {
            score += Math.floor((wordCount / seoConfig.content.minWords) * 15);
            checks.push({
                status: 'warning',
                title: 'Content Length',
                desc: `Too short! ${wordCount} words (need at least ${seoConfig.content.minWords})`
            });
        }

        // 5. Focus Keyword Check (15 points)
        if (focusKeyword.length > 0) {
            const titleHasKeyword = values.title.toLowerCase().includes(focusKeyword);
            const descHasKeyword = values.description.toLowerCase().includes(focusKeyword);
            const contentHasKeyword = values.content.toLowerCase().includes(focusKeyword);

            let keywordScore = 0;
            let keywordChecks = [];

            if (titleHasKeyword) {
                keywordScore += 5;
                keywordChecks.push('in title');
            }
            if (descHasKeyword) {
                keywordScore += 5;
                keywordChecks.push('in description');
            }
            if (contentHasKeyword) {
                keywordScore += 5;
                keywordChecks.push('in content');
            }

            score += keywordScore;

            if (keywordChecks.length > 0) {
                checks.push({
                    status: 'check',
                    title: 'Focus Keyword',
                    desc: `"${focusKeyword}" found ${keywordChecks.join(', ')}`
                });
            } else {
                checks.push({
                    status: 'warning',
                    title: 'Focus Keyword',
                    desc: `"${focusKeyword}" not found in main areas`
                });
            }

            // Show keyword density
            keywordDensitySection.style.display = 'block';
            const keywordCount = (values.content.toLowerCase().match(new RegExp(focusKeyword, 'g')) || []).length;
            const density = wordCount > 0 ? ((keywordCount / wordCount) * 100).toFixed(2) : 0;
            keywordDensityFill.style.width = Math.min(density * 50, 100) + '%';
            keywordDensityText.textContent = `${keywordCount} occurrences (density: ${density}% - optimal: 1-2%)`;
        } else {
            keywordDensitySection.style.display = 'none';
        }

        return { score: Math.min(score, 100), checks };
    }

    // Update UI with SEO checks
    function updateSeoUI() {
        const { score, checks } = calculateSeoScore();

        // Update score circle
        let scoreClass = 'poor';
        let scoreLabel = 'Poor';
        if (score >= 80) {
            scoreClass = 'excellent';
            scoreLabel = 'Excellent';
        } else if (score >= 60) {
            scoreClass = 'good';
            scoreLabel = 'Good';
        } else if (score >= 40) {
            scoreClass = 'moderate';
            scoreLabel = 'Moderate';
        }

        seoScoreCircle.className = `seo-score-circle ${scoreClass}`;
        seoScoreCircle.textContent = score;
        seoScoreText.textContent = `${scoreLabel} (${score}/100)`;

        // Update checks
        seoChecks.innerHTML = '';
        checks.forEach(check => {
            const item = document.createElement('div');
            item.className = 'seo-check-item';
            
            let icon = '✓';
            if (check.status === 'warning') icon = '⚠';
            if (check.status === 'error') icon = '✕';

            item.innerHTML = `
                <div class="seo-check-icon ${check.status}">${icon}</div>
                <div class="seo-check-content">
                    <p class="seo-check-title">${check.title}</p>
                    <p class="seo-check-desc">${check.desc}</p>
                </div>
            `;

            seoChecks.appendChild(item);
        });

        // Update tips
        let tips = '💡 <strong>SEO Tips:</strong><br>';
        if (score < 100) {
            const failedChecks = checks.filter(c => c.status !== 'check');
            if (failedChecks.length > 0) {
                tips += failedChecks.map(c => `• ${c.title}: ${c.desc}`).join('<br>');
            }
        } else {
            tips += '✓ Your page is well optimized for search engines!';
        }
        seoTips.innerHTML = tips;
    }

    // Setup event listeners
    const titleSelectors = ['#news_pageTitle', '#news_title'];
    const descSelectors = ['#news_pageDescription', '#news_description'];
    
    titleSelectors.forEach(selector => {
        const field = document.querySelector(selector);
        if (field) field.addEventListener('input', updateSeoUI);
    });

    descSelectors.forEach(selector => {
        const field = document.querySelector(selector);
        if (field) field.addEventListener('input', updateSeoUI);
    });

    const slugField = document.querySelector(seoConfig.slug.selector);
    const contentField = document.querySelector(seoConfig.content.selector);
    
    if (slugField) slugField.addEventListener('input', updateSeoUI);
    if (contentField) {
        contentField.addEventListener('input', updateSeoUI);
        contentField.addEventListener('change', updateSeoUI);
        
        // For CKEditor editable area, use MutationObserver
        if (contentField.classList && contentField.classList.contains('ck-editor__editable')) {
            const observer = new MutationObserver(updateSeoUI);
            observer.observe(contentField, {
                childList: true,
                subtree: true,
                characterData: true,
                characterDataOldValue: false
            });
        }
    }
    focusKeywordInput.addEventListener('input', updateSeoUI);

    // CKEditor integration
    if (window.CKEDITOR) {
        // CKEditor 4 Classic
        CKEDITOR.on('instanceReady', function(evt) {
            evt.editor.on('change', updateSeoUI);
            evt.editor.on('contentDom', function() {
                evt.editor.editable().attachListener(CKEDITOR.dom.element.createFromHtml('<div></div>'), 'input', function() {
                    updateSeoUI();
                });
            });
        });

        // Also listen for existing instances
        for (var instanceName in CKEDITOR.instances) {
            if (CKEDITOR.instances.hasOwnProperty(instanceName)) {
                CKEDITOR.instances[instanceName].on('change', updateSeoUI);
            }
        }
    }

    // Initial check
    updateSeoUI();
});
</script>
