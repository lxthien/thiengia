{#
   Form-agnostic checker: PageType and NewsType use the same News entity but
   have different form root IDs. Passing the actual field IDs avoids brittle
   #news_* selectors and lets the compiled module serve both screens.
#}
<section class="seo-checker-container"
         data-seo-checker
         data-seo-title-input="#{{ form.pageTitle.vars.id }}"
         data-seo-title-fallback-input="#{{ form.title.vars.id }}"
         data-seo-description-input="#{{ form.pageDescription.vars.id }}"
         data-seo-description-fallback-input="#{{ form.description.vars.id }}"
         data-seo-slug-input="#{{ form.url.vars.id }}"
         data-seo-content-input="#{{ form.contents.vars.id }}"
         data-seo-focus-input="#{{ form.pageKeyword.vars.id }}">
    <header class="seo-checker__header">
        <div>
            <h4>SEO &amp; preview</h4>
            <p>Kiểm tra nội dung trước khi xuất bản.</p>
        </div>
        <button type="button" class="seo-toggle-btn" data-seo-toggle aria-expanded="false" aria-controls="seo-checker-content-{{ form.vars.id }}">
            Mở kiểm tra
        </button>
    </header>

    <div class="seo-content" id="seo-checker-content-{{ form.vars.id }}" data-seo-content hidden>
        <div class="seo-score-bar">
            <div class="seo-score-label">SEO score</div>
            <div class="seo-score-indicator">
                <div class="seo-score-circle poor" data-seo-score>0</div>
                <span class="seo-score-text" data-seo-score-text>Chưa đủ dữ liệu</span>
            </div>
        </div>

        <div class="seo-serp-preview" aria-label="Xem trước kết quả tìm kiếm">
            <span class="seo-serp-preview__label">Google preview</span>
            <strong data-seo-preview-title>Tiêu đề trang</strong>
            <span data-seo-preview-url>https://example.com/duong-dan</span>
            <p data-seo-preview-description>Thêm mô tả SEO để xem trước đoạn hiển thị.</p>
        </div>

        <p class="seo-focus-keyword-note">
            Từ khóa trọng tâm dùng field “Từ khóa trọng tâm” trong phần SEO của form và được lưu cùng bài viết/trang.
        </p>

        <div class="seo-checks" data-seo-checks></div>

        <div class="seo-keyword-density" data-seo-density hidden>
            <div class="seo-keyword-density-title">Mật độ từ khóa trọng tâm</div>
            <div class="seo-density-bar">
                <div class="seo-density-label">Mật độ</div>
                <div class="seo-density-progress">
                    <div class="seo-density-fill" data-seo-density-fill></div>
                </div>
            </div>
            <p class="seo-check-desc" data-seo-density-text></p>
        </div>

        <div class="seo-tips" data-seo-tips aria-live="polite"></div>
    </div>
</section>
