{% extends 'admin/layout.html.twig' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'action.edit'|trans }}</strong>
                        </div>
                        <div class="card-body">
                            <div id="pay-invoice">
                                <div class="card-body">
                                    {{ form_errors(form) }}
                                    {{ form_start(form) }}
                                        {{ form_row(form.name) }}
                                        {{ form_row(form.role) }}
                                        {{ form_row(form.text) }}
                                        {{ form_row(form.rating) }}
                                        {{ form_row(form.enable) }}
                                        {{ include('admin/testimonial/_form_media.html.twig', {current_image: object.avatarUrl}) }}

                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa fa-save" aria-hidden="true"></i> {{ 'action.save'|trans }}
                                        </button>

                                        <a href="{{ path('admin_testimonial_index') }}" class="btn btn-link">
                                            <i class="fa fa-list-alt" aria-hidden="true"></i> {{ 'action.back_to_list'|trans }}
                                        </a>
                                        {{ form_widget(form._token) }}
                                    {{ form_end(form, {render_rest: false}) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
