{% extends 'admin/layout.html.twig' %}
{% block title %}Đánh giá khách hàng{% endblock %}
{% block body_id 'admin_testimonial_index' %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/testimonial-index.css') }}">{% endblock %}
{% block main %}
    {{ include('admin/testimonial/_manager.html.twig') }}
    <dialog class="banner-editor-dialog" id="testimonial-editor-dialog" aria-labelledby="testimonial-editor-title">
        <div class="banner-dialog__header"><h2 id="testimonial-editor-title">Đánh giá khách hàng</h2><button type="button" class="banner-dialog__close" data-testimonial-panel-close aria-label="Đóng">&times;</button></div>
        <p class="banner-panel-error" data-testimonial-panel-error role="alert" hidden></p>
        <div class="banner-editor-content" data-testimonial-panel-content></div>
    </dialog>
    <dialog class="banner-delete-dialog" id="testimonial-confirm-dialog" aria-labelledby="testimonial-confirm-title" aria-describedby="testimonial-confirm-description">
        <div class="banner-dialog__header"><h2 id="testimonial-confirm-title">Xóa đánh giá?</h2><button type="button" class="banner-dialog__close" data-testimonial-confirm-close aria-label="Đóng">&times;</button></div>
        <div class="banner-dialog__body"><p id="testimonial-confirm-description"></p><p data-confirm-error role="alert" hidden></p></div>
        <div class="banner-dialog__footer"><button type="button" class="banner-button" data-testimonial-confirm-close autofocus>Hủy</button><button type="button" class="banner-button banner-button--danger" data-testimonial-confirm-submit>Xóa đánh giá</button></div>
    </dialog>
    <dialog class="banner-media-dialog" id="testimonial-media-dialog" aria-labelledby="testimonial-media-title" data-picker-url="{{ path('admin_media_picker', {_format: 'json'}) }}">
        <div class="banner-dialog__header"><h2 id="testimonial-media-title">Chọn ảnh đại diện</h2><button type="button" class="banner-dialog__close" data-media-close aria-label="Đóng thư viện">&times;</button></div>
        <div class="banner-dialog__body">
            <div class="banner-media-tools"><label>Thư mục<select data-media-folder><option value="">Tất cả thư mục</option></select></label><label>Tìm trong danh sách<input type="search" data-media-search placeholder="Tên ảnh..."></label></div>
            <p class="banner-media-help">Hiển thị tối đa 48 ảnh mới nhất của thư mục. Chọn thư mục để tìm thêm ảnh.</p>
            <div class="banner-media-tools"><a class="banner-button" href="{{ path('admin_media_index') }}" target="_blank" rel="noopener">Tải ảnh mới (tab mới)</a><button type="button" class="banner-button" data-media-refresh>Làm mới</button></div>
            <p data-media-status role="status"></p><div class="banner-media-grid" data-media-grid></div>
        </div>
    </dialog>
{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('build/js/menu-editor.js') }}"></script><script src="{{ asset('build/js/testimonial-index.js') }}"></script>{% endblock %}
