{% set seen = seen|default([]) %}
{% if category.id not in seen %}
{% set seen = seen|merge([category.id]) %}
{% set children = category.children %}
{% set news_count = news_counts[category.id]|default(0) %}
<tr class="category-row {{ level > 0 ? 'category-row--child' : '' }}">
<td><a class="category-thumbnail" href="{{ path('admin_newscategory_edit',{id:category.id}) }}" aria-label="Sửa ảnh đại diện: {{ category.name }}">
{% if category.thumbnail %}<img data-category-thumbnail src="{{ asset(category.thumbnail) }}" alt="" width="72" height="54" loading="lazy"><span data-category-image-fallback hidden>Ảnh không tải được</span>{% else %}<span>Chưa có ảnh</span>{% endif %}
</a></td>
<td><div class="category-node {{ level > 0 ? 'category-node--child' : '' }}" style="--category-level:{{ min(level,6) }}">
<a class="category-title" href="{{ path('admin_newscategory_edit',{id:category.id}) }}">{{ category.name }}</a><span class="category-level">{{ level == 0 ? 'Danh mục gốc' : 'Cấp ' ~ (level + 1) }}{% if children|length %} · {{ children|length }} danh mục con{% endif %}</span>
<p class="category-url">{{ category.url }}</p>
{% if category.parentcat %}<p class="category-parent">Thuộc: <a href="{{ path('admin_newscategory_edit',{id:category.parentcat.id}) }}">{{ category.parentcat.name }}</a></p>{% endif %}
</div></td>
<td><span class="category-status {{ category.enable ? 'is-enabled' : 'is-disabled' }}">{{ category.enable ? 'Đang hiển thị' : 'Đang ẩn' }}</span>{% if not category.metaIndex %}<small>Không index (noindex)</small>{% endif %}</td>
<td><a class="category-count" href="{{ path('admin_news_list_by_category',{categoryId:category.id}) }}" aria-label="Xem {{ news_count }} bài viết thuộc {{ category.name }}">{{ news_count }} bài</a></td>
<td><time>{{ category.updatedAt|date('d/m/Y H:i','Asia/Ho_Chi_Minh') }}</time><small>Tạo: {{ category.createdAt|date('d/m/Y','Asia/Ho_Chi_Minh') }}</small></td>
<td><div class="category-actions"><a class="banner-button" href="{{ path('admin_newscategory_edit',{id:category.id}) }}">Sửa</a>
{% if children|length == 0 %}<form method="post" action="{{ path('admin_newscategory_delete',{id:category.id}) }}" data-category-delete data-title="{{ category.name }}" data-news="{{ news_count }}"><input type="hidden" name="token" value="{{ csrf_token('delete') }}"><button class="banner-button banner-button--delete" type="submit">Xóa</button></form>{% else %}<small>Chuyển danh mục con sang cha khác trước khi xóa.</small>{% endif %}
</div></td>
</tr>
{% if render_children %}{% for child in children %}{{ include('admin/newscategory/_tree_row.html.twig',{category:child,level:level+1,render_children:true,news_counts:news_counts,seen:seen},with_context=false) }}{% endfor %}{% endif %}
{% endif %}
