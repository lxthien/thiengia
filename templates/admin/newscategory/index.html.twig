{% extends 'admin/layout.html.twig' %}
{% block title %}Danh mục bài viết{% endblock %}
{% block body_id 'admin_category_index' %}
{% block flash_messages %}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/newscategory-index.css') }}">{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('build/js/newscategory-index.js') }}" defer></script>{% endblock %}
{% block main %}
<section class="banner-manager category-manager">
<header class="banner-manager__header"><div><h1>Danh mục bài viết</h1><p>Tổ chức bài viết theo danh mục cha và danh mục con.</p></div><a class="banner-button banner-button--primary" href="{{ path('admin_newscategory_new') }}">Thêm danh mục</a></header>
{{ include('admin/redirect/_messages.html.twig') }}
<form class="banner-panel category-search" method="get" action="{{ path('admin_newscategory_index') }}">
<label class="category-search__query">Tìm danh mục<input type="search" name="q" value="{{ filters.q }}" placeholder="Tên, URL, tiêu đề SEO hoặc mô tả…"></label>
<label>Trạng thái<select name="status"><option value="">Tất cả trạng thái</option><option value="enabled" {{ filters.status == 'enabled' ? 'selected' : '' }}>Đang hiển thị</option><option value="disabled" {{ filters.status == 'disabled' ? 'selected' : '' }}>Đang ẩn</option></select></label>
<button class="banner-button banner-button--primary" type="submit">Tìm kiếm</button><a class="banner-button" href="{{ path('admin_newscategory_index') }}">Xóa bộ lọc</a>
</form>
<section class="banner-panel" aria-labelledby="category-results"><header class="banner-panel__toolbar"><h2 id="category-results">Danh sách danh mục</h2><span>{{ filtering ? objects|length ~ ' kết quả phù hợp' : total ~ ' danh mục · ' ~ objects|length ~ ' danh mục gốc' }}</span></header>
<p class="category-guide">{{ filtering ? 'Chỉ hiển thị danh mục khớp bộ lọc; thông tin danh mục cha giúp xác định vị trí trong cây.' : 'Danh mục con nằm ngay dưới danh mục cha và thụt vào theo cấp. Bấm số bài viết để xem bài thuộc danh mục.' }}</p>
<div class="category-table-wrap" role="region" aria-label="Danh sách danh mục phân cấp" tabindex="0"><table class="category-table"><colgroup><col style="width:92px"><col><col style="width:15%"><col style="width:11%"><col style="width:13%"><col style="width:17%"></colgroup><thead><tr><th scope="col">Ảnh</th><th scope="col">Tên / Phân cấp</th><th scope="col">Trạng thái</th><th scope="col">Bài viết</th><th scope="col">Cập nhật</th><th scope="col">Thao tác</th></tr></thead><tbody>
{% for category in objects %}{{ include('admin/newscategory/_tree_row.html.twig',{category:category,level:levels[category.id]|default(0),render_children:not filtering,news_counts:news_counts,seen:[]},with_context=false) }}{% else %}<tr><td colspan="6" class="category-empty">{{ filtering ? 'Không có danh mục phù hợp. Thử từ khóa khác hoặc xóa bộ lọc.' : 'Chưa có danh mục nào. Bấm “Thêm danh mục” để tạo danh mục đầu tiên.' }}</td></tr>{% endfor %}
</tbody></table></div>
</section>
<dialog id="category-confirm" aria-labelledby="category-confirm-title" aria-describedby="category-confirm-message category-confirm-warning"><h2 id="category-confirm-title">Xóa danh mục?</h2><p id="category-confirm-message"></p><p id="category-confirm-warning"></p><div class="category-actions"><button class="banner-button" type="button" id="category-cancel" autofocus>Hủy</button><button class="banner-button banner-button--danger" type="button" id="category-delete">Xóa danh mục</button></div></dialog>
</section>
{% endblock %}
