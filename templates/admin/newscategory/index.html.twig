{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_category_index' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-3">
                    <div class="card add">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <a href="{{ path('admin_newscategory_new') }}">
                                    <div class="stat-icon dib">
                                        <i class="ti-plus text-success border-success"></i>
                                    </div>
                                    <div class="stat-content dib">
                                        <div class="stat-text text-success">{{ 'menu.add_new'|trans }}</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'title.categories'|trans }}</strong>
                        </div>
                        <div class="card-body">
                            <table id="bootstrap-data-table" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th style="width: 80px; text-align: center;">Hình ảnh</th>
                                        <th>{{ 'label.name'|trans }}</th>
                                        <th>{{ 'label.parentcat'|trans }}</th>
                                        <th>{{ 'label.url'|trans }}</th>
                                        <th>{{ 'label.published_at'|trans }}</th>
                                        <th>{{ 'Updated' }}</th>
                                        <th>{{ 'label.actions'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for category in objects %}
                                        {{ include('admin/newscategory/_tree_row.html.twig', {'category': category, 'level': 0}, with_context = false) }}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- .animated -->
    </div>
{% endblock %}
