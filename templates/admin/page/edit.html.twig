{% extends 'admin/layout.html.twig' %}

{% block admin_editor_stylesheets %}
    <link rel="stylesheet" href="{{ asset('build/css/ckeditor5.css') }}">
{% endblock %}

{% block admin_legacy_editor_javascripts %}
    {{ include('admin/components/_legacy_editor_scripts.html.twig', with_context = false) }}
{% endblock %}

{% block body_id 'admin_news_edit' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'title.edit_news'|trans({'%id%': object.id}) }}</strong>
                            <a class="pull-right" target="_blank" href="{{ path('dynamic_post_page', {'slug': object.url, 'preview' : 'true', 'preview_id' : object.id }) }}">Xem trước</a>
                        </div>
                        <div class="card-body">
                            {{ include('admin/components/seo-checker.html.twig', {form: form}, with_context = false) }}
                            <!-- Credit Card -->
                            <div id="pay-invoice">
                                <div class="card-body">
                                    {{ include('admin/page/_form.html.twig', {
                                        form: form,
                                        button_label: 'action.save'|trans,
                                        include_back_to_home_link: true,
                                    }, with_context = false) }}
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- .card -->
                </div>
                <!--/.col-->
            </div>
        </div>
        <!-- .animated -->
    </div>
    
{% endblock %}
