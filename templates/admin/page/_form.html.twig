{{ form_start(form, {attr: attr|default({})}) }}
{% if not form.vars.valid %}<div class="page-editor__errors" role="alert"><strong>Chưa thể lưu trang.</strong> Kiểm tra các trường được đánh dấu bên dưới.{{ form_errors(form) }}</div>{% endif %}
<section class="page-editor__section" id="page-general" aria-labelledby="page-general-heading">
<h2 id="page-general-heading">Thông tin chung</h2>
<p class="page-editor__hint">Đặt tên trang và chọn vị trí trong cây nội dung. Để trống trang cha nếu đây là trang gốc.</p>
{{ form_row(form.title) }}
{{ form_row(form.parent) }}
{{ form_row(form.url) }}
<p class="page-editor__hint">Bấm vào ô URL để chỉnh sửa. Đổi URL của trang đã xuất bản có thể ảnh hưởng các liên kết hiện có.</p>
{{ form_row(form.description) }}
</section>
<section class="page-editor__section" id="page-image" aria-labelledby="page-image-heading">
<h2 id="page-image-heading">Ảnh đại diện</h2>

{% set _img_url = form.images.vars.value|default('') %}
<div class="page-editor__media" data-media-picker-block data-picker-id="pagePicker" data-upload-path="/uploads/media/">
    <div class="page-editor__preview">
        <img id="pagePicker_preview_img" {% if _img_url %}src="{{ _img_url }}"{% endif %} alt="Ảnh đại diện đang chọn" style="display:{{ _img_url ? 'block' : 'none' }};">
        <div id="pagePicker_placeholder" style="display:{{ _img_url ? 'none' : 'flex' }};">Chưa có ảnh</div>
        <button type="button" id="pagePicker_clear_btn" data-media-picker-clear data-picker-id="pagePicker" aria-label="Bỏ chọn ảnh đại diện" title="Bỏ chọn ảnh đại diện" style="display:{{ _img_url ? 'block' : 'none' }};">&times;</button>
    </div>
    <div class="page-editor__media-controls">
        <label for="pagePicker_display">Ảnh từ thư viện media</label>
        <input type="text" id="pagePicker_display" class="form-control" readonly value="{{ _img_url }}" placeholder="Chưa chọn ảnh từ thư viện">
        <button type="button" class="btn btn-default" data-media-picker-open data-picker-id="pagePicker"><i class="fa fa-image" aria-hidden="true"></i> Chọn / đổi ảnh</button>
        <p class="page-editor__hint">Bỏ chọn chỉ gỡ ảnh khỏi trang, không xóa tệp trong thư viện.</p>
    </div>
</div>
{{ form_widget(form.images, {id: 'pagePicker_url_input', attr: {'data-picker-id': 'pagePicker'}}) }}
{{ form_errors(form.images) }}

<div class="modal fade" id="pagePickerModal" tabindex="-1" role="dialog" data-picker-url="{{ path('admin_media_picker') }}" data-picker-id="pagePicker" aria-labelledby="pagePickerModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" aria-label="Đóng thư viện ảnh" data-media-picker-close data-picker-id="pagePicker">
					<span>&times;</span>
				</button>
				<h4 class="modal-title" id="pagePickerModalLabel">
					<i class="fa fa-image"></i>
					Chọn ảnh từ thư viện</h4>
			</div>
			<div class="modal-body" id="pagePicker_body">
				<div class="text-center text-muted" style="padding:30px;">
					<i class="fa fa-spinner fa-spin fa-2x"></i>
					<p class="mt-2">Đang tải thư viện...</p>
				</div>
			</div>
			<div class="modal-footer">
				<span id="pagePicker_selName" class="text-muted pull-left" style="font-size:13px;line-height:34px;"></span>
				<button type="button" class="btn btn-default" data-media-picker-close data-picker-id="pagePicker">Hủy</button>
				<button type="button" class="btn btn-primary" id="pagePicker_confirm" disabled data-media-picker-confirm data-picker-id="pagePicker">
					<i class="fa fa-check"></i>
					Chọn ảnh này
				</button>
			</div>
		</div>
	</div>
</div>

</section>
<section class="page-editor__section" id="page-content" aria-labelledby="page-content-heading">
<h2 id="page-content-heading">Nội dung trang</h2>
<p class="page-editor__hint">Soạn nội dung bằng trình biên tập hoặc bật Page Builder. Các công cụ chèn Content blocks được giữ nguyên.</p>
<div class="page-builder-admin" data-page-builder>
	<div class="page-builder-admin__toggle">
		{{ form_row(form.pageBuilderEnabled) }}
		{{ form_widget(form.pageBuilderData) }}
	</div>

	<div class="page-builder-admin__workspace" data-page-builder-workspace>
		<div class="page-builder-admin__header">
			<div>
				<h4>Page Builder</h4>
				<p>Tạo nội dung theo block và vẫn giữ HTML fallback cho hệ thống cũ.</p>
			</div>
			<button type="button" class="btn btn-outline-primary btn-sm" data-page-builder-add>
				<i class="fa fa-plus" aria-hidden="true"></i>
				Thêm block
			</button>
		</div>

		<div class="page-builder-admin__empty alert alert-light" data-page-builder-empty>
			Chưa có block nào. Bấm "Thêm block" để bắt đầu.
		</div>

		<div class="page-builder-admin__list" data-page-builder-list></div>
	</div>
</div>

<div class="page-builder-legacy-field" data-page-builder-legacy>
	<div class="cms-block-editor-layout">
		{{ include('admin/content_block/_toolbar.html.twig', {
                target_editor: form.contents.vars.id,
                current_id: form.vars.value.id|default(0),
            }, with_context = false) }}
		<div class="cms-block-editor-layout__field">
			{{ form_row(form.contents) }}
		</div>
	</div>
</div>

</section>
<section class="page-editor__section" id="page-seo" aria-labelledby="page-seo-heading">
<h2 id="page-seo-heading">SEO &amp; kết quả tìm kiếm</h2>
{{ include('admin/components/seo-checker.html.twig', {form: form}, with_context = false) }}
{{ form_row(form.pageTitle) }}
{{ form_row(form.pageDescription) }}
{{ form_row(form.pageKeyword) }}
{{ form_row(form.breadcrumbTitle) }}
<div class="page-editor__checks">
{{ form_row(form.metaIndex) }}
{{ form_row(form.metaFollow) }}
</div>
<p class="page-editor__hint">Index cho phép lập chỉ mục trang; Follow cho phép theo các liên kết trên trang.</p>
</section>
<section class="page-editor__section" id="page-publishing" aria-labelledby="page-publishing-heading">
<h2 id="page-publishing-heading">Xuất bản &amp; giao diện</h2>
<div class="page-editor__grid">
{{ form_row(form.status) }}
{{ form_row(form.scheduledAt) }}
{{ form_row(form.template) }}
{% if form.postType is defined %}{{ form_row(form.postType) }}{% endif %}
</div>
<p class="page-editor__hint">Nút lưu áp dụng trạng thái đã chọn. Nếu chọn “Đặt lịch”, hãy nhập ngày giờ xuất bản.</p>
</section>
<section class="page-editor__section" id="page-advanced" aria-labelledby="page-advanced-heading">
<h2 id="page-advanced-heading">Thiết lập nâng cao &amp; ghi chú</h2>
{% if form.schemaMarkup is defined %}{{ form_row(form.schemaMarkup) }}{% endif %}
{{ form_row(form.note) }}
</section>
<footer class="page-editor__savebar">
<span class="page-editor__hint">Kiểm tra nội dung và trạng thái trước khi lưu.</span>
<div class="page-editor__save-actions">

{% if form.save is defined %}
	{{ form_widget(form.save, {label: button_label|default('Lưu thay đổi'), translation_domain: false, attr: {class: 'btn btn-primary'}}) }}
{% endif %}

{% if form.saveAndCreateNew is defined %}
	{{ form_widget(form.saveAndCreateNew, {label: 'Lưu và thêm trang mới', translation_domain: false, attr: {class: 'btn btn-default'}}) }}
{% endif %}

{% if include_back_to_home_link|default(false) %}
	<a href="{{ path('admin_page_index') }}" class="btn btn-link">
		<i class="fa fa-list-alt" aria-hidden="true"></i>
		{{ 'action.back_to_list'|trans }}
	</a>
{% endif %}
</div>
</footer>
{{ form_rest(form) }}
{{ form_end(form) }}
