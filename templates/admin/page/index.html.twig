{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_page_index' %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        #admin_page_index .page-search-form .input-group {
            align-items: stretch;
        }

        #admin_page_index .page-search-form .btn {
            min-width: 110px;
        }
    </style>
{% endblock %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-3">
                    <div class="card add">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <a href="{{ path('admin_page_new') }}">
                                    <div class="stat-icon dib">
                                        <i class="ti-plus text-success border-success"></i>
                                    </div>
                                    <div class="stat-content dib">
                                        <div class="stat-text text-success">{{ 'menu.add_new'|trans }}</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'title.page_list'|trans }}</strong>
                        </div>
                        <div class="card-body">
                            <form method="get" class="form-inline mb-3 page-search-form">
                                <div class="input-group w-100">
                                    <input
                                        type="text"
                                        name="q"
                                        value="{{ search_query|default('') }}"
                                        class="form-control"
                                        placeholder="Tìm theo tiêu đề, URL, mô tả, nội dung, SEO title, SEO description, keyword..."
                                    >
                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                                        {% if search_query is not empty %}
                                            <a href="{{ path('admin_page_index') }}" class="btn btn-secondary">Xóa lọc</a>
                                        {% endif %}
                                    </div>
                                </div>
                            </form>
                            <table id="bootstrap-data-table" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>{{ 'label.images'|trans }}</th>
                                        <th>{{ 'label.title'|trans }}</th>
                                        <th>{{ 'label.status'|trans }}</th>
                                        <th>{{ 'label.published_at'|trans }}</th>
                                        <th>{{ 'Updated' }}</th>
                                        <th>{{ 'label.actions'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for page in pages %}
                                        {{ include('admin/page/_tree_row.html.twig', {
                                            'page': page,
                                            'level': page_levels[page.id]|default(0),
                                            'render_children': search_query is empty
                                        }, with_context = false) }}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- .animated -->
    </div>
{% endblock %}
