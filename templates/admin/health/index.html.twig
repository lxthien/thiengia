{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_health_index' %}

{% block main %}
    <div class="content mt-3 health-dashboard">
        <div class="animated fadeIn">
            <div class="row health-summary">
                <div class="col-sm-6 col-lg">
                    <div class="card dashboard-mini-card">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib"><i class="ti-unlink text-danger border-danger"></i></div>
                                <div class="stat-content dib">
                                    <div class="stat-text">Link lỗi 404</div>
                                    <div class="stat-digit">{{ report.summary.brokenLinks }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg">
                    <div class="card dashboard-mini-card">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib"><i class="ti-image text-warning border-warning"></i></div>
                                <div class="stat-content dib">
                                    <div class="stat-text">Ảnh mất</div>
                                    <div class="stat-digit">{{ report.summary.missingImages }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg">
                    <div class="card dashboard-mini-card">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib"><i class="ti-layout-media-center-alt text-primary border-primary"></i></div>
                                <div class="stat-content dib">
                                    <div class="stat-text">Bài thiếu ảnh</div>
                                    <div class="stat-digit">{{ report.summary.postsWithoutImage }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg">
                    <div class="card dashboard-mini-card">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib"><i class="ti-calendar text-warning border-warning" style="color: #ff9800; border-color: #ff9800;"></i></div>
                                <div class="stat-content dib">
                                    <div class="stat-text">Bài chứa năm cũ</div>
                                    <div class="stat-digit">{{ report.summary.outdatedPosts }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg">
                    <div class="card dashboard-mini-card">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <div class="stat-icon dib"><i class="ti-harddrives text-success border-success"></i></div>
                                <div class="stat-content dib">
                                    <div class="stat-text">Dung lượng upload</div>
                                    <div class="stat-digit">{{ report.summary.uploadSize }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Health dashboard</strong>
                            <span class="text-muted pull-right">Cập nhật: {{ report.generatedAt|date('d/m/Y H:i:s') }}</span>
                        </div>
                        <div class="card-body">
                            <div class="health-note-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 15px; margin-bottom: 15px;">
                                <div class="alert alert-info" style="margin-bottom: 0;">
                                    <strong>Schema:</strong> {{ report.skipped.schema }}
                                </div>
                                <div class="alert alert-info" style="margin-bottom: 0;">
                                    <strong>Mail form:</strong> {{ report.skipped.mail }}
                                </div>
                                <div class="alert alert-info" style="margin-bottom: 0;">
                                    <strong>Lưu ý:</strong> Các danh sách lỗi được giới hạn tối đa 200 dòng mỗi loại để tránh audit quá nặng trên production.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-7">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Link nội bộ lỗi 404</strong>
                            <span class="badge badge-danger">{{ report.summary.brokenLinks }}</span>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered admin-list-table health-table">
                                    <thead>
                                        <tr>
                                            <th>Bài viết/Page</th>
                                            <th>Link</th>
                                            <th>Lý do</th>
                                            <th class="text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for item in report.brokenLinks %}
                                            <tr>
                                                <td>
                                                    {{ item.post.title }}
                                                    <small class="d-block text-muted">{{ item.post.url }}.html</small>
                                                </td>
                                                <td><code>{{ item.path }}</code></td>
                                                <td>{{ item.reason }}</td>
                                                <td class="text-center">
                                                    <a href="{{ item.post.isPage ? path('admin_page_edit', {id: item.post.id}) : path('admin_news_edit', {id: item.post.id}) }}" class="btn-sm" title="Sửa">
                                                        <i class="fa fa-edit"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="4" class="text-center text-muted">Chưa phát hiện link nội bộ lỗi.</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Dung lượng upload</strong>
                            <span class="badge badge-success">{{ report.uploadUsage.totalHuman }}</span>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered admin-list-table health-table">
                                    <thead>
                                        <tr>
                                            <th>Khu vực</th>
                                            <th>Path</th>
                                            <th class="text-right">Dung lượng</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for item in report.uploadUsage.items %}
                                            <tr>
                                                <td>{{ item.label }}</td>
                                                <td><code>{{ item.path }}</code></td>
                                                <td class="text-right">{{ item.human }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-7">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Ảnh bị mất file</strong>
                            <span class="badge badge-warning">{{ report.summary.missingImages }}</span>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered admin-list-table health-table">
                                    <thead>
                                        <tr>
                                            <th>Nguồn</th>
                                            <th>Tiêu đề</th>
                                            <th>File</th>
                                            <th class="text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for item in report.missingImages %}
                                            <tr>
                                                <td>{{ item.source }}</td>
                                                <td>{{ item.title }}</td>
                                                <td><code>{{ item.path }}</code></td>
                                                <td class="text-center">
                                                    {% if item.editUrl is defined and item.editUrl %}
                                                        <a href="{{ item.editUrl }}" class="btn-sm" title="Sửa">
                                                            <i class="fa fa-edit"></i>
                                                        </a>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="4" class="text-center text-muted">Chưa phát hiện ảnh bị mất file.</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Bài/Page thiếu ảnh đại diện</strong>
                            <span class="badge badge-primary">{{ report.summary.postsWithoutImage }}</span>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered admin-list-table health-table">
                                    <thead>
                                        <tr>
                                            <th>Tiêu đề</th>
                                            <th>Loại</th>
                                            <th class="text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for post in report.postsWithoutImage %}
                                            <tr>
                                                <td>
                                                    {{ post.title }}
                                                    <small class="d-block text-muted">{{ post.url }}.html</small>
                                                </td>
                                                <td>{{ post.isPage ? 'Page' : 'Post' }}</td>
                                                <td class="text-center">
                                                    <a href="{{ post.isPage ? path('admin_page_edit', {id: post.id}) : path('admin_news_edit', {id: post.id}) }}" class="btn-sm" title="Sửa">
                                                        <i class="fa fa-edit"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="3" class="text-center text-muted">Tất cả bài published đã có ảnh đại diện.</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Bài viết & Trang chứa thông tin năm cũ (Cần cập nhật)</strong>
                            <span class="badge badge-warning">{{ report.summary.outdatedPosts }}</span>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered admin-list-table health-table">
                                    <thead>
                                        <tr>
                                            <th>Bài viết/Page</th>
                                            <th>Thông tin phát hiện</th>
                                            <th class="text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for item in report.outdatedPosts %}
                                            <tr>
                                                <td>
                                                    {{ item.post.title }}
                                                    <small class="d-block text-muted">{{ item.post.url }}.html</small>
                                                </td>
                                                <td><span class="text-danger">{{ item.reason }}</span></td>
                                                <td class="text-center">
                                                    <a href="{{ item.editUrl }}" class="btn-sm" title="Sửa">
                                                        <i class="fa fa-edit"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="3" class="text-center text-muted">Không phát hiện bài viết nào chứa thông tin năm cũ cần cập nhật.</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
