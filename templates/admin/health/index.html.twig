{% extends 'admin/layout.html.twig' %}
{% block title %}Sức khỏe website{% endblock %}
{% block body_id 'admin_health_index' %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/health-index.css') }}">{% endblock %}
{% block main %}
<section class="banner-manager health-manager">
 <header class="banner-manager__header"><div><h1>Sức khỏe website</h1><p>Theo dõi vấn đề nội dung và mở đúng bài viết hoặc trang để xử lý.</p></div><a class="banner-button" href="{{ path('admin_health_index') }}">Tải lại báo cáo</a></header>
 {% if report is null %}
 <div class="banner-panel health-empty"><h2>Chưa có báo cáo</h2><p>Chạy lệnh dưới đây trên máy chủ để tạo báo cáo đầu tiên.</p><code>php bin/console app:compute-health-report</code></div>
 {% else %}
 <p class="health-updated">Báo cáo lúc <time datetime="{{ report.generatedAt|date('c') }}">{{ report.generatedAt|date('d/m/Y H:i') }}</time>. Tải lại trang chỉ đọc báo cáo đã lưu, không chạy quét mới.</p>
 {% if report.auditVersion|default(0) < 2 %}<p class="health-notice">Báo cáo cũ đã được lọc bỏ liên kết ngoài. Chạy lại tác vụ kiểm tra để cập nhật đầy đủ danh sách và số lượng.</p>{% endif %}
 <nav class="health-summary" aria-label="Đi tới nhóm vấn đề">
 {% for id,label in {'brokenLinks':'Link nội bộ cần kiểm tra','missingImages':'Ảnh mất file','postsWithoutImage':'Thiếu ảnh đại diện','outdatedPosts':'Nội dung có năm cũ'} %}
 <a href="#health-{{ id }}"><span>{{ label }}</span><strong>{{ attribute(report.summary,id)|default(0) }}{{ attribute(report.summary,id)|default(0) >= 200 ? '+' : '' }}</strong><small>Xem danh sách</small></a>
 {% endfor %}
 <a href="#health-storage"><span>Dung lượng đã quét</span><strong>{{ report.summary.uploadSize }}</strong><small>Xem theo thư mục</small></a>
 </nav>
 <details class="banner-panel health-guide"><summary>Phạm vi kiểm tra và cách cập nhật báo cáo</summary>
 <p>Chỉ kiểm tra đường dẫn tương đối và URL HTTP/HTTPS cùng hostname. Bỏ qua external link, mailto, tel, liên kết neo và các giao thức khác. Đây là kiểm tra route/nội dung/file nội bộ, không phải phép đo mã HTTP trực tiếp.</p>
 <p>Mỗi nhóm hiển thị tối đa 200 mục. “Năm cũ” là gợi ý rà soát, không mặc định nội dung sai.</p>
 <p>Cập nhật báo cáo bằng tác vụ định kỳ: <code>php bin/console app:compute-health-report</code>. Khi chạy CLI, cấu hình <code>framework.router.default_uri</code> theo URL chính của website để nhận diện chính xác link nội bộ dạng URL đầy đủ.</p>
 <p><strong>Schema:</strong> {{ report.skipped.schema|default('Chưa có thông tin.') }}</p><p><strong>Mail:</strong> {{ report.skipped.mail|default('Chưa kiểm tra.') }}</p>
 </details>
 {% for key,label in {'brokenLinks':'Link nội bộ lỗi 404 — cần kiểm tra','missingImages':'Ảnh mất file','postsWithoutImage':'Bài viết / Trang thiếu ảnh đại diện','outdatedPosts':'Nội dung có thông tin năm cũ'} %}
 {% set items = attribute(report,key)|default([]) %}
 <section class="banner-panel health-section" id="health-{{ key }}" aria-labelledby="health-title-{{ key }}">
 <header class="banner-panel__toolbar"><h2 id="health-title-{{ key }}">{{ label }}</h2><span>{{ items|length }} mục{{ items|length >= 200 ? ' (đã đạt giới hạn)' : '' }}</span></header>
 {% if key == 'brokenLinks' %}<p class="health-hint">Không bao gồm external link. Mở nội dung nguồn để sửa đường dẫn hoặc bỏ liên kết không còn sử dụng.</p>{% endif %}
 {% if items|length %}
 <div class="health-table-wrap" tabindex="0" role="region" aria-label="{{ label }}"><table>
 <thead><tr><th scope="col">Nội dung nguồn</th><th scope="col">{{ key == 'postsWithoutImage' ? 'Loại nội dung' : 'Chi tiết phát hiện' }}</th><th scope="col">Thao tác</th></tr></thead>
 <tbody>{% for item in items %}
 {% set post = key == 'postsWithoutImage' ? item : (item.post|default(null)) %}
 {% set editUrl = key == 'missingImages' ? item.editUrl|default('') : (post.isPage ? path('admin_page_edit',{id:post.id}) : path('admin_news_edit',{id:post.id})) %}
 <tr><td><strong>{{ post ? post.title : item.title }}</strong><small>{{ post ? (post.isPage ? 'Trang' : 'Bài viết') : item.source }}</small></td>
 <td>{% if key == 'brokenLinks' %}<code>{{ item.path }}</code><small>{{ item.reason }}</small>
 {% elseif key == 'missingImages' %}<code>{{ item.path }}</code>
 {% elseif key == 'postsWithoutImage' %}{{ post.isPage ? 'Trang' : 'Bài viết' }}
 {% else %}{{ item.reason }}{% endif %}</td>
 <td>{% if editUrl %}<a class="banner-button" href="{{ editUrl }}" aria-label="Sửa {{ post ? post.title : item.title }}">Sửa nội dung</a>{% else %}<span>Không có trang sửa</span>{% endif %}</td></tr>
 {% endfor %}</tbody></table></div>
 {% else %}<p class="health-empty">Không phát hiện mục nào trong báo cáo này.</p>{% endif %}
 </section>
 {% endfor %}
 <section class="banner-panel health-section" id="health-storage" aria-labelledby="health-storage-title"><header class="banner-panel__toolbar"><h2 id="health-storage-title">Dung lượng theo thư mục</h2><strong>{{ report.uploadUsage.totalHuman }}</strong></header>
 <div class="health-table-wrap" tabindex="0" role="region" aria-label="Dung lượng thư mục"><table><thead><tr><th scope="col">Khu vực</th><th scope="col">Đường dẫn</th><th scope="col">Dung lượng</th></tr></thead><tbody>
 {% for item in report.uploadUsage.items %}<tr><td>{{ item.label }}</td><td><code>{{ item.path }}</code></td><td>{{ item.human }}</td></tr>{% endfor %}
 </tbody></table></div></section>
 {% endif %}
</section>
{% endblock %}
