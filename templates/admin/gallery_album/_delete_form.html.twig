<button type="button" class="banner-button banner-button--delete"
        data-gallery-delete="{{ path('admin_gallery_album_delete', {id: object.id}) }}"
        data-token="{{ csrf_token('delete') }}" data-name="{{ object.name }}" data-count="{{ object.images|length }}"
        aria-label="Xóa album {{ object.name }}"><i class="fa fa-trash-o" aria-hidden="true"></i> Xóa</button>
