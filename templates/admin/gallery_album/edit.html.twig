{% extends 'admin/layout.html.twig' %}
{% block title %}Quản lý ảnh · {{ object.name }}{% endblock %}
{% block body_id 'admin_gallery_album_edit' %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/gallery-album-editor.css') }}">{% endblock %}
{% block main %}
<main class="banner-manager album-editor" data-album-editor data-token="{{ csrf_token('gallery_images_' ~ object.id) }}" data-add-url="{{ path('admin_gallery_album_image_add', {id: object.id}) }}" aria-labelledby="album-heading">
    <header class="banner-manager__header"><div><p class="album-breadcrumb">Album hình ảnh hoạt động</p><h1 id="album-heading">{{ object.name }}</h1><p>Quản lý ảnh, chú thích và ảnh đại diện tại một nơi.</p></div>
        <div class="album-header-actions"><a class="banner-button" href="{{ path('admin_gallery_album_index') }}">Danh sách album</a><button type="button" class="banner-button banner-button--primary" data-open-media><i class="fa fa-plus" aria-hidden="true"></i> Thêm ảnh</button></div>
    </header>
    <div class="banner-notice" data-album-notice role="status" aria-live="polite" hidden></div>
    <div class="album-editor-layout">
        <details class="banner-panel album-information" open>
            <summary>Thông tin album</summary><div class="banner-editor-content">{{ include('admin/gallery_album/_info_form.html.twig') }}</div>
        </details>
        <section class="banner-panel album-images" aria-labelledby="album-images-heading">
            <div class="banner-panel__toolbar"><div><h2 id="album-images-heading">Ảnh trong album</h2><p><strong data-image-count>{{ object.images|length }} ảnh</strong><span class="banner-summary" data-alt-count></span></p></div></div>
            <div class="banner-reorder-note"><p>Ảnh đầu tiên là ảnh đại diện. Kéo tay nắm hoặc dùng nút lên / xuống.</p><p class="banner-save-status" data-order-status role="status" aria-live="polite"></p></div>
            <div class="dd banner-board" id="album-image-nestable" data-reorder-url="{{ path('admin_gallery_album_images_reorder', {id: object.id}) }}">
                <ol class="dd-list" id="album-image-list">{% for image in object.images %}{{ include('admin/gallery_album/_image_row.html.twig', {image: image}, with_context = false) }}{% endfor %}</ol>
            </div>
            <div class="banner-empty" data-image-empty {% if object.images|length %}hidden{% endif %}><i class="fa fa-picture-o" aria-hidden="true"></i><h2>Album chưa có ảnh</h2><p>Chọn ảnh từ thư viện. File ảnh gốc được giữ nguyên.</p><button type="button" class="banner-button banner-button--primary" data-open-media>Thêm ảnh đầu tiên</button></div>
        </section>
    </div>
</main>
<dialog class="banner-media-dialog" id="album-media-dialog" aria-labelledby="album-media-title" data-picker-url="{{ path('admin_media_picker', {_format: 'json'}) }}">
    <div class="banner-dialog__header"><h2 id="album-media-title">Thêm ảnh từ thư viện</h2><button class="banner-dialog__close" type="button" data-close-media aria-label="Đóng thư viện">&times;</button></div>
    <div class="banner-dialog__body">
        <div class="banner-media-tools"><label>Thư mục<select data-media-folder><option value="">Tất cả thư mục</option></select></label><label>Tìm trong danh sách<input type="search" data-media-search placeholder="Tên ảnh..."></label></div>
        <p class="album-help">Hiển thị tối đa 48 ảnh mới nhất của thư mục. Chọn ảnh rồi bấm “Thêm vào album”.</p>
        <div class="banner-media-tools"><a class="banner-button" href="{{ path('admin_media_index') }}" target="_blank" rel="noopener">Tải ảnh mới (tab mới)</a><button class="banner-button" type="button" data-media-refresh>Làm mới</button></div>
        <p data-media-status role="status" aria-live="polite" class="album-help"></p>
        <p data-media-error class="banner-panel-error" role="alert" hidden></p>
        <div class="banner-media-grid" data-media-grid></div>
    </div>
    <div class="banner-dialog__footer"><span data-selected-name class="album-help">Chưa chọn ảnh</span><button type="button" class="banner-button" data-close-media>Hủy</button><button type="button" class="banner-button banner-button--primary" data-media-add disabled>Thêm vào album</button></div>
</dialog>
<dialog class="banner-delete-dialog" id="album-delete-dialog" aria-labelledby="album-delete-title">
    <div class="banner-dialog__header"><h2 id="album-delete-title">Gỡ ảnh khỏi album?</h2><button type="button" class="banner-dialog__close" data-delete-close aria-label="Đóng">&times;</button></div>
    <div class="banner-dialog__body"><p data-delete-description>Ảnh sẽ bị gỡ khỏi album cùng chú thích và alt. File ảnh gốc trong thư viện vẫn được giữ lại.</p><p data-confirm-error role="alert" hidden></p></div>
    <div class="banner-dialog__footer"><button type="button" class="banner-button" data-delete-close autofocus>Hủy</button><button type="button" class="banner-button banner-button--danger" data-delete-confirm>Gỡ ảnh</button></div>
</dialog>
<dialog class="banner-media-dialog album-lightbox" id="album-preview-dialog" aria-labelledby="album-preview-title">
    <div class="banner-dialog__header"><h2 id="album-preview-title">Xem ảnh</h2><button type="button" class="banner-dialog__close" data-preview-close aria-label="Đóng ảnh">&times;</button></div>
    <div class="banner-dialog__body"><img data-large-image alt="Ảnh trong album"><p data-preview-error hidden>Không tải được ảnh gốc.</p></div>
</dialog>
{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('build/js/menu-editor.js') }}"></script><script src="{{ asset('build/js/gallery-album-editor.js') }}"></script>{% endblock %}
