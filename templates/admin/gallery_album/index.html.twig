{% extends 'admin/layout.html.twig' %}
{% block title %}Quản lý album{% endblock %}
{% block body_id 'admin_gallery_album_index' %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('build/css/gallery-album-index.css') }}">
{% endblock %}
{% block main %}
    {{ include('admin/gallery_album/_manager.html.twig') }}
    <dialog class="banner-editor-dialog" id="gallery-editor-dialog" aria-labelledby="gallery-editor-title">
        <div class="banner-dialog__header"><h2 id="gallery-editor-title">Thông tin album</h2><button type="button" class="banner-dialog__close" data-gallery-panel-close aria-label="Đóng">&times;</button></div>
        <p class="banner-panel-error" data-gallery-panel-error role="alert" hidden></p>
        <div class="banner-editor-content" data-gallery-panel-content></div>
    </dialog>
    <dialog class="banner-delete-dialog" id="gallery-confirm-dialog" aria-labelledby="gallery-confirm-title" aria-describedby="gallery-confirm-description">
        <div class="banner-dialog__header"><h2 id="gallery-confirm-title">Xóa album?</h2><button type="button" class="banner-dialog__close" data-gallery-confirm-close aria-label="Đóng">&times;</button></div>
        <div class="banner-dialog__body"><p id="gallery-confirm-description"></p><p data-confirm-error role="alert" hidden></p></div>
        <div class="banner-dialog__footer"><button type="button" class="banner-button" data-gallery-confirm-close autofocus>Hủy</button><button type="button" class="banner-button banner-button--danger" data-gallery-confirm-submit>Xóa album</button></div>
    </dialog>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('build/js/menu-editor.js') }}"></script>
    <script src="{{ asset('build/js/gallery-album-index.js') }}"></script>
{% endblock %}
