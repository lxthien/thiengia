{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_user_change_password' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-6 offset-md-3">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'Đổi mật khẩu' }}: {{ user.getUsername() }}</strong>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle"></i> Hãy nhập mật khẩu mới cho người dùng này.
                            </div>

                            {{ form_start(form) }}
                                <div class="form-group">
                                    {{ form_label(form.plainPassword) }}
                                    {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.plainPassword) }}
                                    <small class="form-text text-muted">{{ 'Mật khẩu tối thiểu 6 ký tự' }}</small>
                                </div>

                                <div class="form-group">
                                    {{ form_label(form.confirmPassword) }}
                                    {{ form_widget(form.confirmPassword, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.confirmPassword) }}
                                </div>

                                <div class="form-group">
                                    {{ form_widget(form.save, {'attr': {'class': 'btn btn-success'}}) }}
                                    <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">{{ 'Huỷ' }}</a>
                                </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
