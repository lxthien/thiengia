{% extends 'admin/layout.html.twig' %}
{% block title %}Quản lý người dùng{% endblock %}
{% block body_id 'admin_user_index' %}
{% block flash_messages %}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/user-manager.css') }}">{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('build/js/user-manager.js') }}" defer></script>{% endblock %}
{% block main %}
<section class="banner-manager contact-manager user-manager">
<header class="banner-manager__header"><div><h1>Quản lý người dùng</h1><p>Quản lý hồ sơ, quyền truy cập và trạng thái tài khoản.</p></div><a class="banner-button banner-button--primary" href="{{ path('admin_user_new') }}">Thêm người dùng</a></header>
{{ include('admin/redirect/_messages.html.twig') }}
<form class="banner-panel contact-filters" method="get" action="{{ path('admin_user_index') }}">
<label>Tìm người dùng<input type="search" name="q" value="{{ filters.q }}" placeholder="Tên đăng nhập, tên hiển thị hoặc email…"></label>
<label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="active" {{ filters.status == 'active' ? 'selected' : '' }}>Đang hoạt động</option><option value="locked" {{ filters.status == 'locked' ? 'selected' : '' }}>Đã khóa</option></select></label>
<button type="submit" class="banner-button banner-button--primary">Tìm kiếm</button><a class="banner-button" href="{{ path('admin_user_index') }}">Xóa bộ lọc</a></form>
<section class="banner-panel" aria-labelledby="user-results"><header class="banner-panel__toolbar"><h2 id="user-results">Danh sách tài khoản</h2><span>{{ pagination.totalItemCount }} kết quả · Trang {{ pagination.currentPageNumber }}</span></header>
{% for row in pagination %}
{% set self = row.id == app.user.id %}
{% set manage = is_granted('USER_MANAGE',row) %}
<article class="contact-row user-row">
<div><h3>{{ row.username }}{% if self %} <small>(Bạn)</small>{% endif %}</h3><p>{{ row.name }}</p><p class="user-email">{{ row.email }}</p><p class="contact-muted">#{{ row.id }} · Tạo {{ row.createdAt|date('d/m/Y H:i','Asia/Ho_Chi_Minh') }}</p></div>
<div><span class="contact-status {{ row.enabled ? 'is-unread' : 'is-read' }}">{{ row.enabled ? 'Đang hoạt động' : 'Đã khóa' }}</span>
<div class="user-roles" aria-label="Vai trò được gán">{% for role in row.roles %}<span>{{ {'ROLE_SUPER_ADMIN':'Super Admin','ROLE_ADMIN':'Admin','ROLE_EDITOR':'Biên tập viên','ROLE_AUTHOR':'Tác giả','ROLE_USER':'Người dùng'}[role]|default(role) }}</span>{% endfor %}</div>
{% if manage %}<div class="contact-actions"><a class="banner-button" href="{{ path('admin_user_edit',{id:row.id}) }}">Sửa hồ sơ</a><a class="banner-button" href="{{ path('admin_user_change_password',{id:row.id}) }}">Đổi mật khẩu</a>
{% if not self %}
<form method="post" action="{{ path('admin_user_toggle_status',{id:row.id}) }}" data-user-confirm="{{ row.enabled ? 'Khóa' : 'Mở khóa' }} tài khoản {{ row.username }}?"><input type="hidden" name="token" value="{{ csrf_token('toggle-status') }}"><button class="banner-button" type="submit">{{ row.enabled ? 'Khóa' : 'Mở khóa' }}</button></form>
<form method="post" action="{{ path('admin_user_delete',{id:row.id}) }}" data-user-confirm="Xóa tài khoản {{ row.username }}? Thao tác không thể hoàn tác."><input type="hidden" name="token" value="{{ csrf_token('delete') }}"><button class="banner-button banner-button--delete" type="submit">Xóa</button></form>
{% endif %}</div>{% else %}<p class="contact-muted">Bạn không có quyền quản lý tài khoản này.</p>{% endif %}
</div></article>
{% else %}<div class="contact-empty"><h3>Không có người dùng phù hợp</h3><p>Thử từ khóa khác hoặc xóa bộ lọc.</p></div>{% endfor %}
{% if pagination.pageCount > 1 %}<nav class="contact-pagination" aria-label="Phân trang người dùng">{{ knp_pagination_render(pagination,'@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}</nav>{% endif %}
</section><p class="contact-help">Không thể xóa hoặc khóa tài khoản đang đăng nhập. Vai trò hiển thị là các quyền được gán, không phải danh sách toàn bộ quyền kế thừa.</p>
<dialog id="user-confirm" aria-labelledby="user-confirm-title"><h2 id="user-confirm-title">Xác nhận thao tác</h2><p id="user-confirm-message"></p><div class="contact-actions"><button class="banner-button" type="button" id="user-cancel" autofocus>Hủy</button><button class="banner-button banner-button--danger" type="button" id="user-proceed">Xác nhận</button></div></dialog>
</section>
{% endblock %}
