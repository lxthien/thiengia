{% extends 'admin/layout.html.twig' %}
{% block title %}Dịch vụ{% endblock %}
{% block body_id 'admin_service_index' %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/catalog-index.css') }}">{% endblock %}

{% block main %}
    {% embed 'admin/components/_reorder_manager.html.twig' with {
        objects: objects,
        heading: 'Dịch vụ',
        intro: 'Khối "Dịch vụ" trên trang chủ và ô "Nhu cầu" trong form báo giá đều đọc từ danh sách này.',
        unit: 'dịch vụ',
        reorder_path: path('admin_service_reorder'),
        reorder_token_id: 'reorder_services',
        edit_path_name: 'admin_service_edit',
        visibility_path_name: 'admin_service_visibility',
        visibility_token_prefix: 'service_visibility_',
        can_toggle: true,
        new_path: path('admin_service_new'),
        new_label: 'Thêm dịch vụ',
        empty_title: 'Chưa có dịch vụ nào',
        empty_text: 'Thêm dịch vụ đầu tiên, hoặc chạy php bin/console app:homepage:import-content để nhập sẵn nội dung của theme.',
    } %}
        {% block row %}
            <a href="{{ path('admin_service_edit', {id: row.id}) }}" class="banner-preview catalog-thumb dd-nodrag" aria-label="Sửa dịch vụ {{ row.name }}">
                {% if row.image %}
                    <img src="{{ asset(row.image) }}" alt="{{ row.name }}" loading="lazy">
                {% else %}
                    <span class="banner-preview__fallback"><i class="fa fa-image" aria-hidden="true"></i> Chưa có ảnh</span>
                {% endif %}
            </a>

            <div class="banner-details dd-nodrag">
                <div class="banner-details__title">
                    <h3><a href="{{ path('admin_service_edit', {id: row.id}) }}">{{ row.name }}</a></h3>
                    <span class="banner-badge {{ row.enable ? 'banner-badge--visible' : 'banner-badge--hidden' }}">
                        {{ row.enable ? 'Đang hiển thị' : 'Đã ẩn' }}
                    </span>
                </div>
                {% if row.priceFrom %}<p class="catalog-price">{{ row.priceFrom }}</p>{% endif %}
                <p class="catalog-desc">{{ row.description }}</p>
                <p class="banner-meta"><span>ID #{{ row.id }}</span><span>Cập nhật {{ row.updatedAt|date('d/m/Y H:i', 'Asia/Ho_Chi_Minh') }}</span></p>
            </div>
        {% endblock %}

        {% block row_actions %}
            <a class="banner-button" href="{{ path('admin_service_edit', {id: row.id}) }}">
                <i class="fa fa-pencil" aria-hidden="true"></i> Chỉnh sửa
            </a>
            <button type="button" class="banner-button" role="switch"
                    aria-checked="{{ row.enable ? 'true' : 'false' }}"
                    aria-label="Hiển thị dịch vụ {{ row.name }}"
                    data-manager-visibility="{{ path('admin_service_visibility', {id: row.id}) }}"
                    data-token="{{ csrf_token('service_visibility_' ~ row.id) }}"
                    data-enable="{{ row.enable ? '0' : '1' }}">{{ row.enable ? 'Ẩn' : 'Hiện' }}</button>
            {% if is_granted('ROLE_ADMIN') %}
                <form method="post" action="{{ path('admin_service_delete', {id: row.id}) }}"
                      onsubmit="return confirm('Xóa dịch vụ {{ row.name|e('js') }}?');">
                    <input type="hidden" name="token" value="{{ csrf_token('delete_service_' ~ row.id) }}">
                    <button type="submit" class="banner-button banner-button--danger">
                        <i class="fa fa-trash" aria-hidden="true"></i> Xóa
                    </button>
                </form>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block javascripts %}{{ parent() }}<script src="{{ asset('build/js/menu-editor.js') }}"></script><script src="{{ asset('build/js/reorder-manager.js') }}"></script>{% endblock %}
