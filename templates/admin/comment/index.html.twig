{% extends 'admin/layout.html.twig' %}
{% block title %}Quản lý bình luận{% endblock %}
{% block body_id 'admin_comment_index' %}
{% block flash_messages %}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/comment-index.css') }}">{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('build/js/comment-index.js') }}" defer></script>{% endblock %}
{% block main %}
{% set returnQuery = {q: filters.q, status: filters.status, page: pagination.currentPageNumber} %}
<section class="banner-manager comment-manager">
    <header class="banner-manager__header"><div><h1>Quản lý bình luận</h1><p>Kiểm duyệt và phản hồi bình luận trên bài viết, trang nội dung.</p></div></header>
    {{ include('admin/comment/_messages.html.twig') }}
    <nav class="comment-tabs" aria-label="Lọc trạng thái bình luận">
        {% for value, label in {'':'Tất cả', 'pending':'Chờ duyệt', 'approved':'Đã duyệt'} %}
        <a href="{{ path('admin_comment_index', {status: value, q: filters.q}) }}" {{ filters.status == value ? 'aria-current="page"' : '' }}>{{ label }} <strong>{{ attribute(counts, value == '' ? 'all' : value) }}</strong></a>
        {% endfor %}
    </nav>
    <p class="comment-muted">Số lượng trạng thái tính trên toàn bộ bình luận, bao gồm các trả lời.</p>
    <form class="banner-panel comment-filters" method="get" action="{{ path('admin_comment_index') }}">
        <label>Tìm bình luận<input type="search" name="q" value="{{ filters.q }}" placeholder="Người gửi, email, điện thoại, IP, nội dung hoặc tiêu đề bài…"></label>
        <label>Trạng thái<select name="status"><option value="">Tất cả trạng thái</option><option value="pending" {{ filters.status == 'pending' ? 'selected' : '' }}>Chờ duyệt</option><option value="approved" {{ filters.status == 'approved' ? 'selected' : '' }}>Đã duyệt</option></select></label>
        <button class="banner-button banner-button--primary" type="submit">Tìm kiếm</button>
        <a class="banner-button" href="{{ path('admin_comment_index') }}">Xóa bộ lọc</a>
    </form>
    <section class="banner-panel" aria-labelledby="comment-results">
        <header class="banner-panel__toolbar"><h2 id="comment-results">Danh sách bình luận</h2><span>{{ pagination.totalItemCount }} kết quả · Trang {{ pagination.currentPageNumber }}</span></header>
        {% if pagination|length %}
        <form id="comment-bulk" class="comment-bulk" method="post" action="{{ path('admin_comment_bulk', returnQuery) }}">
            <input type="hidden" name="token" value="{{ csrf_token('bulk_comment') }}">
            <label class="comment-check"><input type="checkbox" id="comment-select-all"> Chọn cả trang</label>
            <span id="comment-selection" role="status" aria-live="polite">Đã chọn 0 bình luận</span>
            <label class="comment-bulk-action">Thao tác hàng loạt<select name="bulk_action" required><option value="">Chọn thao tác</option><option value="approve">Duyệt bình luận</option><option value="unapprove">Chuyển về chờ duyệt</option><option value="delete">Xóa bình luận</option></select></label>
            <button class="banner-button" id="comment-apply" type="submit" disabled>Áp dụng</button>
        </form>
        {% endif %}
        {% for row in pagination %}
        <article class="comment-row{{ row.parent ? ' comment-row--reply' : '' }}" id="comment-{{ row.id }}">
            <div class="comment-author">
                <label class="comment-check"><input type="checkbox" name="ids[]" value="{{ row.id }}" form="comment-bulk" data-comment-check aria-label="Chọn bình luận #{{ row.id }} của {{ row.author }}"><strong>{{ row.author }}</strong></label>
                <span class="comment-status {{ row.approved ? 'is-approved' : 'is-pending' }}">{{ row.approved ? 'Đã duyệt' : 'Chờ duyệt' }}</span>
                <p class="comment-muted">#{{ row.id }} · {{ row.createdAt|date('d/m/Y H:i', 'Asia/Ho_Chi_Minh') }}</p>
                <details class="comment-contact"><summary>Thông tin liên hệ</summary>
                    {% if row.email %}<p>Email: <a href="mailto:{{ row.email }}">{{ row.email }}</a></p>{% endif %}
                    {% if row.phone %}<p>Điện thoại: {{ row.phone }}</p>{% endif %}
                    <p>IP: {{ row.ip ?: 'Không có' }}</p>
                </details>
            </div>
            <div class="comment-content">
                {% if row.news %}<p class="comment-post">{{ row.news.isPage ? 'Trang' : 'Bài viết' }}: <a href="{{ path(row.news.isPage ? 'admin_page_edit' : 'admin_news_edit', {id: row.news.id}) }}">{{ row.news.title }}</a></p>{% endif %}
                {% if row.parent %}<p class="comment-parent">Trả lời <a href="{{ path('admin_comment_edit', {id: row.parent.id}) }}">#{{ row.parent.id }} · {{ row.parent.author }}</a></p>{% endif %}
                {% set content = row.content|striptags %}
                {% if content|length > 320 %}
                    <p class="comment-excerpt">{{ content|slice(0,320) }}…</p><details class="comment-full"><summary>Đọc toàn bộ bình luận</summary><p>{{ content }}</p></details>
                {% else %}<p class="comment-excerpt">{{ content }}</p>{% endif %}
                <div class="comment-actions">
                    <form method="post" action="{{ path(row.approved ? 'admin_comment_unapprove' : 'admin_comment_approve', returnQuery|merge({id: row.id})) }}">
                        <input type="hidden" name="token" value="{{ csrf_token('comment_status_' ~ row.id) }}">
                        <button type="submit" class="banner-button {{ not row.approved ? 'banner-button--primary' : '' }}">{{ row.approved ? 'Bỏ duyệt' : 'Duyệt' }}</button>
                    </form>
                    <a class="banner-button" href="{{ path('admin_comment_reply', returnQuery|merge({id: row.id})) }}">Trả lời</a>
                    <a class="banner-button" href="{{ path('admin_comment_edit', returnQuery|merge({id: row.id})) }}">Sửa</a>
                    <form method="post" action="{{ path('admin_comment_delete', returnQuery|merge({id: row.id})) }}" data-comment-delete data-comment-author="{{ row.author }}">
                        <input type="hidden" name="token" value="{{ csrf_token('delete') }}">
                        <button type="submit" class="banner-button banner-button--delete">Xóa</button>
                    </form>
                </div>
            </div>
        </article>
        {% else %}
            <div class="comment-empty"><h3>{{ filters.q or filters.status ? 'Không có bình luận phù hợp' : 'Chưa có bình luận' }}</h3><p>{{ filters.q or filters.status ? 'Thử từ khóa khác hoặc xóa bộ lọc để xem toàn bộ bình luận.' : 'Bình luận của khách hàng sẽ xuất hiện tại đây để bạn kiểm duyệt.' }}</p>{% if filters.q or filters.status %}<a class="banner-button" href="{{ path('admin_comment_index') }}">Xóa bộ lọc</a>{% endif %}</div>
        {% endfor %}
        {% if pagination.pageCount > 1 %}<nav class="comment-pagination" aria-label="Phân trang bình luận">{{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}</nav>{% endif %}
    </section>
    <dialog id="comment-confirm" aria-labelledby="comment-confirm-title" aria-describedby="comment-confirm-message comment-confirm-warning">
        <h2 id="comment-confirm-title">Xóa bình luận?</h2>
        <p id="comment-confirm-message"></p>
        <p id="comment-confirm-warning">Các trả lời thuộc bình luận bị xóa cũng sẽ bị xóa. Thao tác này không thể hoàn tác.</p>
        <div class="comment-actions"><button type="button" class="banner-button" id="comment-cancel" autofocus>Hủy</button><button type="button" class="banner-button banner-button--danger" id="comment-confirm-delete">Xóa bình luận</button></div>
    </dialog>
</section>
{% endblock %}
