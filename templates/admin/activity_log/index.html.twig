{% extends 'admin/layout.html.twig' %}
{% block title %}Nhật ký hoạt động{% endblock %}
{% block body_id 'admin_activity_log_index' %}
{% block flash_messages %}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/activity-log.css') }}">{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('build/js/activity-log.js') }}" defer></script>{% endblock %}
{% block main %}
{% set query = {user:filters.userId,action:filters.action,entity_type:filters.entityType,date_from:filters.dateFrom,date_to:filters.dateTo,q:filters.search,per_page:perPage} %}
<section class="audit-manager">
<header class="audit-header"><h1>Nhật ký hoạt động</h1><p>Lịch sử thao tác quản trị · Mới nhất trước · Giờ Việt Nam (UTC+7)</p></header>
{% if filterError %}<p class="audit-warning" role="alert">{{ filterError }}</p>{% endif %}
<form class="audit-filters" method="get" action="{{ path('admin_activity_log_index') }}">
<label class="audit-search">Tìm kiếm<input type="search" name="q" value="{{ filters.search }}" placeholder="Tên đối tượng hoặc chi tiết…"></label>
<label>Người dùng<select name="user"><option value="">Tất cả</option>{% for user in users %}<option value="{{ user.id }}" {{ filters.userId == user.id ? 'selected' : '' }}>{{ user.username }}</option>{% endfor %}</select></label>
<label>Hành động<select name="action"><option value="">Tất cả</option>{% for value,label in {'create':'Tạo mới','update':'Cập nhật','delete':'Xóa','toggle':'Đổi trạng thái','settings':'Cài đặt','login':'Đăng nhập','login_failed':'Đăng nhập thất bại'} %}<option value="{{ value }}" {{ filters.action == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
<label>Đối tượng<select name="entity_type"><option value="">Tất cả</option>{% for value,label in {'news':'Bài viết','page':'Trang','user':'Người dùng','category':'Danh mục','comment':'Bình luận','banner':'Banner','banner_category':'Nhóm banner','gallery_album':'Album','menu':'Menu','menu_item':'Mục menu','tag':'Tag','settings':'Cài đặt','testimonial':'Đánh giá','newsletter':'Bản tin','homepage_section':'Khối trang chủ','service':'Dịch vụ','project':'Công trình','Redirect':'Chuyển hướng'} %}<option value="{{ value }}" {{ filters.entityType == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
<label>Từ ngày<input type="date" name="date_from" value="{{ filters.dateFrom }}"></label>
<label>Đến ngày<input type="date" name="date_to" value="{{ filters.dateTo }}"></label>
<label>Số dòng<select name="per_page">{% for size in [30,50,100] %}<option value="{{ size }}" {{ perPage == size ? 'selected' : '' }}>{{ size }} / trang</option>{% endfor %}</select></label>
<div class="audit-filter-actions"><button type="submit">Lọc</button><a href="{{ path('admin_activity_log_index') }}">Xóa lọc</a></div>
</form>
<div class="audit-results"><strong>{{ total }} bản ghi</strong><span>Trang {{ currentPage }} / {{ max(1,pages) }} · {{ logs|length }} dòng đang hiển thị</span></div>
<div class="audit-table-wrap" tabindex="0" role="region" aria-label="Bảng nhật ký, cuộn ngang trên màn hình nhỏ">
<table class="audit-table"><caption class="sr-only">Nhật ký hoạt động theo bộ lọc</caption>
<colgroup><col style="width:15%"><col style="width:13%"><col style="width:16%"><col style="width:13%"><col style="width:24%"><col style="width:11%"><col style="width:8%"></colgroup>
<thead><tr><th scope="col">Thời gian</th><th scope="col">Người dùng</th><th scope="col">Hành động</th><th scope="col">Đối tượng</th><th scope="col">Tên / Nội dung</th><th scope="col">IP</th><th scope="col"><span class="sr-only">Chi tiết</span></th></tr></thead>
<tbody>{% for log in logs %}
<tr class="audit-row">
<td><time datetime="{{ log.createdAt|date('c') }}">{{ log.createdAt|date('d/m/Y H:i:s','Asia/Ho_Chi_Minh') }}</time></td>
<td><span class="audit-truncate" title="{{ log.username ?: 'Hệ thống / không xác định' }}">{{ log.username ?: 'Hệ thống / không xác định' }}</span></td>
<td><span class="audit-action {{ log.action in ['delete','login_failed'] ? 'audit-action--danger' : '' }}">{{ log.actionLabel }}</span></td>
<td><span class="audit-truncate">{{ log.entityTypeLabel }}{% if log.entityId %} #{{ log.entityId }}{% endif %}</span></td>
<td><span class="audit-truncate" title="{{ log.entityTitle }}">{{ log.entityTitle ?: 'Không có tên đối tượng' }}</span></td>
<td><span class="audit-truncate" title="{{ log.ipAddress }}">{{ log.ipAddress ?: '—' }}</span></td>
<td><button type="button" class="audit-detail-button" aria-expanded="false" aria-controls="audit-detail-{{ log.id }}" aria-label="Xem chi tiết nhật ký #{{ log.id }}" data-audit-detail>Chi tiết</button></td>
</tr>
<tr id="audit-detail-{{ log.id }}" class="audit-detail" hidden><td colspan="7">
<dl><div><dt>Bản ghi</dt><dd>#{{ log.id }} · {{ log.entityTypeLabel }}{% if log.entityId %} #{{ log.entityId }}{% endif %}</dd></div><div><dt>Người dùng</dt><dd>{{ log.username ?: 'Hệ thống / không xác định' }}</dd></div><div><dt>Tên đối tượng</dt><dd>{{ log.entityTitle ?: 'Không có' }}</dd></div><div><dt>IP</dt><dd>{{ log.ipAddress ?: 'Không có' }}</dd></div><div><dt>Trình duyệt / User-Agent</dt><dd>{{ log.userAgent ?: 'Không có thông tin' }}</dd></div></dl>
<pre>{{ log.details ?: 'Không có chi tiết bổ sung.' }}</pre>
</td></tr>
{% else %}<tr><td colspan="7" class="audit-empty">Không có nhật ký phù hợp. Thử điều chỉnh bộ lọc.</td></tr>{% endfor %}</tbody></table>
</div>
{% if pages > 1 %}<nav class="audit-pagination" aria-label="Phân trang nhật ký">
{% if currentPage > 1 %}<a href="{{ path('admin_activity_log_index',query|merge({page:1})) }}" aria-label="Trang đầu">«</a><a href="{{ path('admin_activity_log_index',query|merge({page:currentPage-1})) }}">Trước</a>{% endif %}
{% for p in max(1,currentPage-2)..min(pages,currentPage+2) %}{% if p == currentPage %}<span aria-current="page">{{ p }}</span>{% else %}<a href="{{ path('admin_activity_log_index',query|merge({page:p})) }}">{{ p }}</a>{% endif %}{% endfor %}
{% if currentPage < pages %}<a href="{{ path('admin_activity_log_index',query|merge({page:currentPage+1})) }}">Sau</a><a href="{{ path('admin_activity_log_index',query|merge({page:pages})) }}" aria-label="Trang cuối">»</a>{% endif %}
</nav>{% endif %}
</section>
{% endblock %}
