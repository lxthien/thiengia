{% extends 'admin/layout.html.twig' %}
{% block title %}Sửa khối: {{ object.name }}{% endblock %}
{% block body_id 'admin_homepage_section_edit' %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/homepage-section-edit.css') }}">{% endblock %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-lg-9">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Khối: {{ object.name }}</strong>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">{{ object.type.hint }}</p>
                            {{ form_errors(form) }}
                            {{ form_start(form) }}
                                {% if form.label is defined %}{{ form_row(form.label) }}{% endif %}
                                {% if form.title is defined %}{{ form_row(form.title) }}{% endif %}
                                {% if form.subtitle is defined %}{{ form_row(form.subtitle) }}{% endif %}

                                {% if form.image is defined %}
                                    {{ include('admin/components/_image_picker.html.twig', {field: form.image, picker_id: 'sectionPicker'}) }}
                                {% endif %}
                                {% if form.imageAlt is defined %}{{ form_row(form.imageAlt) }}{% endif %}

                                {% if form.points is defined %}
                                    {{ include('admin/homepage_section/_collection.html.twig', {field: form.points, add_label: 'Thêm gạch đầu dòng'}) }}
                                {% endif %}
                                {% if form.items is defined %}
                                    {{ include('admin/homepage_section/_collection.html.twig', {field: form.items, add_label: 'Thêm dòng'}) }}
                                {% endif %}
                                {% if form.checks is defined %}
                                    {{ include('admin/homepage_section/_collection.html.twig', {field: form.checks, add_label: 'Thêm gạch đầu dòng'}) }}
                                {% endif %}

                                {% if form.limit is defined %}{{ form_row(form.limit) }}{% endif %}
                                {% if form.categories is defined %}{{ form_row(form.categories) }}{% endif %}
                                {{ form_row(form.enable) }}

                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save" aria-hidden="true"></i> {{ 'action.save'|trans }}
                                </button>
                                <a href="{{ path('admin_homepage_section_index') }}" class="btn btn-link">
                                    <i class="fa fa-list-alt" aria-hidden="true"></i> {{ 'action.back_to_list'|trans }}
                                </a>
                                {{ form_widget(form._token) }}
                            {{ form_end(form, {render_rest: false}) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}{{ parent() }}<script src="{{ asset('build/js/homepage-section-edit.js') }}"></script>{% endblock %}
