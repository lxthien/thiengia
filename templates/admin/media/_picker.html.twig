<div class="media-picker-wrap">
 <details class="media-picker-upload"><summary>Tải ảnh mới lên thư viện</summary>
  <label id="mediaPickerDropzone">Chọn ảnh hoặc kéo thả vào đây
   <input type="file" id="mediaPickerFileInput" multiple accept=".jpg,.jpeg,.png,.gif">
  </label><p class="media-picker-help">JPG, PNG, GIF · Tối đa 10 MB/ảnh. Chọn tệp rồi bấm Tải ảnh đã chọn.</p>
  <div class="media-picker-filters">
   <label>Thư mục tải lên<select id="mediaPickerUploadFolderSelect" class="form-control"><option value="">Thư mục gốc</option>{% for folder in folders %}<option value="{{ folder }}" {{ currentFolder == folder ? 'selected' : '' }}>{{ folder }}</option>{% endfor %}</select></label>
   <label>Hoặc tạo thư mục mới<input id="mediaPickerUploadNewFolder" class="form-control" placeholder="Ví dụ: du-an"></label>
  </div>
  <button type="button" id="mediaPickerUploadBtn" class="btn btn-primary" disabled>Tải ảnh đã chọn</button>
  <span id="mediaPickerQueueCount" role="status" aria-live="polite"></span><div id="mediaPickerUploadQueue"></div>
 </details>
 <div class="media-picker-filters">
  <label>Thư mục<select id="mediaPickerFilterFolderSelect" class="form-control"><option value="">Tất cả thư mục</option>{% for folder in folders %}<option value="{{ folder }}" {{ currentFolder == folder ? 'selected' : '' }}>{{ folder }}</option>{% endfor %}</select></label>
  <label>Lọc ảnh đang hiển thị<input type="search" id="mediaPickerSearch" class="form-control" placeholder="Tên ảnh…" autocomplete="off"></label>
 </div>
 <p class="media-picker-help">Tối đa 48 ảnh mới nhất trong thư mục. Bấm ảnh để chọn, sau đó xác nhận ở cuối cửa sổ.</p>
 <div class="media-picker-grid" id="mediaPickerGrid">
 {% for file in files %}
  <button type="button" class="media-picker-item" data-url="{{ file.url }}" data-filename="{{ file.filename }}" aria-pressed="false" title="{{ file.filename }}">
   <img src="{{ file.thumb }}" alt="" loading="lazy"><span class="media-picker-item__name">{{ file.filename }}</span><span class="media-picker-item__size">{{ file.size_formatted }}</span>
  </button>
 {% endfor %}
 </div>
 <p data-picker-empty class="media-picker-help" {{ files|length ? 'hidden' : '' }}>Không có ảnh phù hợp. Thử thư mục khác hoặc tải ảnh mới.</p>
</div>
