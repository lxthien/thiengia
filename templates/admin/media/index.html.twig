{% extends 'admin/layout.html.twig' %}
{% block title %}Thư viện media{% endblock %}
{% block body_id 'admin_media_index' %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/media-index.css') }}">{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('build/js/media-index.js') }}" defer></script>{% endblock %}
{% block main %}
<section class="banner-manager media-manager" data-media-manager data-token="{{ csrf_token('delete-media') }}" data-upload="{{ path('admin_media_upload') }}">
 <header class="banner-manager__header"><div><h1>Thư viện media</h1><p>Quản lý hình ảnh, sao chép liên kết và chỉnh sửa thông tin trong cùng một nơi.</p></div><button class="banner-button banner-button--primary" data-open-upload>Tải ảnh lên</button></header>
 <p class="media-summary">{{ totalFiles }} ảnh{% if currentFolder %} trong thư mục {{ currentFolder }}{% endif %} · Toàn thư viện đang dùng {{ storageInfo.used_formatted }}</p>
 <p data-status class="media-status" role="status" aria-live="polite"></p>
 <form method="get" class="banner-panel banner-filters">
  <label>Thư mục<select name="folder"><option value="">Tất cả thư mục</option>{% for folder in folders %}<option value="{{ folder }}" {{ currentFolder == folder ? 'selected' : '' }}>{{ folder }}</option>{% endfor %}</select></label>
  <label class="banner-filter-search">Tìm ảnh<input type="search" name="q" value="{{ search }}" placeholder="Tên tệp hoặc đường dẫn…"></label>
  <button class="banner-button banner-button--primary">Tìm kiếm</button><a class="banner-filter-reset" href="{{ path('admin_media_index') }}">Xóa bộ lọc</a>
 </form>
 <div class="media-grid">
 {% for file in files %}
  <article class="media-card" data-file="{{ file|json_encode|e('html_attr') }}" data-alt-url="{{ path('admin_media_alt',{filename:file.filename}) }}" data-delete-url="{{ path('admin_media_delete',{filename:file.filename}) }}" data-resize-url="{{ path('admin_media_resize',{filename:file.filename}) }}" data-crop-url="{{ path('admin_media_crop',{filename:file.filename}) }}" data-move-url="{{ path('admin_media_move',{filename:file.filename}) }}">
   <button class="media-preview" data-preview aria-label="Xem ảnh {{ file.filename }}"><img src="{{ file.thumb }}" data-original="{{ file.url }}" alt="{{ file.alt }}" loading="lazy" width="300" height="180"><span>{{ file.width > 0 and file.height > 0 ? file.width ~ ' × ' ~ file.height : 'Xem kích thước ảnh gốc' }}</span></button>
   <div class="media-card__body"><h2 title="{{ file.filename }}">{{ file.filename }}</h2><p>{{ file.ext|upper }} · {{ file.size_formatted }}<br>{{ file.date }}</p><p class="media-alt">{{ file.alt ? 'Đã có mô tả ALT' : 'Chưa có mô tả ALT' }}</p>
    <div class="media-actions"><button class="banner-button" data-copy>Sao chép URL</button>{% if is_granted('ROLE_EDITOR') %}<button class="banner-button" data-edit>Sửa</button><button class="banner-button banner-button--delete" data-delete>Xóa</button>{% endif %}</div>
   </div>
  </article>
 {% else %}<div class="banner-panel media-empty"><h2>{{ search or currentFolder ? 'Không tìm thấy hình ảnh' : 'Thư viện chưa có ảnh' }}</h2><p>{{ search or currentFolder ? 'Thử tên khác hoặc xóa bộ lọc.' : 'Tải hình ảnh đầu tiên để bắt đầu.' }}</p></div>{% endfor %}
 </div>
 {% if totalPages > 1 %}<nav class="media-pagination" aria-label="Phân trang thư viện">
 {% if currentPage > 1 %}<a class="banner-button" href="{{ path('admin_media_index',{page:currentPage-1,folder:currentFolder,q:search}) }}">Trang trước</a>{% endif %}
 <span>Trang {{ currentPage }} / {{ totalPages }}</span>
 {% if currentPage < totalPages %}<a class="banner-button" href="{{ path('admin_media_index',{page:currentPage+1,folder:currentFolder,q:search}) }}">Trang sau</a>{% endif %}
 </nav>{% endif %}
 <dialog class="media-dialog" id="media-details" aria-labelledby="media-title">
  <header><h2 id="media-title">Chi tiết hình ảnh</h2><button class="banner-button" data-close aria-label="Đóng chi tiết">Đóng</button></header>
  <div class="media-detail-layout"><div><img data-full-image alt=""><p data-file-info></p><a data-open-original target="_blank" rel="noopener">Mở ảnh gốc (tab mới)</a></div><div>
   <label>Đường dẫn ảnh<input data-url readonly></label><button class="banner-button" data-copy-current>Sao chép URL</button>
   <p data-detail-status class="media-status" role="status" aria-live="polite"></p>
   {% if is_granted('ROLE_EDITOR') %}
   <form data-operation="alt"><h3>Mô tả ảnh (ALT)</h3><label for="media-alt">Nội dung mô tả</label><textarea id="media-alt" name="alt" rows="3" maxlength="255"></textarea><p>Mô tả ngắn nội dung ảnh, không nhồi nhét từ khóa.</p><button class="banner-button banner-button--primary">Lưu mô tả</button></form>
   <details><summary>Thay đổi kích thước</summary><form data-operation="resize"><p>Ghi đè ảnh hiện tại. Nên tải bản gốc về trước khi chỉnh sửa.</p><div class="media-fields"><label>Rộng (px)<input type="number" name="width" min="1" max="10000" required></label><label>Cao (px)<input type="number" name="height" min="1" max="10000" required></label></div><label class="media-check"><input type="checkbox" data-ratio checked> Giữ tỉ lệ ảnh</label><button class="banner-button">Lưu kích thước</button></form></details>
   <details><summary>Cắt ảnh</summary><form data-operation="crop"><p>Tọa độ tính từ góc trên bên trái. Thao tác ghi đè ảnh gốc.</p><div class="media-fields">{% for key,label in {x:'X (px)',y:'Y (px)',width:'Rộng (px)',height:'Cao (px)'} %}<label>{{ label }}<input type="number" name="{{ key }}" min="{{ key in ['x','y'] ? 0 : 1 }}" required></label>{% endfor %}</div><button class="banner-button">Lưu vùng cắt</button></form></details>
   <details><summary>Di chuyển thư mục</summary><form data-operation="move"><p>URL ảnh sẽ thay đổi. Các bài viết đang dùng URL cũ không được tự động cập nhật.</p><label>Thư mục đích<select name="targetFolder"><option value="">Thư mục gốc</option>{% for folder in folders %}<option value="{{ folder }}">{{ folder }}</option>{% endfor %}</select></label><label>Hoặc tạo thư mục mới<input name="newFolder" maxlength="80" placeholder="Ví dụ: du-an"></label><button class="banner-button">Di chuyển ảnh</button></form></details>
   {% endif %}
  </div></div>
 </dialog>
 <dialog class="media-dialog media-confirm" id="media-confirm" aria-labelledby="media-confirm-title" aria-describedby="media-confirm-description"><header><h2 id="media-confirm-title">Xác nhận thao tác</h2></header><p id="media-confirm-description"></p><p data-confirm-error role="alert"></p><footer><button class="banner-button" data-cancel autofocus>Hủy</button><button class="banner-button banner-button--danger" data-confirm>Tiếp tục</button></footer></dialog>
 <dialog class="media-dialog" id="media-upload" aria-labelledby="media-upload-title"><header><h2 id="media-upload-title">Tải ảnh lên</h2><button class="banner-button" data-close>Đóng</button></header>
  <div class="media-upload-body"><p>JPG, JPEG, PNG, GIF · Tối đa 10 MB mỗi ảnh. Ảnh chỉ được tải lên khi bạn xác nhận.</p>
  <label class="media-drop">Chọn ảnh hoặc kéo thả vào đây<input type="file" data-file-input multiple accept=".jpg,.jpeg,.png,.gif"></label>
  <div class="media-fields"><label>Thư mục<select data-upload-folder><option value="">Thư mục gốc</option>{% for folder in folders %}<option value="{{ folder }}" {{ currentFolder == folder ? 'selected' : '' }}>{{ folder }}</option>{% endfor %}</select></label><label>Hoặc thư mục mới<input data-new-folder maxlength="80"></label></div>
  <ul data-queue class="media-queue"></ul><p data-upload-status role="status" aria-live="polite"></p><button class="banner-button banner-button--primary" data-upload-submit disabled>Tải ảnh đã chọn</button><button class="banner-button" data-reload hidden>Cập nhật thư viện</button></div>
 </dialog>
</section>
{% endblock %}
