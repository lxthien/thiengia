{% extends 'admin/layout.html.twig' %}
{% block title %}Tổng quan quản trị{% endblock %}
{% block body_id 'admin_dashboard_index' %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/dashboard-index.css') }}">{% endblock %}
{% block main %}
{% set admin = is_granted('ROLE_ADMIN') %}{% set editor = is_granted('ROLE_EDITOR') %}
{% set periodViews = 0 %}{% for count in viewTrends %}{% set periodViews = periodViews + count %}{% endfor %}
{% set peak = viewTrends|length ? max(1,max(viewTrends)) : 1 %}
<section class="banner-manager dashboard-manager">
 <header class="banner-manager__header"><div><h1>Tổng quan quản trị</h1><p>Theo dõi nội dung, lượt xem và những việc cần xử lý trên website.</p></div><div class="dash-actions"><a class="banner-button" href="{{ path('homepage') }}" target="_blank" rel="noopener">Xem website ↗</a><a class="banner-button banner-button--primary" href="{{ path('admin_news_new') }}">Viết bài mới</a></div></header>
 <nav class="dash-shortcuts" aria-label="Thao tác nhanh"><a href="{{ path('admin_media_index') }}">Thư viện media</a><a href="{{ path('admin_news_index') }}">Quản lý bài viết</a>{% if editor %}<a href="{{ path('admin_page_new') }}">Tạo trang</a><a href="{{ path('admin_banner_index') }}">Quản lý banner</a>{% endif %}{% if admin %}<a href="{{ path('admin_health_index') }}">Sức khỏe website</a><a href="{{ path('admin_settings_global') }}">Cài đặt</a>{% endif %}<a href="{{ path('admin_dashboard_index') }}">Làm mới số liệu</a></nav>
 {% if editor or admin %}
 <section class="dash-priorities" aria-labelledby="dash-priority-title"><div><h2 id="dash-priority-title">Cần xử lý</h2><p>Đi tới danh sách để xem và xử lý từng mục.</p></div><div class="dash-actions">
 {% if admin %}<a class="banner-button" href="{{ path('admin_contact_index') }}"><strong>{{ unreadContacts|number_format(0,',','.') }}</strong> liên hệ chưa đọc</a>{% endif %}
 {% if editor %}<a class="banner-button" href="{{ path('admin_comment_index') }}"><strong>{{ pendingComments|number_format(0,',','.') }}</strong> bình luận chờ duyệt</a>{% endif %}
 </div></section>{% endif %}
 <section class="dash-metrics" aria-label="Số liệu tổng quan">
 <article><span>Tổng nội dung</span><strong>{{ totalPosts|number_format(0,',','.') }}</strong><small>Bài viết và trang · mọi trạng thái</small></article>
 <article><span>Lượt xem tích lũy</span><strong>{{ totalViews|number_format(0,',','.') }}</strong><small>Tổng bộ đếm trên nội dung</small></article>
 <article><span>Lượt xem 30 ngày</span><strong>{{ periodViews|number_format(0,',','.') }}</strong><small>Theo dữ liệu thống kê ngày</small></article>
 <article><span>Bình luận</span><strong>{{ totalComments|number_format(0,',','.') }}</strong><small>{{ approvedComments|number_format(0,',','.') }} đã duyệt · {{ pendingComments|number_format(0,',','.') }} chờ duyệt</small></article>
 </section>
 <section class="banner-panel dash-section" aria-labelledby="dash-trend-title"><header class="banner-panel__toolbar"><div><h2 id="dash-trend-title">Lượt xem theo ngày</h2><p>30 ngày gần nhất · Không đồng nghĩa với số người truy cập duy nhất.</p></div><strong>{{ periodViews|number_format(0,',','.') }} lượt xem</strong></header>
 {% if periodViews > 0 %}
 <div class="dash-chart" aria-hidden="true">{% for day,count in viewTrends %}<div class="dash-chart-column" title="{{ day|date('d/m/Y') }}: {{ count }} lượt xem"><span style="height:{{ (count / peak * 100)|round(2) }}%"></span></div>{% endfor %}</div>
 <div class="dash-chart-axis" aria-hidden="true"><span>{{ viewTrends|keys|first|date('d/m') }}</span><span>{{ viewTrends|keys|last|date('d/m') }}</span></div>
 {% else %}<p class="dash-empty">Chưa ghi nhận lượt xem trong dữ liệu 30 ngày. Kiểm tra tác vụ đồng bộ nếu website đã có truy cập.</p>{% endif %}
 <details class="dash-details"><summary>Xem số liệu từng ngày</summary><div class="dash-scroll" role="region" aria-label="Lượt xem từng ngày" tabindex="0"><table><thead><tr><th scope="col">Ngày</th><th scope="col">Lượt xem</th></tr></thead><tbody>{% for day,count in viewTrends %}<tr><td>{{ day|date('d/m/Y') }}</td><td>{{ count|number_format(0,',','.') }}</td></tr>{% else %}<tr><td colspan="2">Chưa có dữ liệu thống kê.</td></tr>{% endfor %}</tbody></table></div></details>
 </section>
 <div class="dash-columns">
 <section class="banner-panel dash-section" aria-labelledby="dash-recent-title"><header class="banner-panel__toolbar"><div><h2 id="dash-recent-title">Nội dung mới trong 7 ngày</h2><p>Tối đa 10 bài viết và trang.</p></div></header><ul class="dash-list">
 {% for post in recentPosts %}<li><div>{% if post.postType != 'page' or editor %}<a href="{{ path(post.postType == 'page' ? 'admin_page_edit' : 'admin_news_edit',{id:post.id}) }}">{{ post.title }}</a>{% else %}<strong>{{ post.title }}</strong>{% endif %}<small>{{ post.postType == 'page' ? 'Trang' : 'Bài viết' }} · {{ post.createdAt|date('d/m/Y','Asia/Ho_Chi_Minh') }}</small></div><span class="dash-number">{{ post.viewCounts|number_format(0,',','.') }} lượt xem</span></li>{% else %}<li class="dash-empty">Chưa có nội dung mới trong 7 ngày qua.</li>{% endfor %}
 </ul><footer class="dash-panel-footer"><a href="{{ path('admin_news_index') }}">Tất cả bài viết</a>{% if editor %}<a href="{{ path('admin_page_index') }}">Tất cả trang</a>{% endif %}</footer></section>
 <section class="banner-panel dash-section" aria-labelledby="dash-top-title"><header class="banner-panel__toolbar"><div><h2 id="dash-top-title">Nội dung được xem nhiều</h2><p>Top 5 theo lượt xem tích lũy, không riêng 30 ngày.</p></div></header><ol class="dash-list dash-ranked">
 {% for post in topPosts %}<li><span class="dash-rank">{{ loop.index }}</span><div>{% if post.postType != 'page' or editor %}<a href="{{ path(post.postType == 'page' ? 'admin_page_edit' : 'admin_news_edit',{id:post.id}) }}">{{ post.title }}</a>{% else %}<strong>{{ post.title }}</strong>{% endif %}<small>{{ post.postType == 'page' ? 'Trang' : 'Bài viết' }}</small></div><span class="dash-number">{{ post.viewCounts|number_format(0,',','.') }}</span></li>{% else %}<li class="dash-empty">Chưa có nội dung để thống kê.</li>{% endfor %}
 </ol></section>
 {% if admin %}<section class="banner-panel dash-section" aria-labelledby="dash-contact-title"><header class="banner-panel__toolbar"><h2 id="dash-contact-title">Liên hệ mới nhất</h2><a href="{{ path('admin_contact_index') }}">Xem tất cả</a></header><ul class="dash-list">
 {% for contact in recentContacts %}<li><div><strong>{{ contact.name }}</strong><small>{{ contact.createdAt|date('d/m/Y H:i','Asia/Ho_Chi_Minh') }}{% if contact.phone %} · {{ contact.phone }}{% endif %}</small></div><span class="dash-badge {{ not contact.isRead ? 'dash-badge--pending' : '' }}">{{ contact.isRead ? 'Đã đọc' : 'Chưa đọc' }}</span></li>{% else %}<li class="dash-empty">Chưa có liên hệ nào.</li>{% endfor %}</ul></section>{% endif %}
 {% if editor %}<section class="banner-panel dash-section" aria-labelledby="dash-comment-title"><header class="banner-panel__toolbar"><h2 id="dash-comment-title">Bình luận mới nhất</h2><a href="{{ path('admin_comment_index') }}">Quản lý</a></header><ul class="dash-list">
 {% for comment in recentComments %}<li><div><a href="{{ path('admin_comment_edit',{id:comment.id}) }}">{{ comment.author }}</a><small>{{ comment.createdAt|date('d/m/Y H:i','Asia/Ho_Chi_Minh') }}</small></div><span class="dash-badge {{ not comment.approved ? 'dash-badge--pending' : '' }}">{{ comment.approved ? 'Đã duyệt' : 'Chờ duyệt' }}</span></li>{% else %}<li class="dash-empty">Chưa có bình luận nào.</li>{% endfor %}</ul></section>{% endif %}
 </div>
 {% if admin %}
 <section class="banner-panel dash-section" aria-labelledby="dash-log-title"><header class="banner-panel__toolbar"><h2 id="dash-log-title">Hoạt động gần đây</h2><a href="{{ path('admin_activity_log_index') }}">Xem nhật ký</a></header><ul class="dash-list dash-activity">
 {% for log in recentActivities %}<li><time datetime="{{ log.createdAt|date('c') }}">{{ log.createdAt|date('d/m H:i','Asia/Ho_Chi_Minh') }}</time><div><strong>{{ log.username ?: 'Hệ thống' }}</strong> · {{ log.actionLabel }}<small>{{ log.entityTypeLabel }} · {{ log.entityTitle ?: 'Không có tên' }}</small></div></li>{% else %}<li class="dash-empty">Chưa có hoạt động nào.</li>{% endfor %}</ul></section>
 <details class="banner-panel dash-details"><summary>Thông tin hệ thống và tài nguyên</summary><dl class="dash-system">
 {% for label,value in {'PHP':systemInfo.php_version,'Symfony':systemInfo.symfony_version,'Cơ sở dữ liệu':systemInfo.db_driver,'Hệ điều hành':systemInfo.server_os,'Tài khoản':totalUsers,'Banner':totalBanners,'Thẻ nội dung':totalTags} %}<div><dt>{{ label }}</dt><dd>{{ value }}</dd></div>{% endfor %}</dl></details>
 {% endif %}
</section>
{% endblock %}
