{% extends 'admin/layout.html.twig' %}
{% block title %}Quản lý banner{% endblock %}
{% block body_id 'admin_banner_index' %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('build/css/banner-index.css') }}">
{% endblock %}
{% block main %}
    {{ include('admin/banner/_manager.html.twig') }}
    <dialog class="banner-editor-dialog" id="banner-editor-dialog" aria-labelledby="banner-editor-title">
        <div class="banner-dialog__header"><h2 id="banner-editor-title">Chỉnh sửa</h2><button type="button" class="banner-dialog__close" data-banner-panel-close aria-label="Đóng">&times;</button></div>
        <p class="banner-panel-error" data-banner-panel-error role="alert" hidden></p>
        <div class="banner-editor-content" data-banner-panel-content></div>
    </dialog>
    <dialog class="banner-delete-dialog" id="banner-confirm-dialog" aria-labelledby="banner-confirm-title" aria-describedby="banner-confirm-description">
        <div class="banner-dialog__header"><h2 id="banner-confirm-title">Xóa banner?</h2><button type="button" class="banner-dialog__close" data-confirm-close aria-label="Đóng">&times;</button></div>
        <div class="banner-dialog__body"><p id="banner-confirm-description"></p><p data-confirm-error role="alert" hidden></p></div>
        <div class="banner-dialog__footer"><button type="button" class="banner-button" data-confirm-close autofocus>Hủy</button><button type="button" class="banner-button banner-button--danger" data-confirm-submit>Xóa</button></div>
    </dialog>
    <dialog class="banner-media-dialog" id="banner-media-dialog" aria-labelledby="banner-media-title" data-picker-url="{{ path('admin_media_picker', {_format: 'json'}) }}">
        <div class="banner-dialog__header"><h2 id="banner-media-title">Chọn ảnh banner</h2><button type="button" class="banner-dialog__close" data-media-close aria-label="Đóng thư viện">&times;</button></div>
        <div class="banner-dialog__body">
            <div class="banner-media-tools"><label>Thư mục<select data-media-folder><option value="">Tất cả thư mục</option></select></label><label>Tìm trong danh sách<input type="search" data-media-search placeholder="Tên ảnh..."></label></div>
            <p class="banner-media-help">Hiển thị tối đa 48 ảnh mới nhất của thư mục. Chọn thư mục để tìm thêm ảnh.</p>
            <div class="banner-media-tools"><a href="{{ path('admin_media_index') }}" target="_blank" rel="noopener" class="banner-button">Tải ảnh mới (tab mới)</a><button type="button" class="banner-button" data-media-refresh>Làm mới</button></div>
            <p data-media-status role="status" aria-live="polite"></p><div class="banner-media-grid" data-media-grid></div>
        </div>
    </dialog>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('build/js/menu-editor.js') }}"></script>
    <script src="{{ asset('build/js/banner-index.js') }}"></script>
{% endblock %}
