<button type="button" class="banner-button banner-button--delete"
        data-banner-delete-url="{{ path('admin_banner_delete', {id: object.id}) }}"
        data-delete-token="{{ csrf_token('delete') }}" data-delete-name="{{ object.name }}" data-delete-kind="banner"
        aria-label="Xóa banner {{ object.name }}">
    <i class="fa fa-trash-o" aria-hidden="true"></i> Xóa
</button>
