{% extends 'admin/layout.html.twig' %}
{% block title %}Ưu tiên cập nhật nội dung{% endblock %}
{% block body_id 'admin_content_decay_index' %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/content-decay.css') }}">{% endblock %}
{% block main %}
<section class="banner-manager decay-manager">
 <header class="banner-manager__header"><div><h1>Ưu tiên cập nhật nội dung</h1><p>Content Decay · Tìm bài viết cần rà soát và mở trực tiếp để chỉnh sửa.</p></div><a class="banner-button" href="{{ path('admin_news_index') }}">Quản lý bài viết</a></header>
 <p class="decay-notice">Điểm ưu tiên không phải phần trăm traffic sụt giảm. Báo cáo hiện dựa trên thời gian chưa cập nhật, SEO cơ bản, lượt xem tích lũy và thông tin bài viết.</p>
 <p class="decay-meta">{% if reportMeta.total > 0 %}Có {{ reportMeta.total }} bài trong dữ liệu đã lưu. Lần chấm điểm gần nhất: {{ reportMeta.latest|date('d/m/Y H:i','Asia/Ho_Chi_Minh') }}.{% else %}Chưa có dữ liệu chấm điểm.{% endif %} Mở trang hoặc lọc không chạy lại phân tích.</p>
 <div class="decay-summary" aria-label="Tổng hợp toàn bộ kết quả khớp bộ lọc">
 <article><span>Ưu tiên cao</span><strong>{{ summary.highRisk }}</strong><small>Điểm từ 70 trở lên</small></article>
 <article><span>Nên cập nhật</span><strong>{{ summary.needsRefresh }}</strong><small>Điểm từ 40 đến 69</small></article>
 <article><span>Điểm trung bình</span><strong>{{ summary.total ? summary.averageDecayScore ~ '/100' : '—' }}</strong><small>Trong kết quả đã lọc</small></article>
 <article><span>Bài khớp bộ lọc</span><strong>{{ summary.total }}</strong><small>Tính trên tất cả các trang kết quả</small></article>
 </div>
 <details class="banner-panel decay-guide"><summary>Cách đọc điểm và cập nhật báo cáo</summary><p>Điểm ưu tiên càng cao, bài càng cần rà soát: 70–100 ưu tiên cao; 40–69 nên cập nhật; 20–39 theo dõi; 0–19 ít ưu tiên. Điểm SEO cơ bản thì ngược lại: càng cao càng tốt. Đây là quy tắc nội bộ, không phải điểm do Google cung cấp.</p><p>“Ngày chưa cập nhật” được tính đến thời điểm chấm điểm, không phải tuổi bài từ ngày tạo. Lượt xem là tổng tích lũy tại thời điểm đó; chưa có dữ liệu so sánh hai kỳ.</p><p>Tác vụ <code>php bin/console app:compute-content-decay</code> chấm lại các bài viết đã xuất bản. Trang (page) hiện chưa thuộc phạm vi tác vụ. Sau khi sửa bài, cần đợi tác vụ chạy lại để điểm phản ánh thay đổi.</p></details>
 <form class="banner-panel decay-filters" method="get" action="{{ path('admin_content_decay_index') }}">
 <label class="decay-search">Tìm bài viết<input type="search" name="q" value="{{ filters.q }}" placeholder="Tiêu đề, URL hoặc mô tả…"></label>
 <label>Danh mục<select name="category"><option value="">Tất cả danh mục</option>{% for category in categories %}<option value="{{ category.id }}" {{ filters.category == category.id ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}</select></label>
 {% for field,options in {'age':{0:'Không giới hạn',90:'Từ 90 ngày',180:'Từ 180 ngày',365:'Từ 365 ngày'},'seo':{0:'Mọi điểm SEO',60:'SEO ≤ 60',80:'SEO ≤ 80',90:'SEO ≤ 90'},'indexable':{'1':'Chỉ bài cho phép index','0':'Tất cả (kể cả noindex)'},'sort':{'decay_desc':'Điểm ưu tiên cao nhất','updated_asc':'Cập nhật cũ nhất','age_desc':'Lâu chưa cập nhật nhất','views_asc':'Lượt xem thấp nhất','seo_asc':'Điểm SEO thấp nhất'}} %}
 <label>{{ {'age':'Chưa cập nhật','seo':'SEO cơ bản','indexable':'Thiết lập index','sort':'Sắp xếp'}[field] }}<select name="{{ field }}">{% for value,label in options %}<option value="{{ value }}" {{ attribute(filters,field) == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>{% endfor %}
 <div class="decay-filter-actions"><button class="banner-button banner-button--primary">Áp dụng bộ lọc</button><a class="banner-button" href="{{ path('admin_content_decay_index',{age:0,seo:0,indexable:0}) }}">Xem tất cả</a><a href="{{ path('admin_content_decay_index') }}">Bộ lọc mặc định</a></div>
 </form>
 <section class="banner-panel decay-results" aria-labelledby="decay-results-title"><header class="banner-panel__toolbar"><h2 id="decay-results-title">Danh sách cần rà soát</h2><span>{{ pagination.totalItemCount }} kết quả · Trang {{ pagination.currentPageNumber }}</span></header>
 {% for item in pagination %}{% set post = item.post %}
 <article class="decay-row">
 <div class="decay-content"><h3><a href="{{ path(post.isPage ? 'admin_page_edit' : 'admin_news_edit',{id:post.id}) }}">{{ post.title }}</a></h3><p class="decay-path">{{ post.url }}</p><p class="decay-meta">{% for category in post.category %}{{ category.name }}{{ not loop.last ? ' · ' : '' }}{% else %}Chưa có danh mục{% endfor %} · {{ item.isIndexable ? 'Cho phép index' : 'Noindex' }}</p>
 <p class="decay-meta">Chấm điểm: {{ item.generatedAt|date('d/m/Y H:i','Asia/Ho_Chi_Minh') }}{% if post.updatedAt and post.updatedAt > item.generatedAt %} · <strong>Bài đã sửa sau lần chấm điểm — cần chấm lại.</strong>{% endif %}</p></div>
 <dl class="decay-scores"><div><dt>Ưu tiên /100</dt><dd class="decay-score {{ item.decayScore >= 70 ? 'is-high' : (item.decayScore >= 40 ? 'is-medium' : '') }}">{{ item.decayScore }}</dd><dd class="decay-sub">{{ item.decayStatus }}</dd></div><div><dt>SEO /100</dt><dd>{{ item.seo.score }}</dd><dd class="decay-sub">{{ item.seo.status }}</dd></div><div><dt>Lượt xem</dt><dd>{{ item.views|number_format(0,',','.') }}</dd><dd class="decay-sub">{{ item.ageDays }} ngày chưa cập nhật</dd></div></dl>
 <div class="decay-row-actions"><a class="banner-button banner-button--primary" href="{{ path(post.isPage ? 'admin_page_edit' : 'admin_news_edit',{id:post.id}) }}">Sửa bài</a><a class="banner-button" href="{{ path('dynamic_post_page',{slug:post.url}) }}" target="_blank" rel="noopener">Xem bài ↗</a></div>
 <details class="decay-reasons"><summary>Vấn đề & gợi ý ({{ item.reasons|length + item.recommendations|length }})</summary><div><section><h4>Điểm cần kiểm tra</h4><ul>{% for reason in item.reasons %}<li>{{ reason }}</li>{% else %}<li>Không có vấn đề được ghi nhận.</li>{% endfor %}</ul></section><section><h4>Gợi ý cập nhật</h4><ul>{% for recommendation in item.recommendations %}<li>{{ recommendation }}</li>{% else %}<li>Rà soát nội dung theo các điểm cần kiểm tra.</li>{% endfor %}</ul></section></div></details>
 </article>
 {% else %}<div class="decay-empty"><h3>{{ reportMeta.total ? 'Không có bài khớp bộ lọc' : 'Chưa có báo cáo Content Decay' }}</h3><p>{{ reportMeta.total ? 'Thử bỏ giới hạn thời gian, điểm SEO hoặc danh mục để xem thêm bài viết.' : 'Chạy tác vụ app:compute-content-decay trên máy chủ để tạo dữ liệu đầu tiên.' }}</p>{% if reportMeta.total %}<a class="banner-button" href="{{ path('admin_content_decay_index',{age:0,seo:0,indexable:0}) }}">Xem tất cả bài trong báo cáo</a>{% endif %}</div>{% endfor %}
 </section>
 <nav class="decay-pagination" aria-label="Phân trang báo cáo">{{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}</nav>
</section>
{% endblock %}
