{% extends 'admin/layout.html.twig' %}
{% block title %}Quản lý bài viết{% endblock %}
{% block body_id 'admin_news_index' %}
{% block flash_messages %}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('build/css/news-index.css') }}">{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('build/js/news-index.js') }}" defer></script>{% endblock %}
{% block main %}
{% set filtering = filters.q or filters.status or filters.category %}
{% set returnQuery = {q: filters.q, status: filters.status, category: filters.category, page: pagination.currentPageNumber > 1 ? pagination.currentPageNumber : null}|filter(v => v) %}
{% set show_author = is_granted('ROLE_EDITOR') %}
<section class="banner-manager news-manager">
<header class="banner-manager__header"><div><h1>Quản lý bài viết</h1><p>Tìm, lọc theo danh mục và trạng thái xuất bản, cập nhật hàng loạt.</p></div><a class="banner-button banner-button--primary" href="{{ path('admin_news_new') }}">Thêm bài viết</a></header>
{{ include('admin/redirect/_messages.html.twig') }}
<nav class="news-tabs" aria-label="Lọc theo trạng thái xuất bản">
<a href="{{ path('admin_news_index', {q: filters.q, category: filters.category}|filter(v => v)) }}" {{ filters.status == '' ? 'aria-current="page"' : '' }}>Tất cả <strong>{{ total_posts }}</strong></a>
{% for status in statuses %}<a href="{{ path('admin_news_index', {q: filters.q, category: filters.category, status: status.value}|filter(v => v)) }}" {{ filters.status == status.value ? 'aria-current="page"' : '' }}>{{ status.label() }} <strong>{{ status_counts[status.value]|default(0) }}</strong></a>{% endfor %}
</nav>
<p class="news-muted">Số lượng theo trạng thái tính trên toàn bộ bài viết{{ show_author ? '' : ' của bạn' }}, chưa áp dụng từ khóa và danh mục.</p>
<form class="banner-panel news-filters" method="get" action="{{ path('admin_news_index') }}">
<label>Tìm bài viết<input type="search" name="q" value="{{ filters.q }}" placeholder="Tiêu đề, URL, nội dung hoặc thông tin SEO…"></label>
<label>Danh mục<select name="category"><option value="">Tất cả danh mục</option>{% for category in categories %}<option value="{{ category.id }}" {{ filters.category == category.id ? 'selected' : '' }}>{{ category.name }}{{ category.enable ? '' : ' (đang ẩn)' }}</option>{% endfor %}</select></label>
<label>Trạng thái<select name="status"><option value="">Tất cả trạng thái</option>{% for status in statuses %}<option value="{{ status.value }}" {{ filters.status == status.value ? 'selected' : '' }}>{{ status.label() }}</option>{% endfor %}</select></label>
<button class="banner-button banner-button--primary" type="submit">Tìm kiếm</button><a class="banner-button" href="{{ path('admin_news_index') }}">Xóa bộ lọc</a>
</form>
<section class="banner-panel" aria-labelledby="news-results"><header class="banner-panel__toolbar"><h2 id="news-results">Danh sách bài viết</h2><span>{{ pagination.totalItemCount }} {{ filtering ? 'kết quả phù hợp' : 'bài viết' }} · Trang {{ pagination.currentPageNumber }}</span></header>
{% if pagination|length %}
<form id="admin-news-bulk-form" class="news-bulk" method="post" action="{{ path('admin_news_bulk', returnQuery) }}">
<input type="hidden" name="token" value="{{ csrf_token('bulk_news') }}">
<label>Thao tác hàng loạt<select name="bulk_action"><option value="">Chọn thao tác</option><option value="publish">Xuất bản</option><option value="pending_review">Chuyển chờ duyệt</option><option value="draft">Chuyển về bản nháp</option><option value="archive">Lưu trữ</option></select></label>
<button class="banner-button" id="news-bulk-apply" type="submit" disabled>Áp dụng</button><span id="news-selection" role="status" aria-live="polite">Đã chọn 0 bài viết</span>
</form>
{% endif %}
<div class="news-table-wrap" role="region" aria-label="Danh sách bài viết" tabindex="0"><table class="news-table"><colgroup><col style="width:44px"><col style="width:92px"><col><col style="width:15%"><col style="width:12%"><col style="width:15%"></colgroup><thead><tr><th scope="col"><input type="checkbox" id="news-check-all" aria-label="Chọn tất cả bài viết đang hiển thị"></th><th scope="col">Ảnh</th><th scope="col">Tiêu đề / Danh mục</th><th scope="col">Trạng thái</th><th scope="col">Cập nhật</th><th scope="col">Thao tác</th></tr></thead><tbody>
{% for row in pagination %}
<tr class="news-row">
<td><input type="checkbox" name="ids[]" value="{{ row.id }}" form="admin-news-bulk-form" data-news-check aria-label="Chọn bài viết {{ row.title }}"></td>
<td><a class="news-thumbnail" href="{{ path('admin_news_edit',{id:row.id}) }}" aria-label="Sửa bài viết: {{ row.title }}">
{% if row.images %}<img data-news-thumbnail src="{{ row.images|imagine_filter('admin_thumb') }}" alt="" width="72" height="54" loading="lazy"><span data-news-image-fallback hidden>Ảnh không tải được</span>{% else %}<span>Chưa có ảnh</span>{% endif %}
</a></td>
<td><a class="news-title" href="{{ path('admin_news_edit',{id:row.id}) }}">{{ row.title }}</a>
<p class="news-url">{{ row.url }}</p>
<p class="news-meta">{% for category in row.category %}<a class="news-chip{{ filters.category == category.id ? ' is-active' : '' }}" href="{{ path('admin_news_index', {category: category.id}) }}" title="Lọc bài viết thuộc {{ category.name }}">{{ category.name }}</a>{% else %}<span class="news-chip news-chip--empty">Chưa có danh mục</span>{% endfor %}</p>
{% if show_author and row.author %}<p class="news-url">Tác giả: {{ row.author.username }}{% if row.viewCounts %} · {{ row.viewCounts|number_format(0, ',', '.') }} lượt xem{% endif %}</p>{% endif %}
</td>
<td><span class="news-status news-status--{{ row.status.value }}">{{ row.status.label() }}</span>{% if row.isScheduled and row.scheduledAt %}<small>Lịch: {{ row.scheduledAt|date('d/m/Y H:i','Asia/Ho_Chi_Minh') }}</small>{% endif %}<small>Xuất bản: {{ row.publishedAt ? row.publishedAt|date('d/m/Y','Asia/Ho_Chi_Minh') : 'Chưa có' }}</small></td>
<td><time>{{ row.updatedAt|date('d/m/Y H:i','Asia/Ho_Chi_Minh') }}</time></td>
<td><div class="news-actions"><a class="banner-button" href="{{ path('admin_news_edit',{id:row.id}) }}">Sửa</a>
{% if is_granted('NEWS_DELETE', row) %}<form method="post" action="{{ path('admin_news_delete', returnQuery|merge({id:row.id})) }}" data-news-delete data-title="{{ row.title }}"><input type="hidden" name="token" value="{{ csrf_token('delete') }}"><button class="banner-button banner-button--delete" type="submit">Xóa</button></form>{% endif %}
</div></td>
</tr>
{% else %}
<tr><td colspan="6" class="news-empty"><h3>{{ filtering ? 'Không có bài viết phù hợp' : 'Chưa có bài viết' }}</h3><p>{{ filtering ? 'Thử từ khóa khác hoặc xóa bộ lọc để xem toàn bộ bài viết.' : 'Bấm “Thêm bài viết” để tạo bài viết đầu tiên.' }}</p>{% if filtering %}<a class="banner-button" href="{{ path('admin_news_index') }}">Xóa bộ lọc</a>{% endif %}</td></tr>
{% endfor %}
</tbody></table></div>
{% if pagination.pageCount > 1 %}<nav class="news-pagination" aria-label="Phân trang bài viết">{{ knp_pagination_render(pagination,'@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}</nav>{% endif %}
</section>
<dialog id="news-confirm" aria-labelledby="news-confirm-title" aria-describedby="news-confirm-message news-confirm-warning"><h2 id="news-confirm-title">Xóa bài viết?</h2><p id="news-confirm-message"></p><p id="news-confirm-warning">Toàn bộ bình luận của bài cũng bị xóa theo và không thể hoàn tác. Nếu chỉ muốn ẩn bài, hãy chuyển sang “Lưu trữ”.</p><div class="news-actions"><button class="banner-button" type="button" id="news-cancel" autofocus>Hủy</button><button class="banner-button banner-button--danger" type="button" id="news-delete">Xóa bài viết</button></div></dialog>
</section>
{% endblock %}
