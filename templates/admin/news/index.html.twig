{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_news_index' %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        #admin_news_index .news-search-form .input-group {
            align-items: stretch;
        }

        #admin_news_index .news-search-form .btn {
            min-width: 110px;
        }
    </style>
{% endblock %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-3">
                    <div class="card add">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <a href="{{ path('admin_news_new') }}">
                                    <div class="stat-icon dib">
                                        <i class="ti-plus text-success border-success"></i>
                                    </div>
                                    <div class="stat-content dib">
                                        <div class="stat-text text-success">{{ 'menu.add_new'|trans }}</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'title.news_list'|trans }}</strong>
                        </div>
                        <div class="card-body">
                            <form method="get" class="form-inline mb-3 news-search-form">
                                <div class="input-group w-100">
                                    <input
                                        type="text"
                                        name="q"
                                        value="{{ search_query|default('') }}"
                                        class="form-control"
                                        placeholder="Tìm theo tiêu đề, URL, mô tả, nội dung, SEO title, SEO description, keyword..."
                                    >
                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                                        {% if search_query is not empty %}
                                            <a href="{{ path('admin_news_index') }}" class="btn btn-secondary">Xóa lọc</a>
                                        {% endif %}
                                    </div>
                                </div>
                            </form>
                            <form id="admin-news-bulk-form" method="post" action="{{ path('admin_news_bulk') }}" data-bulk-form>
                                <input type="hidden" name="token" value="{{ csrf_token('bulk_news') }}">
                                <div class="admin-bulk-toolbar">
                                    <select name="bulk_action" class="form-control">
                                        <option value="">Chọn thao tác</option>
                                        <option value="publish">Xuất bản đã chọn</option>
                                        <option value="pending_review">Chuyển chờ duyệt</option>
                                        <option value="draft">Chuyển về bản nháp</option>
                                        <option value="archive">Lưu trữ đã chọn</option>
                                    </select>
                                    <button type="submit" class="btn btn-default">Áp dụng</button>
                                </div>
                            </form>

                            <table id="bootstrap-data-table" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th class="admin-list-check"><input type="checkbox" data-bulk-check-all></th>
                                        <th>{{ 'label.images'|trans }}</th>
                                        <th>{{ 'lable.news.title'|trans }}</th>
                                        <th>{{ 'label.category'|trans }}</th>
                                        <th>{{ 'label.status'|trans }}</th>
                                        <th>{{ 'label.published_at'|trans }}</th>
                                        <th>{{ 'Updated' }}</th>
                                        <th>{{ 'label.actions'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in objects %}
                                    <tr>
                                        <td><input type="checkbox" name="ids[]" value="{{ row.id }}" form="admin-news-bulk-form" data-bulk-check></td>
                                        <td>
                                            <div class="images-container">
                                                <img src="{{ (row.getImages() ? row.getImages() : asset('assets/images/no-image.png')) | imagine_filter('admin_thumb') }}" alt="{{ row.getTitle() }}" />
                                            </div>
                                        </td>
                                        <td><a class="btn-link" href="{{ path('admin_news_edit', {id: row.id}) }}">{{ row.getTitle() }}</a></td>
                                        <td>
                                            {% for category in row.getCategory() %}
                                                {{ category.getName() }}{{ loop.last == false ? ', ' : '' }}
                                            {% endfor %}
                                        </td>
                                        <td>
                                            <span class="badge {{ row.getStatus().badgeClass() }}">{{ row.getStatus().label() }}</span>
                                            {% if row.isScheduled() and row.getScheduledAt() %}
                                                <small class="d-block text-muted mt-1">
                                                    <i class="fa fa-clock-o"></i> {{ row.getScheduledAt() | localizeddate('medium', 'short', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY HH:mm') }}
                                                </small>
                                            {% endif %}
                                        </td>
                                        <td>{{ row.getPublishedAt() ? row.getPublishedAt() | localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') : '—' }}</td>
                                        <td>{{ row.getUpdatedAt() | localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') }}</td>
                                        <td>
                                            <div class="item-actions">
                                                <a href="{{ path('admin_news_edit', {id: row.id}) }}" class="btn-sm">
                                                    <i class="fa fa-edit" aria-hidden="true"></i>
                                                </a>

                                                {{ include('admin/news/_delete_form.html.twig', {news: row}, with_context = false) }}
                                            </div>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
