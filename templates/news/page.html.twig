{% extends 'layout.html.twig' %}

{% set coverSrc = post.images ?: null %}

{% block title %}{{ (post.pageTitle|title_tokens) ?: (post.title|title_tokens) }} | {{ v3.company.shortName }}{% endblock %}
{% block description %}{{ post.pageDescription ?: post.description }}{% endblock %}
{% block keyword %}{{ post.pageKeyword }}{% endblock %}
{% block robots %}<meta name="robots" content="{{ post.getRobotsContent() }}">{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ canonicalUrl }}">{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('build/css/v3-news.css') }}">
{% endblock %}

{% block structuredOpenGraph %}
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    {% if coverSrc %}
        <meta property="og:image" content="{{ absolute_url(coverSrc) }}">
    {% endif %}
{% endblock %}

{% block jsonld %}
    {% set schemaMarkup = post.schemaMarkup|safe_json_ld %}
    {% if schemaMarkup %}
        <script type="application/ld+json">{{ schemaMarkup }}</script>
    {% else %}
        <script type="application/ld+json">{{ {
            '@context': 'https://schema.org',
            '@type': 'WebPage',
            'name': (post.pageTitle|title_tokens) ?: (post.title|title_tokens),
            'description': post.pageDescription ?: post.description,
            'url': canonicalUrl,
            'inLanguage': 'vi'
        }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
    {% endif %}
{% endblock %}

{% set breadcrumbItems = [{ label: 'Trang chủ', path: path('homepage') }] %}
{# Trang gốc của chuỗi (cha cao nhất, hoặc chính nó) dùng template "service_page" → chèn mục "Dịch vụ" #}
{% set rootPage = pageAncestors|default([])|first ?: post %}
{% if rootPage.template == 'service_page' %}
    {% set breadcrumbItems = breadcrumbItems|merge([{ label: 'Dịch vụ', path: path('homepage') ~ '#dich-vu' }]) %}
{% endif %}
{% for ancestor in pageAncestors|default([]) %}
    {% set breadcrumbItems = breadcrumbItems|merge([
        { label: (ancestor.breadcrumbTitle|title_tokens) ?: (ancestor.title|title_tokens), path: path('dynamic_post_page', { slug: ancestor.url }) }
    ]) %}
{% endfor %}
{% set breadcrumbItems = breadcrumbItems|merge([{ label: (post.breadcrumbTitle|title_tokens) ?: (post.title|title_tokens) }]) %}

{% block body %}

    {{ include('v3/components/_page_hero.html.twig', {
        breadcrumb: breadcrumbItems,
        title: (post.title|title_tokens),
        description: post.description
    }) }}

    {# ============ SỐ LIỆU TIN CẬY ============ #}
    {{ include('v3/components/_figures.html.twig') }}

    {# ============ NỘI DUNG ============ #}
    <div class="container max-w-7xl py-16 lg:py-20">
        <div class="grid lg:grid-cols-[1fr_340px] gap-16 items-start">

            <article class="max-w-3xl min-w-0">
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger" role="alert">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('notice') %}
                    <div class="alert alert-success" role="alert">{{ message }}</div>
                {% endfor %}

                <div class="post-content">
                    {% if pageBuilderBlocks is defined and pageBuilderBlocks is not empty %}
                        {{ include('page_builder/_blocks.html.twig', {blocks: pageBuilderBlocks, contactBlockForm: contactBlockForm|default(null)}) }}
                    {% else %}
                        {{ contentsLazy|raw }}
                    {% endif %}
                </div>


                {{ include('news/comments/_section.html.twig', { comments: comments, form: form }, with_context = false) }}
            </article>

            {# Sidebar dính #}
            <aside class="lg:sticky lg:top-28 space-y-8" aria-label="Thanh bên trang">
                {# Mục lục tự sinh từ h2 trong nội dung (xem js/v3/modules/toc.js) #}
                <nav class="toc" data-toc aria-label="Mục lục trang">
                    <p class="toc-title">Mục lục</p>
                    <ol></ol>
                </nav>

                <div class="post-cta-card">
                    <p class="post-cta-title">Nhận dự toán <em>miễn phí</em> cho ngôi nhà của bạn</p>
                    <p class="post-cta-note">Kiến trúc sư trưởng lập bảng bóc tách chi tiết trong 48 giờ.</p>
                    <a href="{{ path('contact') }}" class="btn2">Đặt lịch tư vấn</a>
                    <a href="tel:{{ v3.company.phoneRaw }}" class="post-cta-phone">{{ v3.company.phone }}</a>
                </div>
            </aside>
        </div>
    </div>

    {{ include('v3/components/_newsletter.html.twig') }}

{% endblock %}
