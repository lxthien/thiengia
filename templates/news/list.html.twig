{% extends 'layout.html.twig' %}

{#
    NewsController::listAction truyền: baseUrl, category, listCategories,
    pagination (KnpPaginator) — KHÔNG phải posts/currentPage/totalPages.
#}
{% set pageTitle = category ? category.name : 'Cẩm nang xây dựng' %}

{% block title %}{{ category and category.pageTitle ? category.pageTitle : pageTitle }} | {{ v3.company.shortName }}{% endblock %}
{% block description %}{{ category and category.pageDescription ? category.pageDescription : v3.company.description }}{% endblock %}
{% block robots %}<meta name="robots" content="{{ category ? category.getRobotsContent() : 'index, follow' }}">{% endblock %}

{% set currentPage = pagination is defined ? pagination.currentPageNumber : 1 %}
{% set pageCount = pagination is defined and pagination.itemNumberPerPage > 0 ? (pagination.totalItemCount / pagination.itemNumberPerPage)|round(0, 'ceil') : 1 %}

{% block canonical %}
    <link rel="canonical" href="{{ currentPage > 1 ? baseUrl ~ '?page=' ~ currentPage : baseUrl }}">
    {% if currentPage > 1 %}
        <link rel="prev" href="{{ currentPage == 2 ? baseUrl : baseUrl ~ '?page=' ~ (currentPage - 1) }}">
    {% endif %}
    {% if currentPage < pageCount %}
        <link rel="next" href="{{ baseUrl ~ '?page=' ~ (currentPage + 1) }}">
    {% endif %}
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('build/css/v3-list.css') }}">
{% endblock %}

{% set breadcrumbItems = [{ label: 'Trang chủ', path: path('homepage') }] %}
{% if category and category.parentcat is not same as('root') %}
    {% set breadcrumbItems = breadcrumbItems|merge([
        { label: category.parentcat.name, path: path('dynamic_post_page', { slug: category.parentcat.url }) }
    ]) %}
{% endif %}
{% set breadcrumbItems = breadcrumbItems|merge([{ label: pageTitle }]) %}

{% block body %}

    {{ include('v3/components/_page_hero.html.twig', {
        breadcrumb: breadcrumbItems,
        title: pageTitle,
        description: category and category.description ? category.description : null
    }) }}

    {# Bộ lọc chuyên mục #}
    {% if listCategories is defined and listCategories %}
        <nav class="cat-filter" aria-label="Chuyên mục bài viết">
            <div class="container max-w-7xl">
                <ul>
                    {% for cat in listCategories %}
                        <li>
                            <a href="{{ path('news_category', { level1: cat.url }) }}"
                               {{ category and category.id == cat.id ? 'aria-current="true"' : '' }}>{{ cat.name }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </nav>
    {% endif %}

    <section class="py-16 lg:py-20" aria-label="Danh sách bài viết">
        <div class="container max-w-7xl">

            {% if pagination is defined and pagination|length %}
                <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-x-8 gap-y-12">
                    {% for post in pagination %}
                        {{ include('v3/components/_post_card.html.twig', { post: post }) }}
                    {% endfor %}
                </div>

                {# Phân trang KnpPaginator, bọc trong class v3 để lấy style #}
                <div class="pagination-v3 mt-16">
                    {{ knp_pagination_render(pagination) }}
                </div>
            {% else %}
                <p class="list-empty">Chuyên mục này chưa có bài viết nào.</p>
            {% endif %}

        </div>
    </section>

    {{ include('v3/components/_newsletter.html.twig') }}

{% endblock %}
