{% if comments|length > 0 %}
    <div class="comments-list">
        <p class="comments-count">{{ 'comments.count'|trans({'%count%': comments|length}) }}</p>

        <ul class="comment-thread">
            {% for comment in comments %}
                {% if comment.getCommentId is null %}
                    <li class="comment-item" id="comment-{{ comment.getId() }}">
                        <div class="comment-avatar">{{ (comment.getAuthor()|default('?'))|slice(0, 1)|upper }}</div>
                        <div class="comment-body">
                            <div class="comment-meta">
                                <strong class="comment-author">{{ comment.getAuthor() }}</strong>
                                <time class="comment-date">{{ comment.getCreatedAt()|date('d/m/Y') }}</time>
                            </div>
                            <div class="comment-content">{{ comment.getContent()|raw }}</div>

                            {% set replies = comments|filter(reply => reply.getCommentId is same as(comment.getId())) %}
                            {% if replies|length %}
                                <ul class="comment-thread comment-thread--replies">
                                    {% for reply in replies %}
                                        {% set replyAuthor = (reply.getAuthor() is same as('Webmaster') and get_setting('displayNameCommentAs')) ? get_setting('displayNameCommentAs') : reply.getAuthor() %}
                                        <li class="comment-item">
                                            <div class="comment-avatar comment-avatar--reply">{{ (replyAuthor|default('?'))|slice(0, 1)|upper }}</div>
                                            <div class="comment-body">
                                                <div class="comment-meta">
                                                    <strong class="comment-author">{{ replyAuthor }}</strong>
                                                    <time class="comment-date">{{ reply.getCreatedAt()|date('d/m/Y') }}</time>
                                                </div>
                                                <div class="comment-content">{{ reply.getContent()|nl2br }}</div>
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
{% else %}
    <p class="comments-empty">Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ ý kiến của bạn.</p>
{% endif %}
