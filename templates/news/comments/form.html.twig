<div class="comment-form" id="binh-luan-form">
    <h3 class="comment-form-title">Để lại bình luận</h3>
    <p class="comment-form-note">{{ 'comment.leave_your_comment_below'|trans }}</p>

    {{ form_start(form, { attr: { class: 'mt-6', 'data-quote': '', 'data-ajax-form': '' } }) }}
        {% if form.vars.errors|length %}
            <div class="form-error mt-4">{{ form_errors(form) }}</div>
        {% endif %}

        <div class="form-field">
            {{ form_label(form.content) }}
            {{ form_widget(form.content, { attr: { placeholder: 'Chia sẻ ý kiến của bạn về bài viết này...' } }) }}
            {% if form.content.vars.errors|length %}<div class="form-error">{{ form_errors(form.content) }}</div>{% endif %}
        </div>

        <div class="grid sm:grid-cols-2 gap-6 mt-6">
            <div class="form-field">
                {{ form_label(form.author) }}
                {{ form_widget(form.author, { attr: { placeholder: 'Nguyễn Văn A', autocomplete: 'name' } }) }}
                {% if form.author.vars.errors|length %}<div class="form-error">{{ form_errors(form.author) }}</div>{% endif %}
            </div>
            <div class="form-field">
                {{ form_label(form.phone) }}
                {{ form_widget(form.phone, { attr: { placeholder: '09xx xxx xxx', autocomplete: 'tel' } }) }}
                {% if form.phone.vars.errors|length %}<div class="form-error">{{ form_errors(form.phone) }}</div>{% endif %}
            </div>
        </div>

        {{ form_widget(form.ip) }}
        {{ form_widget(form.news_id) }}
        {{ form_widget(form.comment_id) }}
        {{ form_widget(form.gclid) }}
        {{ form_widget(form._token) }}

        <button type="submit" class="btn2 mt-8">
            Gửi bình luận
            <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
    {{ form_end(form, { render_rest: false }) }}
</div>
