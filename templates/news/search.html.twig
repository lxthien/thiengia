{% extends 'layout.html.twig' %}
{% set currentPage = pagination.currentPageNumber %}
{% set pageCount = pagination.pageCount %}
{% block title %}Tìm kiếm: {{ q }}{{ currentPage > 1 ? ' - Trang ' ~ currentPage : '' }} | {{ v3.company.shortName }}{% endblock %}
{% block description %}Kết quả tìm kiếm nội dung về xây dựng cho từ khóa {{ q }} trên {{ v3.company.shortName }}.{% endblock %}
{% block robots %}<meta name="robots" content="noindex, follow">{% endblock %}
{% block canonical %}
    <link rel="canonical" href="{{ currentPage > 1 ? baseUrl ~ '&page=' ~ currentPage : baseUrl }}">
    {% if currentPage > 1 %}<link rel="prev" href="{{ currentPage == 2 ? baseUrl : baseUrl ~ '&page=' ~ (currentPage - 1) }}">{% endif %}
    {% if currentPage < pageCount %}<link rel="next" href="{{ baseUrl ~ '&page=' ~ (currentPage + 1) }}">{% endif %}
{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('build/css/v3-list.css') }}">{% endblock %}
{% block bodyClass %}search-view{% endblock %}
{% block body %}
{{ include('v3/components/_page_hero.html.twig', {
    breadcrumb: [{label: 'Trang chủ', path: path('homepage')}, {label: 'Tìm kiếm'}],
    title: 'Kết quả tìm kiếm',
    description: ('Nội dung phù hợp với từ khóa “' ~ q ~ '”.')|e
}) }}
<section class="search-page" aria-labelledby="search-results-title">
    <div class="container max-w-7xl">
        <form class="search-page__form" action="{{ path('news_search') }}" method="get" role="search">
            <label for="search-query">Bạn muốn tìm nội dung gì?</label>
            <div class="search-page__fields">
                <input id="search-query" type="search" name="q" value="{{ q }}" placeholder="Ví dụ: chi phí xây nhà" required maxlength="200">
                <button class="btn2" type="submit">Tìm kiếm</button>
            </div>
        </form>
        <div class="search-page__summary">
            <h2 id="search-results-title">{{ pagination.totalItemCount }} kết quả cho “{{ q }}”</h2>
            {% if pagination|length and get_setting('isShowSortOnCategory') %}
                <details class="search-page__sort">
                    <summary>Sắp xếp kết quả</summary>
                    <div>
                        {{ knp_pagination_sortable(pagination, 'Theo mã bài viết', 'id') }}
                        {{ knp_pagination_sortable(pagination, 'Theo tiêu đề', 'title') }}
                        {{ knp_pagination_sortable(pagination, 'Theo ngày đăng', 'createdAt') }}
                    </div>
                </details>
            {% endif %}
        </div>
        {% if pagination|length %}
            <div class="search-page__grid">
                {% for post in pagination %}
                    {{ include('v3/components/_post_card.html.twig', {post: post, searchHighlight: true}) }}
                {% endfor %}
            </div>
            <div class="pagination-v3 mt-16">{{ knp_pagination_render(pagination) }}</div>
        {% else %}
            <div class="search-page__empty">
                <h3>Chưa tìm thấy nội dung phù hợp</h3>
                <p>Hãy thử từ khóa ngắn hơn, kiểm tra chính tả hoặc tìm theo chủ đề như “xây nhà”, “báo giá”, “thiết kế”.</p>
                <a class="btn2" href="{{ path('homepage') }}">Về trang chủ</a>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
