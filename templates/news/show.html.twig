{% extends 'layout.html.twig' %}

{% set coverSrc = post.images
    ? post.images
    : asset('assets/images/no-image.png') %}

{% block title %}{{ post.pageTitle ?: post.title }} | {{ v3.company.shortName }}{% endblock %}
{% block description %}{{ post.pageDescription ?: post.description }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('build/css/v3-news.css') }}">
{% endblock %}

{% block openGraph %}
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    <meta property="og:image" content="{{ absolute_url(coverSrc) }}">
    <meta property="article:published_time" content="{{ post.createdAt|date('Y-m-d') }}">
    {% if post.updatedAt %}
        <meta property="article:modified_time" content="{{ post.updatedAt|date('Y-m-d') }}">
    {% endif %}
    {% if category %}
        <meta property="article:section" content="{{ category.name }}">
    {% endif %}
{% endblock %}

{% block jsonld %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Article",
        "mainEntityOfPage": {{ app.request.uri|json_encode|raw }},
        "headline": {{ post.title|json_encode|raw }},
        "description": {{ (post.description ?: '')|json_encode|raw }},
        "image": {{ absolute_url(coverSrc)|json_encode|raw }},
        "datePublished": {{ post.createdAt|date('Y-m-d')|json_encode|raw }},
        {% if post.updatedAt %}"dateModified": {{ post.updatedAt|date('Y-m-d')|json_encode|raw }},{% endif %}
        "inLanguage": "vi",
        {% if category %}"articleSection": {{ category.name|json_encode|raw }},{% endif %}
        "author": {
            "@type": "Person",
            "name": {{ (post.author ? post.author.username : v3.company.authorName)|json_encode|raw }}
        },
        "publisher": {
            "@type": "Organization",
            "name": {{ v3.company.legalName|json_encode|raw }}
        }
    }
    </script>
{% endblock %}

{% block body %}

    {# ============ BANNER BÀI VIẾT ============ #}
    <header class="page-hero !pb-32" aria-label="Thông tin bài viết">
        <div class="container max-w-7xl relative">
            {{ include('v3/components/_breadcrumb.html.twig', {
                items: [
                    { label: 'Trang chủ', path: path('homepage') },
                    { label: 'Cẩm nang xây dựng', path: path('news_category', { level1: v3.newsCategorySlug }) },
                    { label: post.breadcrumbTitle ?: post.title }
                ]
            }) }}

            {% if category %}
                <p class="sec-label sec-label--light mt-8 fade">{{ category.name }}</p>
            {% endif %}

            <h1 class="page-hero-title mt-5 max-w-4xl fade">{{ post.title }}</h1>

            <p class="post-meta mt-8 fade">
                <span>Bởi <strong>{{ post.author ? post.author.username : v3.company.authorName }}</strong></span>
                <time datetime="{{ post.createdAt|date('Y-m-d') }}">{{ post.createdAt|date('d/m/Y') }}</time>
                {% if readingMinutes|default(0) %}
                    <span>{{ readingMinutes }} phút đọc</span>
                {% endif %}
            </p>
        </div>
    </header>

    {# ============ NỘI DUNG ============ #}
    <div class="container max-w-7xl py-16 lg:py-20">
        <div class="grid lg:grid-cols-[1fr_340px] gap-16 items-start">

            <article class="max-w-3xl">
                {# Nội dung từ CKEditor #}
                <div class="post-content">{{ post.contents|raw }}</div>

                {% if post.tags|default([])|length %}
                    <nav class="post-tags mt-12" aria-label="Thẻ bài viết">
                        {% for tag in post.tags %}
                            <a href="{{ path('news_category', { level1: v3.newsCategorySlug }) }}">{{ tag.name }}</a>
                        {% endfor %}
                    </nav>
                {% endif %}

                <aside class="author-box mt-12">
                    <img src="{{ asset(v3.company.authorAvatar) }}" alt="Chân dung {{ v3.company.authorName }}" loading="lazy" decoding="async">
                    <div>
                        <p class="author-label">Tác giả</p>
                        <p class="author-name">{{ post.author ? post.author.username : v3.company.authorName }}</p>
                        <p class="author-bio">{{ v3.company.authorBio }}</p>
                    </div>
                </aside>

                {{ include('news/comments/_section.html.twig', { comments: comments, form: form }, with_context = false) }}
            </article>

            {# Sidebar dính #}
            <aside class="lg:sticky lg:top-28 space-y-8" aria-label="Thanh bên bài viết">
                {# Mục lục tự sinh từ h2 trong nội dung (xem js/v3/modules/toc.js) #}
                <nav class="toc" data-toc aria-label="Mục lục bài viết">
                    <p class="toc-title">Mục lục</p>
                    <ol></ol>
                </nav>

                <div class="post-cta-card">
                    <p class="post-cta-title">Nhận dự toán <em>miễn phí</em> cho ngôi nhà của bạn</p>
                    <p class="post-cta-note">Kiến trúc sư trưởng lập bảng bóc tách chi tiết trong 48 giờ.</p>
                    <a href="{{ path('contact') }}" class="btn2">Đặt lịch tư vấn</a>
                    <a href="tel:{{ v3.company.phoneRaw }}" class="post-cta-phone">{{ v3.company.phone }}</a>
                </div>
            </aside>
        </div>
    </div>

    {# ============ BÀI LIÊN QUAN ============ #}
    {% if relatedPosts|default([])|length %}
        <section class="commits py-20 lg:py-24" aria-labelledby="lien-quan-h">
            <div class="container max-w-7xl">
                <div class="flex flex-wrap items-end justify-between gap-6">
                    <div>
                        <p class="sec-label fade">Đọc tiếp</p>
                        <h2 id="lien-quan-h" class="h-display text-3xl lg:text-4xl mt-5 fade">Bài viết <em>liên quan</em></h2>
                    </div>
                    <a href="{{ path('news_category', { level1: v3.newsCategorySlug }) }}" class="btn2 btn2--dark !py-3 !px-5 fade">Xem tất cả</a>
                </div>

                <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-x-8 gap-y-12 mt-12">
                    {% for related in relatedPosts %}
                        {{ include('v3/components/_post_card.html.twig', { post: related, headingLevel: 'h3' }) }}
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {{ include('v3/components/_newsletter.html.twig') }}

{% endblock %}
