{% extends 'layout.html.twig' %}

{% block stylesheets %}
    <link href="{{ absolute_url(asset('build/css/news.css')) }}" rel="preload stylesheet" as="style" onload="this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ absolute_url(asset('build/css/news.css')) }}"></noscript>
{% endblock %}

{% set year = "now"|date('Y') %}
{% set pageTitle = (post.getPageTitle() ?: post.getTitle())|replace({'%YEAR%': year}) %}
{% set pageDesc = (post.getPageDescription() ?: post.getDescription())|replace({'%YEAR%': year}) %}
{% set postUrl = absolute_url(path('news_show', {'slug': post.getUrl()})) %}
{% set homeUrl = absolute_url(path('homepage')) %}
{% set authorUrl = absolute_url(path('author', {'slug': 'nguyenduytuan'})) %}

{% set imagePath = vich_uploader_asset(post, 'imageFile') ?: absolute_url(asset('assets/images/no-image.png')) %}
{% set imagePathFilter = (vich_uploader_asset(post, 'imageFile') ?: absolute_url(asset('assets/images/no-image.png')))|imagine_filter('news_share_1200_630') %}
{% set userPath = asset('/assets/images/user.png')|imagine_filter('user') %}
{% set keywords = post.getPageKeyword() ? post.getPageKeyword()|split(',') : null %}
{% if not convert_images.fileExists(imagePath) %}
    {% set imagePath = imagePath|imagine_filter('news_share_1200_630') %}
{% else %}
    {% set imagePath = convert_images.webpConvert(imagePathFilter, '', true) %}
{% endif %}

{% block title %}{{ pageTitle }}{% endblock %}
{% block description %}{{ pageDesc }}{% endblock %}
{% block keyword %}{{ post.getPageKeyword() }}{% endblock %}

{% block structuredOpenGraph %}
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDesc }}">
    <meta property="article:author" content="{{ post.getAuthor().getName() }}">
    <meta property="article:published_time" content="{{ post.getCreatedAt()|date("Y-m-d h:m:s") }}+07:00">
    <meta property="article:modified_time" content="{{ post.getUpdatedAt()|date("Y-m-d h:m:s") }}+07:00">
    <meta property="og:image" content="{{ absolute_url(imagePathFilter) }}">
    <meta property="og:image:alt" content="{{ post.getTitle() }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
{% endblock %}

{% block twitterImage %}<meta property="twitter:image" content="{{ absolute_url(imagePathFilter) }}">
{% endblock %}

{% block structuredReview %}
    {% if ratingCount > 0 %}
        <script type="application/ld+json">{"@context":"https://schema.org/","@type":"CreativeWorkSeries","name":"{{ post.getTitle() }}","aggregateRating":{"@type":"AggregateRating","ratingValue":"{{ rating }}","ratingCount":"{{ ratingCount }}","bestRating":"5","worstRating":"1"}}</script>
    {% endif %}
{% endblock %}

{% block robots %}
    <meta name="robots" content="{{ urlParameters ? 'follow, noindex' : (post.getRobots() ?: 'index, follow') }}">
{% endblock %}

{% block contactHotline %}
    {% if post.getContactHotline() is empty %}
        <div class="hotline">
            <div class="inner">
                <a href="tel:{{ get_setting('contens_hotline_1')|replace({' ': '', '.': ''}) }}">
                    <div class="phonering-alo-ph-img-circle"></div>{{ get_setting('contens_hotline_1') }}</a>
            </div>
        </div>
    {% else %}
        {{ post.getContactHotline()|raw }}
    {% endif %}
{% endblock %}

{% block blogPosting %}
    {% if post.getSchemaMarkup() %}
        {{ post.getSchemaMarkup()|raw }}
    {% else %}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org/",
            "@type": "WebPage",
            "@id": "{{ postUrl }}#webpage",
            "url": "{{ postUrl }}",
            "name": "{{ pageTitle }}",
            "datePublished": "{{ post.getCreatedAt()|date('Y-m-d h:m:s') }}+07:00",
            "dateModified": "{{ post.getUpdatedAt()|date('Y-m-d h:m:s') }}+07:00",
            "isPartOf": {
                "@id": "{{ homeUrl }}#website"
            },
            "primaryImageOfPage": {
                "@id": "{{ absolute_url(imagePathFilter) }}"
            },
            "description": "{{ pageDesc }}",
            "breadcrumb": "{{ postUrl }}#breadcrumb",
            "inLanguage": "vi-VN"
        }
        </script>
        <script type="application/ld+json">
        {
            "@context": "https://schema.org/",
            "@type": "BlogPosting",
            "@id": "{{ postUrl }}#BlogPosting",
            "mainEntityOfPage": {
                "@id": "{{ postUrl }}#webpage"
            },
            "isFamilyFriendly": true,
            "isAccessibleForFree": true,
            "headline": "{{ post.getTitle() }}",
            "name": "{{ pageTitle }}",
            "description": "{{ pageDesc }}",
            "datePublished": "{{ post.getCreatedAt()|date('Y-m-d h:m:s') }}+07:00",
            "dateModified": "{{ post.getUpdatedAt()|date('Y-m-d h:m:s') }}+07:00",
            "articleSection": "{{ category.getName() }}",
            "accessMode": ["textual"],
            "author": {
                "@type": "Person",
                "@id": "{{ authorUrl }}#Person",
                "name": "Nguyễn Duy Tuấn",
                "url": "{{ authorUrl }}",
                "image": {
                    "@type": "ImageObject",
                    {% set webpUserPath = convert_images.webpConvert(userPath, '', true) %}
                    "@id": "{{ absolute_url(webpUserPath ? asset(webpUserPath) : userPath) }}",
                    "url": "{{ absolute_url(webpUserPath ? asset(webpUserPath) : userPath) }}",
                    "height": "65",
                    "width": "65"
                }
            },
            "publisher": {
                "@type": "Organization",
                "@id": "{{ homeUrl }}#organization"
            },
            "image": {
                "@type": "ImageObject",
                "@id": "{{ absolute_url(imagePathFilter) }}#image",
                "url": "{{ absolute_url(imagePathFilter) }}",
                "height": "630",
                "width": "1200"
            },
            "url": "{{ postUrl }}",
            "wordCount": "{{ wordCount }}",
            "acquireLicensePage": "{{ absolute_url(path('news_show', {'slug': 'chinh-sach-bao-mat-thong-tin'})) }}",
            "copyrightHolder": {
                "@id": "{{ homeUrl }}#organization"
            },
            "accountablePerson": {
                "@id": "{{ authorUrl }}#Person"
            },
            "creator": {
                "@id": "{{ authorUrl }}#Person"
            },
            "sourceOrganization": {
                "@id": "{{ homeUrl }}#organization"
            },
            "inLanguage": "vi-VN",
            "commentCount": "{{ comments|length }}",
            "isPartOf": {
                "@id": "{{ postUrl }}#webpage"
            }
            {% if keywords %}
            ,"keywords": [
                {% for keyword in keywords %}"{{ keyword|trim }}"
                    {% if not loop.last %},
                    {% endif %}
                {% endfor %}]
            {% endif %}
        }
        </script>
    {% endif %}
{% endblock %}

{% block body %}
    <div class="container wrapper-container ka-page-detail">
        <div class="row">
            <div class="col-lg-9 ka-content-column">
                {{ include('news/components/breadcrumbs.html.twig') }}
                <article id="post-{{ post.getId() }}" class="ka-article-wrapper">
                    <h1 class="ka-article-title">{{ post.getTitle() }}</h1>
                    <p class="ka-article-meta">Cập nhật ngày:
                        {{ post.getUpdatedAt()|date('d/m/Y') }}
                        bởi
                        <a href="{{ path('dynamic_post_page', {'slug': 'nguyenduytuan'}) }}" target="_blank" class="last-modified-author">Nguyễn Duy Tuấn</a>
                    </p>
                    <div class="ka-article-body">{{ contentsLazy|raw }}</div>
                    {{ include('news/components/tags.html.twig') }}
                    <div class="ka-article-interactions">
                        {{ include('news/rating/rating.html.twig') }}
                    </div>
                    {{ include('news/components/author.html.twig') }}

                    {{ include('news/components/related.html.twig') }}

                    {{ include('news/comments/list.html.twig') }}
                    {{ include('news/comments/form.html.twig') }}
                </article>
            </div>
            {{ include('layout/sidebar.html.twig') }}
        </div>
    </div>
{% endblock %}
