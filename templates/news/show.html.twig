{% extends 'layout.html.twig' %}

{% set coverSrc = post.images
    ? post.images
    : asset('assets/images/no-image.png') %}

{% block title %}{{ (post.pageTitle|title_tokens) ?: (post.title|title_tokens) }}{% endblock %}
{% block description %}{{ post.pageDescription ?: post.description }}{% endblock %}
{% block robots %}<meta name="robots" content="{{ post.getRobotsContent() }}">{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ canonicalUrl }}">{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('build/css/v3-news.css') }}">
{% endblock %}

{% block openGraph %}
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    <meta property="og:image" content="{{ absolute_url(coverSrc) }}">
    <meta property="article:published_time" content="{{ (post.publishedAt ?: post.createdAt)|date('c') }}">
    {% if post.updatedAt %}
        <meta property="article:modified_time" content="{{ post.updatedAt|date('c') }}">
    {% endif %}
    {% if category %}
        <meta property="article:section" content="{{ category.name }}">
    {% endif %}
{% endblock %}

{% block jsonld %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Article",
        "mainEntityOfPage": {{ canonicalUrl|json_encode|raw }},
        "headline": {{ (post.title|title_tokens)|json_encode|raw }},
        "description": {{ (post.description ?: '')|json_encode|raw }},
        "image": {{ absolute_url(coverSrc)|json_encode|raw }},
        "datePublished": {{ (post.publishedAt ?: post.createdAt)|date('c')|json_encode|raw }},
        {% if post.updatedAt %}"dateModified": {{ post.updatedAt|date('c')|json_encode|raw }},{% endif %}
        "inLanguage": "vi",
        {% if category %}"articleSection": {{ category.name|json_encode|raw }},{% endif %}
        "author": {
            "@type": "Person",
            "name": {{ (post.author ? post.author.authorDisplayName : v3.company.authorName)|json_encode|raw }}
        },
        "publisher": {
            "@type": "Organization",
            "name": {{ v3.company.legalName|json_encode|raw }}
        }
        {%- if ratingCount is defined and ratingCount > 0 %},
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ rating }},
            "reviewCount": {{ ratingCount }},
            "bestRating": 5,
            "worstRating": 1
        }
        {%- endif %}
    }
    </script>
{% endblock %}

{% set breadcrumbItems = [{ label: 'Trang chủ', path: path('homepage') }] %}
{% if category %}
    {% if category.parentcat is not null %}
        {% set breadcrumbItems = breadcrumbItems|merge([
            { label: category.parentcat.name, path: path('dynamic_post_page', { slug: category.parentcat.url }) }
        ]) %}
        {% set breadcrumbItems = breadcrumbItems|merge([
            { label: category.name, path: path('dynamic_category_post', { level1: category.parentcat.url, level2: category.url }) }
        ]) %}
    {% else %}
        {% set breadcrumbItems = breadcrumbItems|merge([
            { label: category.name, path: path('dynamic_post_page', { slug: category.url }) }
        ]) %}
    {% endif %}
{% endif %}
{% set breadcrumbItems = breadcrumbItems|merge([{ label: (post.breadcrumbTitle|title_tokens) ?: (post.title|title_tokens) }]) %}

{% block body %}

    {# ============ BANNER BÀI VIẾT ============ #}
    <header class="page-hero !pb-32" aria-label="Thông tin bài viết">
        {{ include('v3/components/_page_hero_media.html.twig') }}
        <div class="container max-w-7xl relative">
            {{ include('v3/components/_breadcrumb.html.twig', { items: breadcrumbItems }) }}

            {% if category %}
                <p class="sec-label sec-label--light mt-8 fade">{{ category.name }}</p>
            {% endif %}

            <h1 class="page-hero-title mt-5 max-w-4xl fade">{{ (post.title|title_tokens) }}</h1>

            {% set publicationDate = post.publishedAt ?: post.createdAt %}
            {% if publicationDate %}
                <p class="post-meta mt-8 fade">
                    <span>Đăng ngày <time datetime="{{ publicationDate|date('c') }}">{{ publicationDate|date('d/m/Y') }}</time></span>
                </p>
            {% endif %}
        </div>
    </header>

    {# ============ NỘI DUNG ============ #}
    <div class="container max-w-7xl py-16 lg:py-20">
        <div class="grid lg:grid-cols-[1fr_340px] gap-16 items-start">

            <article class="max-w-3xl min-w-0">
                {# Nội dung từ CKEditor #}
                {# contentsLazy: nội dung đã qua ContentFormatter (thay shortcode
                   [ten_cong_ty], [hotline_1]..., ảnh lazy + WebP), giống trang Page. #}
                <div class="post-content">{{ contentsLazy|raw }}</div>

                {% if post.tags|default([])|length %}
                    <nav class="post-tags mt-12" aria-label="Thẻ bài viết">
                        {% for tag in post.tags %}
                            <a href="{{ path('news_category', { level1: v3.newsCategorySlug }) }}">{{ tag.name }}</a>
                        {% endfor %}
                    </nav>
                {% endif %}

                {{ include('v3/components/_rating.html.twig', {
                    post: post,
                    rating: rating,
                    ratingValue: ratingValue,
                    ratingCount: ratingCount,
                    alreadyRated: alreadyRated,
                }, with_context = false) }}

                {{ include('v3/components/_author_box.html.twig', {post: post}) }}

                {{ include('news/comments/_section.html.twig', { comments: comments, form: form }, with_context = false) }}
            </article>

            {# Sidebar dính #}
            <aside class="lg:sticky lg:top-28 space-y-8" aria-label="Thanh bên bài viết">
                {# Mục lục tự sinh từ h2 trong nội dung (xem js/v3/modules/toc.js) #}
                <nav class="toc" data-toc aria-label="Mục lục bài viết">
                    <p class="toc-title">Mục lục</p>
                    <ol></ol>
                </nav>

                <div class="post-cta-card">
                    <p class="post-cta-title">Nhận dự toán <em>miễn phí</em> cho ngôi nhà của bạn</p>
                    <p class="post-cta-note">Kiến trúc sư trưởng lập bảng bóc tách chi tiết trong 24 giờ.</p>
                    <a href="{{ path('contact') }}" class="btn2">Đặt lịch tư vấn</a>
                    <a href="tel:{{ v3.company.phoneRaw }}" class="post-cta-phone">{{ v3.company.phone }}</a>
                </div>
            </aside>
        </div>
    </div>

    {# ============ BÀI LIÊN QUAN ============ #}
    {% if relatedNews|default([])|length %}
        <section class="commits py-20 lg:py-24" aria-labelledby="lien-quan-h">
            <div class="container max-w-7xl">
                <div class="flex flex-wrap items-end justify-between gap-6">
                    <div>
                        <p class="sec-label fade">Đọc tiếp</p>
                        <h2 id="lien-quan-h" class="h-display text-3xl lg:text-4xl mt-5 fade">Bài viết <em>liên quan</em></h2>
                    </div>
                    {# Danh mục chính của bài (NewsController::showAction); bài chưa gắn danh mục thì ẩn nút. #}
                    {% if categoryUrl %}
                        <a href="{{ categoryUrl }}" class="btn2 btn2--dark !py-3 !px-5 fade">Xem tất cả{% if category %}<span class="sr-only"> bài viết {{ category.name }}</span>{% endif %}</a>
                    {% endif %}
                </div>

                <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-x-8 gap-y-12 mt-12">
                    {% for related in relatedNews %}
                        {{ include('v3/components/_post_card.html.twig', { post: related, headingLevel: 'h3' }) }}
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {{ include('v3/components/_newsletter.html.twig') }}

{% endblock %}
