<html lang="vi">
    <body style="margin:0;padding:24px;background:#faf7f2;font-family:Arial,Helvetica,sans-serif;color:#2b2622;">
        <table role="presentation" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #e8dcc8;">
            <tr>
                <td style="padding:20px 24px;background:#b5462e;color:#ffffff;font-size:18px;font-weight:bold;">
                    Yêu cầu mới từ website
                </td>
            </tr>
            <tr>
                <td style="padding:24px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;font-size:15px;line-height:1.6;">
                        <tr>
                            <td style="padding:6px 0;width:130px;color:#6b635c;vertical-align:top;">Họ và tên</td>
                            <td style="padding:6px 0;font-weight:bold;">{{ contact.name }}</td>
                        </tr>
                        <tr>
                            <td style="padding:6px 0;color:#6b635c;vertical-align:top;">Số điện thoại</td>
                            <td style="padding:6px 0;font-weight:bold;"><a href="tel:{{ contact.phone }}" style="color:#b5462e;text-decoration:none;">{{ contact.phone }}</a></td>
                        </tr>
                        {% if contact.email %}
                            <tr>
                                <td style="padding:6px 0;color:#6b635c;vertical-align:top;">Email</td>
                                <td style="padding:6px 0;"><a href="mailto:{{ contact.email }}" style="color:#b5462e;">{{ contact.email }}</a></td>
                            </tr>
                        {% endif %}
                        {% if contact.title %}
                            <tr>
                                <td style="padding:6px 0;color:#6b635c;vertical-align:top;">Nhu cầu</td>
                                <td style="padding:6px 0;">{{ contact.title }}</td>
                            </tr>
                        {% endif %}
                        <tr>
                            <td style="padding:6px 0;color:#6b635c;vertical-align:top;">Nội dung</td>
                            <td style="padding:6px 0;">{{ contact.contents|nl2br }}</td>
                        </tr>
                        <tr>
                            <td style="padding:6px 0;color:#6b635c;vertical-align:top;">Gửi từ</td>
                            <td style="padding:6px 0;">{{ source }}</td>
                        </tr>
                        {% if contact.gclid %}
                            <tr>
                                <td style="padding:6px 0;color:#6b635c;vertical-align:top;">Google Click ID</td>
                                <td style="padding:6px 0;word-break:break-all;">{{ contact.gclid }}</td>
                            </tr>
                        {% endif %}
                    </table>

                    <p style="margin:24px 0 0;">
                        <a href="{{ adminUrl }}" style="display:inline-block;padding:10px 18px;background:#2b2622;color:#ffffff;text-decoration:none;font-size:14px;">Xem trong trang quản trị</a>
                    </p>
                </td>
            </tr>
            <tr>
                <td style="padding:14px 24px;border-top:1px solid #e8dcc8;font-size:12px;color:#6b635c;">
                    Email tự động từ form trên website {{ v3.company.shortName }}.
                </td>
            </tr>
        </table>
    </body>
</html>
