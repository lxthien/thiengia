{# Dải 4 con số. Khối này không có tiêu đề nên không dùng section.label/title. #}
<div class="figures">
    <div class="container max-w-7xl grid grid-cols-2 lg:grid-cols-4 divide-x divide-white/10">
        {% for figure in section.getConfigValue('items') ?: v3.figures %}
            <div class="figure">
                <p class="figure-value"><span data-count="{{ figure.value }}">0</span><sup>{{ figure.unit }}</sup></p>
                <p class="figure-label">{{ figure.label }}</p>
            </div>
        {% endfor %}
    </div>
</div>
