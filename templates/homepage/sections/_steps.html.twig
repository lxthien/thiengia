<section id="quy-trinh" class="steps2 py-20 lg:py-24" aria-labelledby="quy-trinh-h">
    <div class="container max-w-7xl">
        <div class="max-w-2xl mx-auto text-center">
            <p class="sec-label sec-label--center fade">{{ section.label|default('Quy trình làm việc')|raw }}</p>
            <h2 id="quy-trinh-h" class="h-display text-3xl lg:text-4xl mt-5 fade">{{ section.title|default('8 bước — rõ ràng <em>từ đầu</em>')|raw }}</h2>
        </div>

        <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-12">
            {% for step in section.getConfigValue('items') ?: v3.steps %}
                <li class="step2 fade">
                    <p class="step2-no" aria-hidden="true">{{ '%02d'|format(loop.index) }}</p>
                    <h3 class="step2-name">{{ step.name }}</h3>
                    <p class="step2-desc">{{ step.desc }}</p>
                </li>
            {% endfor %}
        </ol>
    </div>
</section>
