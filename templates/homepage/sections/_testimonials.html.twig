{# Nội dung lấy từ entity Testimonial (admin: Đánh giá khách hàng) #}
<section class="quotes py-20 lg:py-28" aria-label="Khách hàng đánh giá">
    <div class="container max-w-5xl">
        <p class="sec-label sec-label--center fade">{{ section.label|default('Khách hàng nói về chúng tôi')|raw }}</p>

        <div class="quotes-viewport mt-10 fade" data-quotes
             aria-roledescription="carousel" aria-label="Đánh giá của khách hàng">
            <div class="quotes-track">
                {% for quote in testimonials %}
                    <figure class="quote-slide">
                        <p class="quote-mark" aria-hidden="true">“</p>
                        <blockquote>{{ quote.text }}</blockquote>
                        <p class="quote-stars" role="img" aria-label="Đánh giá {{ quote.rating }} trên 5 sao">
                            {%- for i in 1..5 -%}{{ i <= quote.rating ? '★' : '☆' }}{%- endfor -%}
                        </p>
                        <figcaption class="quote-author">
                            <img src="{{ quote.avatarUrl }}" alt="Chân dung {{ quote.name }}" loading="lazy" decoding="async">
                            <span>
                                <span class="quote-name">{{ quote.name }}</span>
                                <span class="quote-role">{{ quote.role }}</span>
                            </span>
                        </figcaption>
                    </figure>
                {% endfor %}
            </div>
        </div>

        <div class="quotes-controls fade">
            <button class="quotes-nav" data-quotes-prev aria-label="Đánh giá trước">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            </button>
            <div class="quotes-dots" role="tablist" aria-label="Chọn đánh giá">
                {% for quote in testimonials %}
                    <button class="quotes-dot" data-quotes-dot="{{ loop.index0 }}"
                            {{ loop.first ? 'aria-current="true"' : '' }}
                            aria-label="Đánh giá {{ loop.index }}"></button>
                {% endfor %}
            </div>
            <button class="quotes-nav" data-quotes-next aria-label="Đánh giá tiếp theo">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
        </div>
    </div>
</section>
