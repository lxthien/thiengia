<section id="cam-ket" class="commits py-20 lg:py-24" aria-labelledby="cam-ket-h">
    <div class="container max-w-7xl commits-layout">
        <div class="commits-intro">
            <p class="sec-label">{{ section.label|default('Vì sao chọn ' ~ v3.company.shortNameOnly)|raw }}</p>
            <h2 id="cam-ket-h" class="h-display commits-title">{{ section.title|default('6 cam kết <em>bằng văn bản</em>')|raw }}</h2>
            {% set customImage = section.getConfigValue('image') %}
            <figure>
                <div class="commits-media">
                    <img src="{{ asset(customImage ?: 'assets/images/commitments/engineer-stock.jpg') }}" alt="{{ customImage ? section.getConfigValue('imageAlt', '') : 'Ảnh minh họa kỹ sư kiểm tra bản vẽ tại công trường' }}" width="800" height="600" loading="lazy" decoding="async">
                </div>
                {% if not customImage %}<figcaption class="commits-caption">Ảnh minh họa, không phải công trình Thiện Gia.</figcaption>{% endif %}
            </figure>
        </div>

        <ol class="commits-list" role="list">
            {% for commit in section.getConfigValue('items') ?: v3.commitments %}
                {# icon: config lưu KEY an toàn (xem SectionIcons); YAML mặc định lưu thẳng markup #}
                <li class="commit">
                    <div class="commit-top">
                    <span class="commit-number" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                    <span class="commit-icon" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ commit.icon starts with '<' ? commit.icon|raw : section_icon(commit.icon) }}</svg>
                    </span>
                    </div>
                    <div>
                        <h3 class="commit-name">{{ commit.name }}</h3>
                        <p class="commit-desc">{{ commit.desc }}</p>
                    </div>
                </li>
            {% endfor %}
        </ol>
    </div>
</section>
