{% extends 'layout.html.twig' %}

{# Tiêu đề, mô tả lấy từ admin (Cài đặt chung → SEO); để trống thì dùng mặc định của theme #}
{% block title %}{{ get_setting('pageTitle') ?: v3.company.shortName ~ ' — ' ~ v3.company.slogan }}{% endblock %}
{% block description %}{{ get_setting('pageDescription') ?: v3.company.description }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('build/css/v3-homepage.css') }}">
{% endblock %}
{% block jsonld %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Xây Dựng Thiện Gia",
        "alternateName": "Thiện Gia",
        "url": "https://xaydungthiengia.com/"
    }
    </script>
{% endblock %}

{% block body %}
    {# Thứ tự, bật/tắt và phần chữ của từng khối do admin quản lý ở
       /admin/homepage-section (entity HomepageSection). Dữ liệu động của
       khối do App\Service\Homepage\HomepageDataProvider cấp. #}
    {% for item in sections %}
        {{ include(
            'homepage/sections/_' ~ item.section.type.value ~ '.html.twig',
            item.data|merge({ section: item.section }),
            with_context = false
        ) }}
    {% endfor %}
{% endblock %}
