{% extends 'layout.html.twig' %}

{% block title %}{{ v3.company.shortName }} — {{ v3.company.slogan }}{% endblock %}
{% block description %}{{ v3.company.description }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('build/css/v3-homepage.css') }}">
{% endblock %}

{% block body %}

    {# ============ HERO + FORM BÁO GIÁ ============ #}
    <section class="hero2" aria-label="Giới thiệu tổng quan">
        <div class="hero2-bg" data-hero-slides>
            {% for slide in heroBanners %}
                <img {{ loop.first ? 'class="is-active"' : '' }}
                     src="{{ slide.urlImage }}"
                     alt="{{ slide.name }}"
                     {{ loop.first ? 'fetchpriority="high"' : 'loading="lazy"' }}
                     decoding="async">
            {% endfor %}
        </div>

        <div class="container max-w-7xl grid lg:grid-cols-[1fr_350px] gap-12 items-center">
            <div>
                <p class="sec-label sec-label--light fade">Xây nhà trọn gói tại TP.HCM</p>
                <h1 class="hero2-title mt-6 fade">Xây tổ ấm bằng <em>cái tâm</em></h1>
                <p class="hero2-sub mt-6 fade">{{ v3.company.heroIntro }}</p>

                <ul class="hero2-points mt-7 fade">
                    {% for point in v3.heroPoints %}
                        <li>
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                            {{ point }}
                        </li>
                    {% endfor %}
                </ul>

                <div class="mt-9 flex flex-wrap items-center gap-8 fade">
                    <a href="#cong-trinh" class="btn2 btn2--ghost">Xem công trình thực tế</a>
                    <div class="hero2-dots" role="tablist" aria-label="Chọn ảnh công trình">
                        {% for slide in heroBanners %}
                            <button data-hero-dot="{{ loop.index0 }}"
                                    {{ loop.first ? 'aria-current="true"' : '' }}
                                    aria-label="Ảnh công trình {{ loop.index }}"></button>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# Form báo giá nhanh — gửi AJAX tới contact_ajax, xem assets/js/v3/modules/forms.js #}
            {{ form_start(form, {
                attr: { id: 'bao-gia-nhanh', class: 'quick-quote fade', 'data-quote': '', 'data-ajax-form': '' }
            }) }}
                <h2 class="qq-title">Nhận báo giá <em>miễn phí</em></h2>
                <p class="qq-note">Kiến trúc sư gọi lại trong 30 phút giờ làm việc.</p>

                <div class="mt-5 space-y-4">
                    <div>
                        <label for="{{ form.name.vars.id }}">Họ và tên</label>
                        {{ form_widget(form.name) }}
                    </div>
                    <div>
                        <label for="{{ form.phone.vars.id }}">Số điện thoại</label>
                        {{ form_widget(form.phone) }}
                    </div>
                    <div>
                        <label for="{{ form.title.vars.id }}">Nhu cầu</label>
                        {{ form_widget(form.title) }}
                    </div>
                    <button type="submit" class="btn2">Gửi — nhận báo giá ngay</button>
                </div>
            {{ form_end(form) }}
        </div>
    </section>

    {# ============ SỐ LIỆU ============ #}
    <div class="figures">
        <div class="container max-w-7xl grid grid-cols-2 lg:grid-cols-4 divide-x divide-white/10">
            {% for figure in v3.figures %}
                <div class="figure">
                    <p class="figure-value"><span data-count="{{ figure.value }}">0</span><sup>{{ figure.unit }}</sup></p>
                    <p class="figure-label">{{ figure.label }}</p>
                </div>
            {% endfor %}
        </div>
    </div>

    {# ============ 6 CAM KẾT ============ #}
    <section id="cam-ket" class="commits py-20 lg:py-24" aria-labelledby="cam-ket-h">
        <div class="container max-w-7xl">
            <div class="max-w-2xl mx-auto text-center">
                <p class="sec-label sec-label--center fade">Vì sao chọn {{ v3.company.shortNameOnly }}</p>
                <h2 id="cam-ket-h" class="h-display text-3xl lg:text-4xl mt-5 fade">6 cam kết <em>bằng văn bản</em></h2>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 mt-12">
                {% for commit in v3.commitments %}
                    <div class="commit fade">
                        <span class="commit-icon" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ commit.icon|raw }}</svg>
                        </span>
                        <div>
                            <h3 class="commit-name">{{ commit.name }}</h3>
                            <p class="commit-desc">{{ commit.desc }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ============ GIỚI THIỆU ============ #}
    <section id="gioi-thieu" class="about2 py-20 lg:py-28" aria-labelledby="gioi-thieu-h">
        <div class="container max-w-7xl grid lg:grid-cols-2 gap-14 lg:gap-20 items-center">
            <div class="about2-media fade">
                <img src="{{ asset(v3.about.image) }}" alt="{{ v3.about.imageAlt }}" loading="lazy" decoding="async">

                {# Con dấu cam kết #}
                <div class="seal" role="img" aria-label="Con dấu: {{ v3.company.slogan }} — {{ v3.company.shortName }}">
                    <svg class="seal-ring" viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <defs>
                            <path id="v3-seal-circle" d="M 64,64 m -46,0 a 46,46 0 1,1 92,0 a 46,46 0 1,1 -92,0"/>
                        </defs>
                        <circle cx="64" cy="64" r="60" fill="none" stroke="{{ v3.colors.gold }}" stroke-width="2"/>
                        <circle cx="64" cy="64" r="34" fill="none" stroke="{{ v3.colors.gold }}" stroke-width="1"/>
                        <text fill="{{ v3.colors.primary }}" font-size="9.5" font-weight="700" letter-spacing="1.4">
                            <textPath href="#v3-seal-circle">{{ v3.company.slogan|upper }} • {{ v3.company.shortNameOnly|upper }} •</textPath>
                        </text>
                    </svg>
                    <svg class="seal-core" width="34" height="30" viewBox="0 0 100 88" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path fill="currentColor" fill-rule="evenodd" d="M50 4 L96 84 L4 84 Z M50 46 L72 84 L28 84 Z"/>
                        <path fill="currentColor" d="M50 58 L64 84 L36 84 Z"/>
                    </svg>
                </div>
            </div>

            <div>
                <p class="sec-label fade">Về {{ v3.company.shortName }}</p>
                <h2 id="gioi-thieu-h" class="h-display text-3xl lg:text-4xl mt-5 fade">
                    Xây nhà là xây <em>tổ ấm</em> cho cả một đời người
                </h2>
                <p class="about2-lead fade">{{ v3.about.lead }}</p>

                <ul class="mt-7 fade">
                    {% for item in v3.about.checks %}
                        <li class="about2-check">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                            <p><strong>{{ item.title }}:</strong> {{ item.text }}</p>
                        </li>
                    {% endfor %}
                </ul>

                <div class="mt-9 flex flex-wrap items-center gap-5 fade">
                    <a href="{{ path('contact') }}" class="btn2 btn2--dark">Tìm hiểu về chúng tôi</a>
                    <a href="tel:{{ v3.company.phoneRaw }}" class="hd-hotline">
                        <span class="hd-hotline-icon">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </span>
                        <span>
                            <span class="hd-hotline-label">Gọi ngay</span>
                            <span class="hd-hotline-number">{{ v3.company.phone }}</span>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    {# ============ DỊCH VỤ ============ #}
    <section id="dich-vu" class="svc py-20 lg:py-24" aria-labelledby="dich-vu-h">
        <div class="container max-w-7xl">
            <div class="max-w-2xl mx-auto text-center">
                <p class="sec-label sec-label--center fade">Dịch vụ</p>
                <h2 id="dich-vu-h" class="h-display text-3xl lg:text-4xl mt-5 fade">Trọn gói từ móng đến <em>nội thất</em></h2>
            </div>

            <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-5 mt-12">
                {% for service in v3.services %}
                    <article class="svc-card fade">
                        <figure>
                            <img src="{{ asset(service.image) }}" alt="{{ service.name }}" loading="lazy" decoding="async">
                        </figure>
                        <div class="svc-body">
                            <h3 class="svc-name">{{ service.name }}</h3>
                            <p class="svc-desc">{{ service.desc }}</p>
                            <a href="{{ path('contact') }}" class="svc-link">Xem báo giá <span aria-hidden="true">→</span></a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ============ CÔNG TRÌNH THỰC TẾ ============ #}
    <section id="cong-trinh" class="works py-20 lg:py-24" aria-labelledby="cong-trinh-h">
        <div class="container max-w-7xl">
            <div class="flex flex-wrap items-end justify-between gap-6">
                <div>
                    <p class="sec-label fade">Công trình thực tế</p>
                    <h2 id="cong-trinh-h" class="h-display text-3xl lg:text-4xl mt-5 fade">
                        {{ v3.company.projectsCount }} mái ấm đã <em>bàn giao</em>
                    </h2>
                </div>
                <a href="{{ path('news_category', { level1: v3.newsCategorySlug }) }}" class="btn2 btn2--dark !py-3 !px-5 fade">Xem tất cả công trình</a>
            </div>

            <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-5 mt-12">
                {% for work in v3.works %}
                    <a href="{{ work.path|default('#') }}" class="work-card fade">
                        <img src="{{ asset(work.image) }}" alt="{{ work.name }}" loading="lazy" decoding="async">
                        <span class="work-arrow" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M7 7h10v10"/></svg>
                        </span>
                        <div class="work-meta">
                            <h3 class="work-name">{{ work.name }}</h3>
                            <p class="work-spec">{{ work.spec }}</p>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ============ KHÁCH HÀNG ĐÁNH GIÁ ============ #}
    <section class="quotes py-20 lg:py-28" aria-label="Khách hàng đánh giá">
        <div class="container max-w-5xl">
            <p class="sec-label sec-label--center fade">Khách hàng nói về chúng tôi</p>

            <div class="quotes-viewport mt-10 fade" data-quotes
                 aria-roledescription="carousel" aria-label="Đánh giá của khách hàng">
                <div class="quotes-track">
                    {% for quote in v3.testimonials %}
                        <figure class="quote-slide">
                            <p class="quote-mark" aria-hidden="true">“</p>
                            <blockquote>{{ quote.text }}</blockquote>
                            <p class="quote-stars" role="img" aria-label="Đánh giá 5 trên 5 sao">★★★★★</p>
                            <figcaption class="quote-author">
                                <img src="{{ asset(quote.avatar) }}" alt="Chân dung {{ quote.name }}" loading="lazy" decoding="async">
                                <span>
                                    <span class="quote-name">{{ quote.name }}</span>
                                    <span class="quote-role">{{ quote.role }}</span>
                                </span>
                            </figcaption>
                        </figure>
                    {% endfor %}
                </div>
            </div>

            <div class="quotes-controls fade">
                <button class="quotes-nav" data-quotes-prev aria-label="Đánh giá trước">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                </button>
                <div class="quotes-dots" role="tablist" aria-label="Chọn đánh giá">
                    {% for quote in v3.testimonials %}
                        <button class="quotes-dot" data-quotes-dot="{{ loop.index0 }}"
                                {{ loop.first ? 'aria-current="true"' : '' }}
                                aria-label="Đánh giá {{ loop.index }}"></button>
                    {% endfor %}
                </div>
                <button class="quotes-nav" data-quotes-next aria-label="Đánh giá tiếp theo">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
            </div>
        </div>
    </section>

    {# ============ QUY TRÌNH 8 BƯỚC ============ #}
    <section id="quy-trinh" class="steps2 py-20 lg:py-24" aria-labelledby="quy-trinh-h">
        <div class="container max-w-7xl">
            <div class="max-w-2xl mx-auto text-center">
                <p class="sec-label sec-label--center fade">Quy trình làm việc</p>
                <h2 id="quy-trinh-h" class="h-display text-3xl lg:text-4xl mt-5 fade">8 bước — rõ ràng <em>từ đầu</em></h2>
            </div>

            <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-12">
                {% for step in v3.steps %}
                    <li class="step2 fade">
                        <p class="step2-no" aria-hidden="true">{{ '%02d'|format(loop.index) }}</p>
                        <h3 class="step2-name">{{ step.name }}</h3>
                        <p class="step2-desc">{{ step.desc }}</p>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </section>

    {# ============ CẨM NANG (từ DB) ============
       HomepageController truyền `blocksOnHomepage` (mỗi block có .posts).
       Lấy bài của block đầu tiên có bài để hiển thị 4 bài mới nhất. #}
    {% set latestNews = [] %}
    {% for block in blocksOnHomepage|default([]) %}
        {% if latestNews is empty and block.posts|default([])|length %}
            {% set latestNews = block.posts|slice(0, 4) %}
        {% endif %}
    {% endfor %}

    {% if latestNews|length %}
        <section id="cam-nang" class="news2 py-20 lg:py-24" aria-labelledby="cam-nang-h">
            <div class="container max-w-7xl">
                <div class="flex flex-wrap items-end justify-between gap-6">
                    <div>
                        <p class="sec-label fade">Cẩm nang xây nhà</p>
                        <h2 id="cam-nang-h" class="h-display text-3xl lg:text-4xl mt-5 fade">Đọc trước khi <em>xây</em></h2>
                    </div>
                    <a href="{{ path('news_category', { level1: v3.newsCategorySlug }) }}" class="btn2 btn2--dark !py-3 !px-5 fade">Xem tất cả bài viết</a>
                </div>

                <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-5 mt-12">
                    {% for post in latestNews %}
                        {% set imageSrc = vich_uploader_asset(post, 'imageFile')
                            ? vich_uploader_asset(post, 'imageFile')|imagine_filter('news_277_220')
                            : asset('assets/images/no-image.png') %}
                        <article class="news2-card fade">
                            <a href="{{ path('dynamic_post_page', { slug: post.url }) }}" tabindex="-1" aria-hidden="true">
                                <figure><img src="{{ imageSrc }}" alt="{{ post.title }}" loading="lazy" decoding="async"></figure>
                            </a>
                            <div class="news2-body">
                                <time datetime="{{ post.createdAt|date('Y-m-d') }}">{{ post.createdAt|date('d/m/Y') }}</time>
                                <h3 class="news2-title">
                                    <a href="{{ path('dynamic_post_page', { slug: post.url }) }}">{{ post.title }}</a>
                                </h3>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# ============ CTA CUỐI ============ #}
    <section class="cta2 py-20 lg:py-24" aria-labelledby="cta-h">
        <div class="cta2-bg">
            <img src="{{ asset(v3.ctaImage) }}" alt="" loading="lazy" decoding="async" aria-hidden="true">
        </div>
        <div class="container max-w-7xl flex flex-wrap items-center justify-between gap-10">
            <div class="max-w-2xl">
                <h2 id="cta-h" class="cta2-title fade">
                    Bạn đang chuẩn bị <em>xây nhà</em>?<br>Đừng ký hợp đồng khi chưa gọi {{ v3.company.shortNameOnly }}.
                </h2>
                <p class="cta2-note fade">Khảo sát và dự toán sơ bộ hoàn toàn miễn phí — so sánh rồi hãy quyết định.</p>
            </div>
            <div class="flex flex-wrap items-center gap-5 fade">
                <a href="tel:{{ v3.company.phoneRaw }}" class="btn2 !text-base !px-8 !py-4">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    {{ v3.company.phone }}
                </a>
                <a href="#bao-gia-nhanh" class="btn2 btn2--ghost">Nhận báo giá miễn phí</a>
            </div>
        </div>
    </section>

    {# ============ HÌNH ẢNH HOẠT ĐỘNG ============ #}
    <section id="hoat-dong" class="gallery py-20 lg:py-24" aria-labelledby="hoat-dong-h">
        <div class="container max-w-7xl">
            <div class="flex flex-wrap items-end justify-between gap-6">
                <div>
                    <p class="sec-label fade">Hình ảnh hoạt động</p>
                    <h2 id="hoat-dong-h" class="h-display text-3xl lg:text-4xl mt-5 fade">
                        {{ v3.company.shortNameOnly }} trên <em>từng công trường</em>
                    </h2>
                </div>
                <div class="flex gap-3 fade">
                    <button class="gallery-nav" data-gallery-prev aria-label="Ảnh trước">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                    </button>
                    <button class="gallery-nav" data-gallery-next aria-label="Ảnh tiếp theo">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>

            <div class="gallery-track mt-10 fade" data-gallery-track>
                {% for album in galleryAlbums %}
                    {% set cover = album.coverImage %}
                    {% if cover %}
                        <button type="button" class="gallery-item"
                                data-album-images="{{ album.images|map(i => {src: i.imageUrl, caption: i.caption ?: album.name, alt: i.alt ?: album.name})|json_encode|e('html_attr') }}">
                            <figure>
                                <img src="{{ cover.imageUrl }}" alt="{{ cover.alt ?: album.name }}" loading="lazy" decoding="async">
                                <figcaption>{{ album.name }}</figcaption>
                            </figure>
                        </button>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </section>

    {# Popup phóng to ảnh #}
    <div class="lightbox" role="dialog" aria-modal="true" aria-label="Xem ảnh phóng to" aria-hidden="true">
        <button class="lightbox-close" aria-label="Đóng">✕</button>
        <button class="lightbox-prev" aria-label="Ảnh trước">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="lightbox-body">
            <img alt="">
            <p class="lightbox-caption"></p>
        </div>
        <button class="lightbox-next" aria-label="Ảnh tiếp theo">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
    </div>

{% endblock %}
