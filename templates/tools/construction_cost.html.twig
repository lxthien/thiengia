{% extends 'layout.html.twig' %}
{% block bodyClass %}construction-cost-page{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('build/css/v3-cost.css') }}">
{% endblock %}
{% block javascripts %}<script src="{{ asset('build/js/v3-cost.js') }}" defer></script>{% endblock %}
{% block title %}{{ post ? (post.getPageTitle() is not null ? post.getPageTitle() : post.getTitle())|title_tokens : 'Dự toán chi phí xây dựng | ' ~ v3.company.shortName }}{% endblock %}
{% block description %}{{ post ? (post.getPageDescription() is not null ? post.getPageDescription() : post.getDescription()) : v3.company.description }}{% endblock %}
{% block keyword %}{{ post ? post.getPageKeyword() : '' }}{% endblock %}

{% block jsonld %}
<script type="application/ld+json">{{ {
    '@context':'https://schema.org','@type':'WebApplication','name':'Tính chi phí xây nhà','description':block('description')|trim,
    'applicationCategory':'UtilitiesApplication','operatingSystem':'Any',
    'url':url('cost_calculator'),'offers':{'@type':'Offer','price':'0','priceCurrency':'VND'}
}|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
{# Schema tự khai báo ở bài "chi-phi-xay-dung" (FAQ...) — cùng cách news/page.html.twig xuất #}
{% set schemaMarkup = post ? post.schemaMarkup|safe_json_ld : null %}
{% if schemaMarkup %}
<script type="application/ld+json">{{ schemaMarkup }}</script>
{% endif %}
{% endblock %}

{% block body %}
{{ include('v3/components/_page_hero.html.twig', {
    breadcrumb: [{label: 'Trang chủ', path: path('homepage')}, {label: post.getTitle() is not null ? post.getTitle()|title_tokens : 'Chi phí xây dựng'}],
    title: post.getTitle() is not null ? post.getTitle()|title_tokens : 'Dự toán <em>chi phí xây dựng</em>',
    description: post.getDescription() is not null ? post.getDescription() : 'Nhập quy mô và phương án thi công để ước tính ngân sách, xem diện tích quy đổi và chi phí từng hạng mục.'
}) }}
<section class="construction-cost" aria-labelledby="cost-heading">
<div class="container cost-container">
    <div class="cost-note" role="note"><strong>Dự toán tham khảo, không thay thế báo giá.</strong>
        <p>Chi phí thực tế phụ thuộc thiết kế, vật tư, địa chất và điều kiện thi công. Đơn giá và hệ số sử dụng cấu hình hiện tại của {{ v3.company.shortName }}.</p>
        <p>Nhập kích thước, số tầng và phương án thi công để <strong>tính chi phí xây nhà</strong> theo đơn giá hiện hành của {{ v3.company.shortName }}. Kết quả hiện ngay trên màn hình, gồm diện tích quy đổi và chi phí từng hạng mục, không cần để lại số điện thoại.</p>
        <p><em>Dự toán tham khảo, không thay thế báo giá. Đơn giá áp dụng từ 01/01/2026.</em></p>
    </div>
    {% for message in app.flashes('error') %}
        <p class="cost-error" role="alert">{{ message }}</p>
    {% endfor %}
    <div class="cost-workspace">
        {{ form_start(form, {attr: {class: 'cost-form', 'data-cost-form': '', 'data-reset-url': path('cost_calculator')}}) }}
        <h2 id="cost-heading">Thông tin công trình</h2>
        <p class="cost-intro">Chọn phương án gần nhất với công trình dự kiến của bạn.</p>
        {{ form_errors(form) }}
        {% set groups = [
            {title: 'Thông tin cơ bản', fields: ['type', 'method', 'muc_dau_tu', 'wide', 'long', 'floor']},
            {title: 'Kết cấu', fields: ['mong', 'mai']},
            {title: 'Công năng phụ trợ', fields: ['lung', 'tum', 'san_thuong', 'ban_cong', 'tang_ham', 'san_vuon']},
            {title: 'Điều kiện thi công', fields: ['mat_tien', 'hem']}
        ] %}
        {% for group in groups %}
        <fieldset class="cost-group">
            <legend><span aria-hidden="true">{{ loop.index }}</span> {{ group.title }}</legend>
            <div class="cost-fields">
                {% for name in group.fields %}
                    {% set field = attribute(form, name) %}
                    <div class="cost-field">
                        {{ form_label(field) }}
                        {% if name in ['wide', 'long'] %}
                            {{ form_widget(field, {attr: {inputmode: 'decimal', maxlength: '20', 'aria-describedby': field.vars.id ~ '_help', 'data-cost-dimension': ''}}) }}
                            <small id="{{ field.vars.id }}_help">Số lớn hơn 0; dùng dấu chấm thập phân, ví dụ 4.5.</small>
                        {% elseif name == 'floor' %}
                            {{ form_widget(field, {attr: {'aria-describedby': field.vars.id ~ '_help'}}) }}
                            <small id="{{ field.vars.id }}_help">Tính cả tầng trệt; tầng lửng và tum nhập riêng bên dưới.</small>
                        {% elseif name in ['lung', 'tum', 'san_vuon'] %}
                            {{ form_widget(field, {attr: {inputmode: 'decimal', maxlength: '20', 'aria-describedby': field.vars.id ~ '_help', 'data-cost-optional-area': ''}}) }}
                            <small id="{{ field.vars.id }}_help">{{ {
                                lung: 'Tối đa 65% diện tích một sàn; nhập lớn hơn sẽ được tính bằng mức tối đa.',
                                tum: 'Diện tích phần tum / tầng thượng có mái che, thường gồm cầu thang và phòng thờ.',
                                san_vuon: 'Diện tích sân trước, sân sau có lát nền, tường rào.'
                            }[name] }}</small>
                        {% else %}
                            {{ form_widget(field) }}
                        {% endif %}
                        {{ form_errors(field) }}
                    </div>
                {% endfor %}
            </div>
        </fieldset>
        {% endfor %}
        <p class="cost-note cost-type-note" data-cost-type-note{{ form.type.vars.value != '3' ? ' hidden' : '' }}>Với nhà cấp 4, công thức hiện tại chỉ tính diện tích rộng × dài; số tầng, kết cấu và công năng phụ trợ không cộng thêm vào diện tích quy đổi.</p>
        <div class="cost-actions">
            {{ form_widget(form.caculator, {attr: {class: 'cost-submit'}}) }}
            {{ form_widget(form.reset) }}
        </div>
        {{ form_end(form) }}

        <aside class="cost-results" aria-labelledby="cost-result-heading">
            <div id="cost-result" tabindex="-1" data-cost-result="{{ costs is not null ? 'ready' : 'empty' }}">
                <h2 id="cost-result-heading">Kết quả dự toán</h2>
                {% if costs is not null %}
                    <p class="cost-stale" data-cost-stale hidden role="status">Bạn đã thay đổi thông tin. Nhấn “Dự toán chi phí” để cập nhật kết quả.</p>
                    <p class="cost-intro">{{ costs.title }}</p>
                    <p class="cost-total-label">Tổng chi phí dự kiến</p>
                    <p class="cost-total">{{ costs.costTotal|number_format(0, ',', '.') }} <span>VNĐ</span></p>
                    <dl class="cost-summary">
                        <div><dt>Diện tích một sàn</dt><dd>{{ costs.area|number_format(2, ',', '.') }} m²</dd></div>
                        <div><dt>Tổng diện tích quy đổi</dt><dd>{{ costs.areaTotal|number_format(2, ',', '.') }} m²</dd></div>
                        <div><dt>Đơn giá áp dụng</dt><dd>{{ costs.cost|number_format(0, ',', '.') }} VNĐ/m²</dd></div>
                    </dl>
                    {% set rows = [] %}
                    {% if costs.areaMong > 0 %}{% set rows = rows|merge([{label: costs.titleMong, area: costs.areaMong}]) %}{% endif %}
                    {% if costs.areaTangHam > 0 %}{% set rows = rows|merge([{label: 'Tầng hầm', area: costs.areaTangHam}]) %}{% endif %}
                    {% set floors = form.type.vars.value == '3' ? 1 : costs.floor %}
                    {% for i in 1..floors %}
                        {% set rows = rows|merge([{label: i == 1 ? 'Tầng trệt' : 'Tầng ' ~ (i - 1), area: costs.area}]) %}
                        {% if i == 1 and costs.areaLung > 0 %}
                            {% set rows = rows|merge([{label: 'Tầng lửng (tối đa 65% diện tích sàn)', area: costs.areaLung}]) %}
                        {% endif %}
                    {% endfor %}
                    {% for item in [
                        {label: 'Ban công', area: costs.areaBanCong},
                        {label: 'Tum / Tầng thượng', area: costs.areaTum}, {label: 'Sân thượng', area: costs.areaSanThuong},
                        {label: 'Sân vườn', area: costs.areaSanVuon}, {label: costs.titleMai, area: costs.areaMai}
                    ] %}
                        {% if item.area > 0 %}{% set rows = rows|merge([item]) %}{% endif %}
                    {% endfor %}
                    <div class="cost-table-wrap" role="region" aria-label="Chi tiết chi phí" tabindex="0">
                        <table>
                            <caption>Chi tiết theo diện tích quy đổi</caption>
                            <thead><tr><th scope="col">Hạng mục</th><th scope="col">Quy đổi (m²)</th><th scope="col">Thành tiền (VNĐ)</th></tr></thead>
                            <tbody>
                            {% for row in rows %}
                                <tr><th scope="row">{{ row.label }}</th><td>{{ row.area|number_format(2, ',', '.') }}</td><td>{{ (row.area * costs.cost)|number_format(0, ',', '.') }}</td></tr>
                            {% endfor %}
                            {% set surcharge = costs.costTotal - costs.areaTotal * costs.cost %}
                            {% if surcharge > 0 %}
                                <tr><th scope="row">Phụ phí thi công / mặt tiền</th><td>—</td><td>{{ surcharge|number_format(0, ',', '.') }}</td></tr>
                            {% endif %}
                            </tbody>
                            <tfoot><tr><th scope="row">Tổng cộng</th><td>{{ costs.areaTotal|number_format(2, ',', '.') }}</td><td>{{ costs.costTotal|number_format(0, ',', '.') }}</td></tr></tfoot>
                        </table>
                    </div>
                    <p class="cost-note">{{ costs.note }}</p>
                    {% if leadForm %}<button type="button" class="cost-submit cost-lead-open" data-cost-lead-open>Nhận đơn giá chi tiết từng hạng mục</button>{% endif %}
                {% else %}
                    <div class="cost-empty">
                        <p class="cost-empty-title">Ngân sách dự kiến của bạn</p>
                        <p>Điền kích thước và chọn phương án ở bên cạnh, sau đó nhấn <strong>Dự toán chi phí</strong>.</p>
                        <ol><li>Xem tổng ngân sách tham khảo.</li><li>Đối chiếu diện tích quy đổi và từng hạng mục.</li><li>Thay đổi lựa chọn để tính lại phương án khác.</li></ol>
                    </div>
                {% endif %}
                <details class="cost-guide">
                    <summary>Diện tích quy đổi được tính thế nào?</summary>
                    <p>Công cụ cộng diện tích các tầng với diện tích móng, mái và công năng phụ trợ theo hệ số đã cấu hình. Đây không phải diện tích đất hay diện tích cấp phép.</p>
                    <p>Chi phí dự kiến = diện tích quy đổi × đơn giá điều chỉnh, sau đó cộng phụ phí điều kiện thi công và mặt tiền (nếu có).</p>
                </details>
            </div>
        </aside>
    </div>
    {% if contentsLazy %}
        <article{% if post %} id="post-{{ post.getId() }}"{% endif %} class="post-content cost-content">{{ contentsLazy|raw }}</article>
    {% endif %}
</div>
{% if leadForm %}
    {# Hiện sau 5 giây kể từ khi có kết quả — xem public/assets/js/v3/construction-cost.js #}
    <dialog class="cost-lead" data-cost-lead aria-labelledby="cost-lead-title" aria-describedby="cost-lead-intro">
        <button type="button" class="cost-lead-close" data-cost-lead-close aria-label="Đóng">×</button>
        <h2 id="cost-lead-title">Nhận đơn giá chi tiết</h2>
        <p id="cost-lead-intro" class="cost-lead-intro">Chi phí trên chỉ là tính toán sơ bộ. Để nhận đơn giá chi tiết từng hạng mục, vật tư, hãy để lại thông tin bên dưới.</p>
        <dl class="cost-lead-summary">
            <div><dt>Nhu cầu</dt><dd>{{ costs.leadTitle }}</dd></div>
            <div><dt>Mô tả</dt><dd><ul>{% for line in costs.leadLines %}<li>{{ line }}</li>{% endfor %}</ul></dd></div>
        </dl>
        {{ form_start(leadForm, {attr: {class: 'cost-lead-form', 'data-quote': '', 'data-ajax-form': '', 'data-cost-lead-form': ''}}) }}
            <div class="cost-field">
                {{ form_label(leadForm.name) }}
                {{ form_widget(leadForm.name, {attr: {required: 'required'}}) }}
            </div>
            <div class="cost-field">
                {{ form_label(leadForm.phone) }}
                {{ form_widget(leadForm.phone, {attr: {required: 'required', 'aria-describedby': leadForm.phone.vars.id ~ '_help'}}) }}
                <small id="{{ leadForm.phone.vars.id }}_help">Số di động 10 số, ví dụ 0901 234 567.</small>
            </div>
            <button type="submit" class="cost-submit">Gửi đi</button>
        {{ form_end(leadForm) }}
        <p class="cost-lead-thanks" data-cost-lead-thanks role="status" hidden>Cảm ơn bạn! Chúng tôi đã nhận thông tin và sẽ gửi đơn giá chi tiết sớm nhất.</p>
    </dialog>
{% endif %}
</section>
{% endblock %}
