<div class="hd-menu" id="v3-menu" role="dialog" aria-modal="true" aria-label="Menu chính" aria-hidden="true" inert>
    <button type="button" class="hd-menu-close" aria-label="Đóng menu">✕</button>

    <nav aria-label="Menu chính thu gọn">
        <ul>
            {% for item in menu_items('Main Menu') %}
                <li>
                    <a href="{{ item.url }}" class="hd-menu-link {{ item.class }}"
                       {% if item.target == '_blank' %}target="_blank" rel="noopener"{% endif %}
                       {% if item.title_attr %}title="{{ item.title_attr }}"{% endif %}
                       {% if item.active %}aria-current="page"{% endif %}>{{ item.title }}</a>
                    {% if item.children %}
                        <ul class="hd-menu-sub">
                            {% for child in item.children %}
                                <li><a href="{{ child.url }}"{% if child.class %} class="{{ child.class }}"{% endif %}
                                       {% if child.target == '_blank' %}target="_blank" rel="noopener"{% endif %}
                                       {% if child.title_attr %}title="{{ child.title_attr }}"{% endif %}
                                       {% if child.active %}aria-current="page"{% endif %}>{{ child.title }}</a></li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </nav>

    <p class="mt-8 text-white/60 text-sm">
        Hotline 24/7 —
        <a href="tel:{{ v3.company.phoneRaw }}" style="color: {{ v3.colors.accent }}" class="font-bold">{{ v3.company.phone }}</a>
    </p>
</div>
