{% set route = app.request.attributes.get('_route') %}

<header class="hd">
    <div class="container max-w-7xl flex items-center justify-between">
        {{ include('v3/components/_logo.html.twig') }}

        <nav class="hidden xl:block" aria-label="Menu chính">
            <ul class="flex items-center gap-8">
                {# Giới thiệu — dropdown #}
                <li class="hd-drop">
                    <a href="{{ path('homepage') }}#gioi-thieu" class="hd-link" aria-haspopup="true">
                        Giới thiệu
                        <svg class="hd-caret" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </a>
                    <ul class="hd-drop-menu">
                        {% for item in v3.menu.about %}
                            <li><a href="{{ path('homepage') }}{{ item.anchor }}">{{ item.label }}</a></li>
                        {% endfor %}
                    </ul>
                </li>

                {# Dịch vụ — dropdown #}
                <li class="hd-drop">
                    <a href="{{ path('homepage') }}#dich-vu" class="hd-link" aria-haspopup="true">
                        Dịch vụ
                        <svg class="hd-caret" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </a>
                    <ul class="hd-drop-menu">
                        {% for item in v3.menu.services %}
                            <li><a href="{{ path('homepage') }}#dich-vu">{{ item }}</a></li>
                        {% endfor %}
                    </ul>
                </li>

                <li><a href="{{ path('homepage') }}#cong-trinh" class="hd-link">Công trình</a></li>
                <li><a href="{{ path('homepage') }}#quy-trinh" class="hd-link">Quy trình</a></li>
                <li>
                    <a href="{{ path('news_category', { level1: v3.newsCategorySlug }) }}"
                       class="hd-link {{ route in ['news_category','news_show','dynamic_post_page','list_category'] ? 'is-active' : '' }}"
                       {{ route == 'news_category' ? 'aria-current="page"' : '' }}>Cẩm nang</a>
                </li>
                <li>
                    <a href="{{ path('contact') }}"
                       class="hd-link {{ route == 'contact' ? 'is-active' : '' }}"
                       {{ route == 'contact' ? 'aria-current="page"' : '' }}>Liên hệ</a>
                </li>
            </ul>
        </nav>

        <div class="flex items-center gap-6">
            <a href="tel:{{ v3.company.phoneRaw }}" class="hd-hotline hidden md:flex">
                <span class="hd-hotline-icon">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </span>
                <span>
                    <span class="hd-hotline-label">Hotline 24/7</span>
                    <span class="hd-hotline-number">{{ v3.company.phone }}</span>
                </span>
            </a>

            <a href="{{ path('contact') }}" class="btn2 hidden md:inline-flex !py-3 !px-6">Nhận báo giá</a>

            <button class="hd-toggle hidden max-xl:flex flex-col justify-center gap-2"
                    aria-label="Mở menu" aria-expanded="false" aria-controls="v3-menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>
