{#
    Thẻ bài viết (KHÔNG có hàng meta — bỏ theo thiết kế v3).
    Tham số:
      post (News)
      featured (bool, mặc định false) — bố cục lớn kiểu tạp chí
      headingLevel (string, mặc định 'h2')
#}
{% set featured = featured|default(false) %}
{% set headingLevel = headingLevel|default('h2') %}

<article class="post-card {{ featured ? 'post-card--featured' : '' }} fade">
    <a href="{{ path('dynamic_post_page', { slug: post.url }) }}" class="post-card-media" tabindex="-1" aria-hidden="true">
        {# WebP + srcset (App\Twig\V3ImageExtension); khung cắt ảnh do CSS .post-card-media (aspect-ratio + object-fit) lo. #}
        {{ v3_image(post.images ?: 'assets/images/no-image.png', featured ? 'half' : 'card', {alt: media_alt(post.images) ?: (post.title|title_tokens)}) }}
    </a>

    <div class="post-card-body">
        {% if post.primaryCategory %}
            <p class="post-card-category">{{ post.primaryCategory.name }}</p>
        {% endif %}

        <{{ headingLevel }} class="post-card-title">
            <a href="{{ path('dynamic_post_page', { slug: post.url }) }}">{% if searchHighlight|default(false) %}{{ post.highlightedTitle|raw }}{% else %}{{ (post.title|title_tokens) }}{% endif %}</a>
        </{{ headingLevel }}>

        {% if post.description %}
            <p class="post-card-excerpt">{% if searchHighlight|default(false) %}{{ post.highlightedDescription|raw }}{% else %}{{ post.description }}{% endif %}</p>
        {% endif %}
    </div>
</article>
