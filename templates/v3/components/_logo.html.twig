{% set onDark = onDark|default(false) %}

<a href="{{ path('homepage') }}" class="hd-logo {{ onDark ? '!text-white' : '' }}"
   aria-label="{{ v3.company.shortName }} — Trang chủ">
    <img src="{{ asset('assets/images/thiengia.svg') }}"
         alt="{{ v3.company.shortName }}"
         width="220" height="46" decoding="async"
         style="display: block; width: clamp(160px, 18vw, 220px); height: auto; flex-shrink: 0;{{ onDark ? ' filter: brightness(0) invert(1);' : '' }}">
</a>
