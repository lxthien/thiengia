<section class="newsletter py-14" aria-labelledby="v3-newsletter-heading">
    <div class="container max-w-7xl flex flex-wrap items-center justify-between gap-8">
        <div class="max-w-xl">
            <h2 id="v3-newsletter-heading" class="newsletter-title">Nhận <em>cẩm nang</em> mỗi tuần</h2>
            <p class="newsletter-note">Kinh nghiệm xây nhà thực chiến, gửi thẳng vào hộp thư — không quảng cáo.</p>
        </div>

        {# Bước "form" chưa làm — action để trống, sẽ trỏ về route đăng ký sau #}
        <form class="newsletter-form" method="post" action="#" data-quote>
            <label for="v3-nl-email" class="sr-only">Địa chỉ email</label>
            <input id="v3-nl-email" name="email" type="email" placeholder="Email của bạn" autocomplete="email" required>
            <button type="submit" class="btn2">Đăng ký</button>
        </form>
    </div>
</section>
