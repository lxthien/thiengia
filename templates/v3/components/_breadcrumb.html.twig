{#
    Breadcrumb.
    Tham số: items = [{ label, path (tuỳ chọn) }] — phần tử cuối là trang hiện tại.
#}
<nav class="breadcrumb-v3" aria-label="Breadcrumb">
    <ol>
        {% for item in items %}
            <li>
                {% if item.path is defined and not loop.last %}
                    <a href="{{ item.path }}">{{ item.label }}</a>
                {% else %}
                    <span aria-current="page">{{ item.label }}</span>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
</nav>

{% set breadcrumbListItems = [] %}
{% for item in items %}
    {% set listItem = {'@type': 'ListItem', 'position': loop.index, 'name': item.label} %}
    {% if item.path is defined %}
        {% set listItem = listItem|merge({'item': absolute_url(item.path)}) %}
    {% endif %}
    {% set breadcrumbListItems = breadcrumbListItems|merge([listItem]) %}
{% endfor %}
<script type="application/ld+json">{{ {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': breadcrumbListItems
}|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
