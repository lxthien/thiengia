{#
    Breadcrumb.
    Tham số: items = [{ label, path (tuỳ chọn) }] — phần tử cuối là trang hiện tại.
#}
<nav class="breadcrumb-v3" aria-label="Đường dẫn điều hướng">
    <ol>
        {% for item in items %}
            <li class="{{ loop.last ? 'breadcrumb-v3-current' : '' }}">
                {% if item.path is defined and not loop.last %}
                    <a href="{{ item.path }}">
                        {% if loop.first %}<svg class="breadcrumb-v3-home" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ section_icon('home') }}</svg>{% endif %}
                        <span>{{ item.label }}</span>
                    </a>
                {% else %}
                    <span aria-current="page">{{ item.label }}</span>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
</nav>

{% set breadcrumbListItems = [] %}
{% for item in items %}
    {% set listItem = {'@type': 'ListItem', 'position': loop.index, 'name': item.label} %}
    {% if item.path is defined %}
        {% set listItem = listItem|merge({'item': absolute_url(item.path)}) %}
    {% endif %}
    {% set breadcrumbListItems = breadcrumbListItems|merge([listItem]) %}
{% endfor %}
<script type="application/ld+json">{{ {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': breadcrumbListItems
}|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
