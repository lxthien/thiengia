{# Shared data: admin homepage Figures config, falling back to v3.yaml. #}
<div class="figures">
    <div class="container max-w-7xl grid grid-cols-2 lg:grid-cols-4 divide-x divide-white/10">
        {% for figure in v3.figures %}
            <div class="figure">
                <p class="figure-value"><span data-count="{{ figure.value }}">{{ figure.value }}</span><sup>{{ figure.unit }}</sup></p>
                <p class="figure-label">{{ figure.label }}</p>
            </div>
        {% endfor %}
    </div>
</div>
