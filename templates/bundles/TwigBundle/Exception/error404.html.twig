{% extends 'bundles/TwigBundle/Exception/_layout.html.twig' %}
{% set errorCode = 404 %}
{% set errorTitle = 'Không tìm thấy trang' %}
{% set errorMessage = 'Trang bạn đang tìm có thể đã được đổi địa chỉ hoặc không còn tồn tại. Bạn có thể tìm nội dung khác hoặc trở về trang chủ.' %}
{% block error_extra %}
<form class="error-page__search" action="{{ path('news_search') }}" method="get" role="search">
    <label for="error-search">Tìm nội dung trên Thiện Gia</label>
    <div class="error-page__search-row">
        <input id="error-search" type="search" name="q" placeholder="Ví dụ: báo giá xây nhà" required maxlength="200">
        <button class="btn2" type="submit">Tìm kiếm</button>
    </div>
</form>
{% endblock %}
